"""
TITLE: cruise_062922-pdf
DESCRIPTION: A Cruise autonomous vehicle ("Cruise AV"), operating in supervised autonomous mode, was traveling eastbound on Clement Street between 10th Avenue and 9th Avenue. Following the intersection of 10th Avenue mid-block, while engaged in autonomous mode, a vehicle in an angled parking space on the right backed out into the same lane as the oncoming Cruise AV. The AV operator disengaged from autonomous into manual mode, and pulled to the left to avoid the vehicle backing up. At this time, contact by a cyclist was made at the rear driver side bumper of the Cruise AV. There were no reported injuries or damages at the scene by either party and police were not called. The following day on June 30, 2022, the cyclist claimed damages and injuries related to the event.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'
BICYCLE_MODEL = 'vehicle.bh.crossbike'

param CRUISE_AV_SPEED = VerifaiRange(7, 10)  # m/s, typical city speed ~15-22 mph
param CRUISE_AV_AVOID_SPEED = VerifaiRange(3, 5) # m/s, reduced speed during avoidance ~7-11 mph

param PARKING_VEHICLE_BACK_SPEED = VerifaiRange(1, 3) # m/s, backing speed ~2-6 mph
param PARKING_VEHICLE_DIST_AHEAD = VerifaiRange(15, 25) # m ahead of ego's initial position
param PARKING_VEHICLE_DIST_LATERAL = VerifaiRange(3, 4) # m right of ego's lane

param CYCLIST_SPEED = VerifaiRange(3, 6) # m/s, cyclist speed ~7-13 mph
param CYCLIST_DIST_BEHIND = VerifaiRange(5, 10) # m behind ego
param CYCLIST_DIST_LATERAL = VerifaiRange(1, 2) # m left of ego

param REACTION_DIST = VerifaiRange(10, 15) # Distance for Cruise AV to react to parking vehicle
CRASH_DIST_CYCLIST = 0.5 # Distance for car-cyclist contact
INIT_DIST_FROM_JUNCTION = 30 # Ensure scenario starts mid-block
TERM_DIST = 100 # Scenario termination distance

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoAvoidanceBehavior():
    take SetSpeedAction(globalParameters.CRUISE_AV_AVOID_SPEED)
    fasterLaneSec = self.laneSection.fasterLane
    if fasterLaneSec is not None:
        do LaneChangeBehavior(
                laneSectionToSwitch=fasterLaneSec,
                target_speed=globalParameters.CRUISE_AV_AVOID_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_SPEED) for 5 seconds
    else:
        take SetSteerAction(0.3)
        wait 3 seconds
        take SetSteerAction(0)
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_SPEED) for 5 seconds

behavior EgoPrimaryBehavior(parkingVehicle, cyclist):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_SPEED)
    interrupt when (distance to parkingVehicle) < globalParameters.REACTION_DIST:
        do EgoAvoidanceBehavior()
    interrupt when (distance from self.rearLeft to cyclist) < CRASH_DIST_CYCLIST:
        terminate

behavior ParkingVehicleBehavior():
    take SetSpeedAction(-globalParameters.PARKING_VEHICLE_BACK_SPEED)
    take SetSteerAction(0.1) for 1 second
    take SetSpeedAction(0)
    wait 5 seconds
    terminate

behavior CyclistBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.CYCLIST_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

initRoad = Uniform(*filter(lambda r: len(r.lanes) > 0 and r.length > 50, network.roads))
egoInitLane = Uniform(*filter(lambda l: len(l.maneuvers) > 0 and ManeuverType.STRAIGHT in [m.type for m in l.maneuvers], initRoad.lanes))

egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Place parking vehicle ahead and to the right of ego, angled
parkingVehicleSpawnPt = new OrientedPoint \
    right of ego by globalParameters.PARKING_VEHICLE_DIST_LATERAL \
    ahead of ego by globalParameters.PARKING_VEHICLE_DIST_AHEAD \
    with heading ego.heading + 90 deg # Parked perpendicular, facing away from ego's lane

# Place cyclist behind and to the left of ego
cyclistSpawnPt = new OrientedPoint \
    left of ego by globalParameters.CYCLIST_DIST_LATERAL \
    behind ego by globalParameters.CYCLIST_DIST_BEHIND \
    with heading ego.heading # Cyclist initially follows ego's direction

#################################
# SCENARIO SPECIFICATION        #
#################################

parkingVehicle = new Car at parkingVehicleSpawnPt,
    with blueprint MODEL,
    with behavior ParkingVehicleBehavior()

cyclist = new Bicycle at cyclistSpawnPt,
    with blueprint BICYCLE_MODEL,
    with behavior CyclistBehavior()

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoPrimaryBehavior(parkingVehicle, cyclist)

#################################
# REQUIREMENTS                  #
#################################

require (distance to egoInitLane.road.junctions[0]) > INIT_DIST_FROM_JUNCTION
require ego.laneSection._fasterLane is not None

terminate when (distance to egoSpawnPt) > TERM_DIST