"""
TITLE: waymo_08172023-pdf
DESCRIPTION: On August 17, 2023 at 1:05 PM PT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving an SUV on Bayshore Boulevard near Jerrold Avenue. The Waymo AV was traveling northbound on Bayshore Boulevard. As the SUV was passing the Waymo AV to the left, it initiated a right lane change. The front of the SUV made contact with the rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode. Both vehicles sustained damage, and the SUV left the scene without exchanging information.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_WAYMO = 'vehicle.toyota.prius'
MODEL_SUV = 'vehicle.toyota.rav4'

param WAYMO_SPEED = VerifaiRange(5, 7)
param SUV_SPEED = VerifaiRange(8, 10)

param SUV_LATERAL_OFFSET = VerifaiRange(3.5, 4.5)
param SUV_LONGITUDINAL_OFFSET = VerifaiRange(0, 8)

param LANE_CHANGE_TRIGGER_DIST = VerifaiRange(5, 12)
CRASH_DIST = 1.0
TERM_DIST = 70
MAX_TIME = 15

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.WAYMO_SPEED)

behavior SUVBehavior(waymoAV):
    do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED) \
        until (distance from self to waymoAV) < globalParameters.LANE_CHANGE_TRIGGER_DIST

    slowerLaneSec = self.laneSection.slowerLane
    do LaneChangeBehavior(laneSectionToSwitch=slowerLaneSec, target_speed=globalParameters.SUV_SPEED)

    do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

waymoAVLane = Uniform(*filter(lambda l:
    l.fasterLane is not None and l.fasterLane.slowerLane is not None and l.length > 50,
    network.lanes)
)
waymoAVSpawnPt = new OrientedPoint in waymoAVLane.centerline

SUVSpawnPt = new OrientedPoint at waymoAVSpawnPt.position \
    offset along direction by (-globalParameters.SUV_LATERAL_OFFSET, globalParameters.SUV_LONGITUDINAL_OFFSET)

#################################
# SCENARIO SPECIFICATION        #
#################################

waymoAV = new Car at waymoAVSpawnPt,
    with blueprint MODEL_WAYMO,
    with behavior WaymoAVBehavior()

SUV = new Car at SUVSpawnPt,
    with blueprint MODEL_SUV,
    with behavior SUVBehavior(waymoAV)

#################################
# REQUIREMENTS                  #
#################################

require SUV.lane is waymoAV.lane.fasterLane
require SUV.lane.slowerLane is not None
require waymoAV.lane.fasterLane is not None

require (abs(SUV.position.x - waymoAV.position.x)) > (waymoAV.width + SUV.width)/2
require (abs(SUV.position.y - waymoAV.position.y)) < 30

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance from SUV.front to waymoAV.rear) < CRASH_DIST
terminate when (distance to waymoAVSpawnPt) > TERM_DIST