"""
TITLE: zoo_042222-pdf
DESCRIPTION: A Zoox vehicle in autonomous mode was proceeding straight through the intersection of Mason St. and Ellis St. when it was rear-ended by a passenger vehicle that was switching lanes and made contact with the Zoox vehicle's sensors. The other party left the scene. The police were not called, and there were no injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param ZOOX_SPEED = VerifaiRange(2.5, 3.5)
param ZOOX_BRAKE = VerifaiRange(0.5, 1.0)

param PASSENGER_SPEED = VerifaiRange(7, 9)
param PASSENGER_INIT_DIST = VerifaiRange(10, 15) # Distance adversary is behind ego
param LANE_CHANGE_TRIGGER_DIST = VerifaiRange(8, 12) # Distance to ego to trigger adversary lane change

param SAFETY_DIST = VerifaiRange(3, 5)
CRASH_DIST = 5
EGO_INIT_DIST_TO_INTERSECTION = [10, 20]
TERM_DIST = 70

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.ZOOX_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.ZOOX_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior PassengerBehavior(target_speed, ego_vehicle):
    try:
        do FollowLaneBehavior(target_speed=target_speed)
    interrupt when (distance to ego_vehicle) < globalParameters.LANE_CHANGE_TRIGGER_DIST and self.lane is not ego_vehicle.lane:
        do LaneChangeBehavior(laneSectionToSwitch=ego_vehicle.laneSection, target_speed=target_speed)
        do FollowLaneBehavior(target_speed=target_speed)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary starts in an adjacent lane to ego's initial lane, behind ego
# Prioritize slowerLane, otherwise fasterLane
adjLane = egoInitLane.slowerLane if egoInitLane.slowerLane is not None else egoInitLane.fasterLane
advInitLane = adjLane

# Define adversary spawn point in the adjacent lane, behind egoSpawnPt
advSpawnPt = new OrientedPoint in advInitLane.centerline behind egoSpawnPt by globalParameters.PASSENGER_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior ZooxBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior(globalParameters.PASSENGER_SPEED, ego)

#################################
# REQUIREMENTS                  #
#################################

require EGO_INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= EGO_INIT_DIST_TO_INTERSECTION[1]
require advInitLane is not None
require advSpawnPt.lane is not egoSpawnPt.lane
require advSpawnPt.road == egoSpawnPt.road
require (distance from adversary to ego) > (ego.length + adversary.length) / 2
require adversary.laneSection._fasterLane is not None or adversary.laneSection._slowerLane is not None

terminate when (distance to adversary) < (ego.length + adversary.length) / 2
terminate when (distance to egoSpawnPt) > TERM_DIST