"""
TITLE: cruise_111622-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV”), operating in manual mode, was traveling northbound in the rightmost lane on Van Ness Avenue between Eddy Street and Ellis Street. The Cruise test driver began to maneuver around a double-parked vehicle by merging left into the center lane. Shortly thereafter, a 2013 Nissan Juke made contact with the Cruise AV's driver side rear passenger door and front driver side fender, damaging the driver side rear passenger door, front driver side fender, front driver side radar equipment and front driver side bumper. There were no reported injuries at the scene by either party.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_MODEL = 'vehicle.lincoln.mkz_2017'
NISSAN_JUKE_MODEL = 'vehicle.audi.a2'
DOUBLE_PARKED_MODEL = 'vehicle.mercedes.sprinter'

param EGO_SPEED = VerifaiRange(5, 8)
param JUKE_SPEED = VerifaiRange(10, 15)
DPV_SPEED = 0

param DPV_INITIAL_DIST_AHEAD = VerifaiRange(20, 30)
param DPV_TRIGGER_DIST = VerifaiRange(10, 15)
param JUKE_INITIAL_DIST_BEHIND = VerifaiRange(-20, -10)

CRASH_DIST = 2
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior(dpv_obj):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when withinDistanceTo(self, dpv_obj, globalParameters.DPV_TRIGGER_DIST):
        fasterLaneSec = self.laneSection.fasterLane
        do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.EGO_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)

behavior JukeBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.JUKE_SPEED)

behavior DPVBehavior():
    take SetSpeedAction(DPV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

egoInitialLane = Uniform(*filter(lambda l: 
    l.laneGroup.lanes[0] == l and 
    l.fasterLane is not None and 
    len(l.maneuvers) > 0, 
    network.lanes))

egoSpawnPt = new OrientedPoint in egoInitialLane.centerline

dpvSpawnPt = new OrientedPoint in egoInitialLane.centerline following roadDirection from egoSpawnPt for globalParameters.DPV_INITIAL_DIST_AHEAD

jukeSpawnPt = new OrientedPoint in egoInitialLane.fasterLane.centerline following roadDirection from egoSpawnPt for globalParameters.JUKE_INITIAL_DIST_BEHIND

#################################
# SCENARIO SPECIFICATION        #
#################################

double_parked_vehicle = new Car at dpvSpawnPt,
    with blueprint DOUBLE_PARKED_MODEL,
    with behavior DPVBehavior()

ego = new Car at egoSpawnPt,
    with blueprint CRUISE_MODEL,
    with behavior CruiseAVBehavior(double_parked_vehicle)

adversary = new Car at jukeSpawnPt,
    with blueprint NISSAN_JUKE_MODEL,
    with behavior JukeBehavior()

require double_parked_vehicle.lane is ego.lane
require double_parked_vehicle is ahead of ego
require adversary.lane is ego.lane.fasterLane
require adversary is behind ego

terminate when (distance from ego to adversary) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST