"""
TITLE: waymo_100121-pdf
DESCRIPTION: On October 1, 2021 at 3:51 PM PDT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was ina collision involving an SUV at John F. Kennedy Drive at Stanyan Street. The Waymo AV was traveling in autonomous mode westbound on Fell Street / John F. Kennedy Drive when it stopped for pedestrians who were in a crosswalk and between the westbound and eastbound lanes of John F. Kennedy Drive. An SUV following behind the Waymo AV struck the rear of the Waymo AV. The Waymo AV sustained minor damage to its rear bumper and trunk, and the SUV sustained minor damage to its front bumper and hood. The Waymo AV test driver later reported lower back pain.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_WAYMO = "vehicle.toyota.prius"
MODEL_SUV = "vehicle.lincoln.mkz_2017"
MODEL_PEDESTRIAN = "pedestrian.adult.0001"

param WAYMO_SPEED = VerifaiRange(5, 8)
param WAYMO_BRAKE = VerifaiRange(0.8, 1.0)
param SUV_SPEED = VerifaiRange(8, 12)
param SUV_FOLLOW_DIST = VerifaiRange(5, 15)

param PED_DIST_AHEAD = VerifaiRange(15, 25)
param PED_STOP_DIST = VerifaiRange(10, 15)

CRASH_DIST = 2
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_SPEED)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.PED_STOP_DIST):
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior SUVBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED)

behavior PedestrianBehavior():
    while True:
        wait

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*network.lanes)

waymoSpawnPt = new OrientedPoint in initLane.centerline

suvSpawnPt = new OrientedPoint behind waymoSpawnPt by globalParameters.SUV_FOLLOW_DIST

pedestrianSpawnPt = new OrientedPoint in initLane.centerline ahead of waymoSpawnPt by globalParameters.PED_DIST_AHEAD

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint MODEL_WAYMO,
    with behavior WaymoBehavior()

adversary = new Car at suvSpawnPt,
    with blueprint MODEL_SUV,
    with behavior SUVBehavior()

pedestrian = new Pedestrian at pedestrianSpawnPt,
    with blueprint MODEL_PEDESTRIAN,
    with behavior PedestrianBehavior()

#################################
# REQUIREMENTS                  #
#################################

require (distance to pedestrian) > globalParameters.PED_STOP_DIST
require (distance to initLane.road.end) > TERM_DIST
terminate when (distance to adversary) < CRASH_DIST
terminate when (distance to waymoSpawnPt) > TERM_DIST