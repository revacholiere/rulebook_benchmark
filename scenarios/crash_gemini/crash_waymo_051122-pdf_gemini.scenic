"""
TITLE: waymo_051122-pdf
DESCRIPTION: On May 11, 2022 at 9:19 AM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a SUV on 24th Street and Capp Street. The Waymo AV was attempting to make a right turn from 24th Street onto Capp Street while yielding to a pedestrian in the adjacent crosswalk in autonomous mode. A SUV approaching from behind the Waymo AV passed on the left side, making contact with the Waymo AV’s rear left sensor housing. The Waymo AV operator transitioned the system from autonomous to manual mode just before the moment of impact. The SUV immediately left the scene. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. The Waymo AV sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
SUV_MODEL = "vehicle.lincoln.mkz_2017"
PEDESTRIAN_MODEL = "pedestrian.adult.0001"

param WAYMO_SPEED = VerifaiRange(2.5, 3.5)
param WAYMO_BRAKE = VerifaiRange(0.5, 1.0)

param SUV_SPEED = VerifaiRange(8, 12)
param SUV_DIST = VerifaiRange(-10, -15) # SUV starts behind Waymo AV

param PEDESTRIAN_OFFSET_LANE_LATERAL = VerifaiRange(2.0, 3.0) # Lateral offset from target lane centerline
# No specific pedestrian speed needed as Waymo AV yields to its presence

param SAFETY_DIST = VerifaiRange(5, 8) # Waymo AV detects pedestrian within this distance
param PASSING_INIT_DIST = VerifaiRange(8, 12) # SUV initiates passing when this close to Waymo AV
CRASH_DIST = 2 # Collision distance between Waymo AV and SUV

INIT_DIST = [15, 20] # Waymo AV's initial distance to the intersection
TERM_DIST = 50 # Scenario termination distance for Waymo AV

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)

behavior SUVBehavior(waymo):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED) until (distance to waymo) < globalParameters.PASSING_INIT_DIST
        fasterLaneSec = self.laneSection.fasterLane
        do LaneChangeBehavior(
                laneSectionToSwitch=fasterLaneSec,
                target_speed=globalParameters.SUV_SPEED)
        do FollowLaneBehavior(
                target_speed=globalParameters.SUV_SPEED,
                laneToFollow=fasterLaneSec.lane)
    interrupt when (distance to waymo) <= CRASH_DIST:
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

waymoInitLane = Uniform(*intersection.incomingLanes)
waymoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, waymoInitLane.maneuvers))
waymoTrajectory = [waymoInitLane, waymoManeuver.connectingLane, waymoManeuver.endLane]
waymoSpawnPt = new OrientedPoint in waymoInitLane.centerline

suvSpawnPt = new OrientedPoint following roadDirection from waymoSpawnPt for globalParameters.SUV_DIST

# Pedestrian in the adjacent crosswalk, crossing the street Waymo AV is turning into
pedestrianSpawnPt = new OrientedPoint in waymoManeuver.endLane.centerline at waymoManeuver.endLane.start offset left by globalParameters.PEDESTRIAN_OFFSET_LANE_LATERAL

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior(waymoTrajectory)

adversary = new Car at suvSpawnPt,
    with blueprint SUV_MODEL,
    with behavior SUVBehavior(ego)

pedestrian = new Pedestrian at pedestrianSpawnPt,
    with blueprint PEDESTRIAN_MODEL

require INIT_DIST[0] <= (distance to intersection) <= INIT_DIST[1]
require adversary.laneSection._fasterLane is not None
require always (distance from adversary to ego) > (ego.length / 2 + adversary.length / 2) # Ensure no initial collision
terminate when (distance from adversary to ego) <= CRASH_DIST
terminate when (distance to waymoSpawnPt) > TERM_DIST