"""
TITLE: cruise-collision-report-december-19-2019-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV”) operating in autonomous mode, was traveling northbound on Leavenworth Street at the intersection with Post Street when the Cruise AV yielded to a public transit bus changing into the Cruise AV’s lane from the right adjacent lane. The driver of the Cruise AV disengaged from autonomous mode and, shortly thereafter, another vehicle made contact with the left rear corner of the Cruise AV, damaging the Cruise AV’s left rear fascia and the other vehicle’s right front fascia. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.lincoln.mkz_2017'
BUS_MODEL = 'vehicle.carlamotors.carlabus'
OTHER_VEHICLE_MODEL = 'vehicle.mercedes.sprinter'

param CRUISE_AV_SPEED = VerifaiRange(5, 7)
param CRUISE_AV_BRAKE = VerifaiRange(0.5, 1.0)

param BUS_SPEED = VerifaiRange(4, 6)
param BUS_DIST_AHEAD_OF_EGO = VerifaiRange(15, 25)
param BUS_LANE_CHANGE_START_DIST_TO_EGO = VerifaiRange(10, 15)

param OTHER_VEHICLE_SPEED = VerifaiRange(8, 12)
param OTHER_VEHICLE_DIST_BEHIND_EGO = VerifaiRange(-10, -15)

param SAFETY_DIST_EGO_YIELD = VerifaiRange(10, 15)
CRASH_DIST = 2
INIT_DIST_TO_INTERSECTION = 20
TERM_DIST = 70

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior(bus_obj, other_vehicle_obj):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_SPEED)
    interrupt when (bus_obj.lane is self.lane.slowerLane) and (distance to bus_obj) < globalParameters.SAFETY_DIST_EGO_YIELD:
        take SetBrakeAction(globalParameters.CRUISE_AV_BRAKE)
    interrupt when (distance to other_vehicle_obj) < CRASH_DIST:
        terminate

behavior BusBehavior(ego_obj):
    do FollowLaneBehavior(target_speed=globalParameters.BUS_SPEED) until (distance to ego_obj) < globalParameters.BUS_LANE_CHANGE_START_DIST_TO_EGO
    do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.fasterLane, target_speed=globalParameters.BUS_SPEED)
    do FollowLaneBehavior(target_speed=globalParameters.BUS_SPEED)

behavior OtherVehicleBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.OTHER_VEHICLE_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*filter(lambda l: l.slowerLane is not None and len(l.maneuvers) > 0, intersection.incomingLanes))
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

busLane = egoInitLane.slowerLane
busSpawnPt = new OrientedPoint in busLane.centerline
busSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.BUS_DIST_AHEAD_OF_EGO

otherVehicleSpawnPt = new OrientedPoint in egoInitLane.centerline
otherVehicleSpawnPt = new OrientedPoint behind egoSpawnPt for abs(globalParameters.OTHER_VEHICLE_DIST_BEHIND_EGO)

#################################
# SCENARIO SPECIFICATION        #
#################################

cruise_av = new Car at egoSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with id 'cruise_av'

bus = new Car at busSpawnPt,
    with blueprint BUS_MODEL,
    with id 'bus'

other_vehicle = new Car at otherVehicleSpawnPt,
    with blueprint OTHER_VEHICLE_MODEL,
    with id 'other_vehicle'

# Assign behaviors after all objects are defined for inter-object references
cruise_av.setBehavior(CruiseAVBehavior(bus, other_vehicle))
bus.setBehavior(BusBehavior(cruise_av))
other_vehicle.setBehavior(OtherVehicleBehavior())

require (distance to intersection) < INIT_DIST_TO_INTERSECTION
require (distance from bus to intersection) < INIT_DIST_TO_INTERSECTION
require (distance from other_vehicle to intersection) < INIT_DIST_TO_INTERSECTION
require bus.lane is egoInitLane.slowerLane

terminate when (distance to other_vehicle) < (cruise_av.length + other_vehicle.length) / 2