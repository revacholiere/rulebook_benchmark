"""
TITLE: lyft_120220-pdf
DESCRIPTION: On December 2nd, 2020 at approximately 3:00pm, a Lyft Autonomous Vehicle (Lyft AV A102) operating in manual mode was stationary at a stoplight when it was grazed by a moving third party vehicle. The incident occured on the Embarcadero near the Ferry Building heading nothbound in San Francisco. The third party vehicle aggresively came around from behind of Lyft AV A102 and attempted to cut in front of AV A102. The third party made contact with the Lyft AV leaving visible minor damage to the exterior casing of the Lyft AV's front left lidar unit. The third party sustained no visible damage. The third party called 911, but law enforcement declined reporting to the scene since there were no injuries reported.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

LYFT_AV_SPEED = 0
param THIRD_PARTY_SPEED = VerifaiRange(7, 10)
param THIRD_PARTY_INIT_DIST = VerifaiRange(-15, -25)
param LANE_CHANGE_START_DIST = VerifaiRange(5, 10)

INIT_DIST_TO_INTERSECTION = 20
TERM_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior LyftAVBehavior():
    take SetSpeedAction(LYFT_AV_SPEED)

behavior ThirdPartyBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.THIRD_PARTY_SPEED) \
        until (distance to ego) < globalParameters.LANE_CHANGE_START_DIST
    
    slowerLaneSec = self.laneSection.slowerLane
    do LaneChangeBehavior(laneSectionToSwitch=slowerLaneSec, target_speed=globalParameters.THIRD_PARTY_SPEED)
    
    do FollowLaneBehavior(target_speed=globalParameters.THIRD_PARTY_SPEED, laneToFollow=slowerLaneSec.lane)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))
egoInitLane = Uniform(*intersection.incomingLanes)

require egoInitLane.fasterLane is not None
advStartLane = egoInitLane.fasterLane

egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advSpawnPt = new OrientedPoint in advStartLane.centerline following roadDirection from egoSpawnPt for globalParameters.THIRD_PARTY_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior LyftAVBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior ThirdPartyBehavior()

#################################
# REQUIREMENTS                  #
#################################

require (distance to intersection) < INIT_DIST_TO_INTERSECTION
require adversary.lane is egoInitLane.fasterLane
require adversary.laneSection._slowerLane is not None

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance from adversary to ego) < (ego.length + adversary.length) / 2
terminate when (distance to egoSpawnPt) > TERM_DIST