"""
TITLE: pony-ai-collision-report-june-26-2019-pdf
DESCRIPTION: A Pony.AI autonomous vehicle ("Pony AV") in autonomous mode was traveling southbound on Pine Street heading towards Cameron Hills Drive. A passenger vehicle traveling southbound behind the Pony AV crossed the traffic line and entered the northbound lane of Pine Street in an attempt to pass the Pony AV. The Pony AV's speed remained consistent. After passing the Pony AV by about a quarter car length, the passenger vehicle abruptly turned back into the southbound lane of Pine Street such that it was in very close proximity to the front of the Pony AV. The passenger vehicle then suddenly decelerated. The Pony AV's safety driver disengaged autonomous mode and manually applied the brake. As a result of the passenger vehicle's sudden deceleration, the Pony AV's front-left bumper made contact with the back- right bumper of the passenger vehicle causing minor scratches to both vehicles. The safety driver of the Pony AV and the driver of the naccenoer vehicle etanned tn eyvchange infarmatinn Noqa ininriec were rennrted and the nolice were not called
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

PONY_AV_MODEL = 'vehicle.lincoln.mkz_2017'
PASSENGER_MODEL = 'vehicle.tesla.model3'

param PONY_AV_SPEED = VerifaiRange(5, 7)
param PONY_AV_BRAKE = VerifaiRange(0.7, 1.0)

param PASSENGER_INITIAL_OFFSET_DIST = VerifaiRange(-15, -20)
param PASSENGER_PASSING_SPEED = VerifaiRange(10, 12)
param PASSENGER_DECELERATION_SPEED = VerifaiRange(1, 3)
param PASSENGER_CRITICAL_DIST_BEHIND = VerifaiRange(5, 8)
param PASSENGER_PASSING_ADVANCE_DIST = VerifaiRange(3, 6)

DECEL_DURATION = 3
param SAFETY_DIST = VerifaiRange(8, 12)
CRASH_DIST = 3
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior PonyAVBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.PONY_AV_SPEED)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.PONY_AV_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior PassengerBehavior(ponyAV):
    do FollowLaneBehavior(target_speed=globalParameters.PONY_AV_SPEED) until (distance from ponyAV to self) < globalParameters.PASSENGER_CRITICAL_DIST_BEHIND
    
    passingLaneSection = self.laneSection.fasterLane
    do LaneChangeBehavior(
            laneSectionToSwitch=passingLaneSection,
            target_speed=globalParameters.PASSENGER_PASSING_SPEED
    )
    do FollowLaneBehavior(
            target_speed=globalParameters.PASSENGER_PASSING_SPEED,
            laneToFollow=passingLaneSection.lane
    ) until (distance from ponyAV to self) > globalParameters.PASSENGER_PASSING_ADVANCE_DIST
    
    originalLaneSection = self.laneSection.slowerLane
    do LaneChangeBehavior(
            laneSectionToSwitch=originalLaneSection,
            target_speed=globalParameters.PASSENGER_PASSING_SPEED
    )
    
    do FollowLaneBehavior(
            target_speed=globalParameters.PASSENGER_DECELERATION_SPEED,
            laneToFollow=originalLaneSection.lane
    ) for DECEL_DURATION seconds
    terminate

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*network.lanes)
ponyAVSpawnPt = new OrientedPoint in initLane.centerline

passengerSpawnPt = new OrientedPoint following roadDirection from ponyAVSpawnPt for globalParameters.PASSENGER_INITIAL_OFFSET_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ponyAV = new Car at ponyAVSpawnPt,
    with blueprint PONY_AV_MODEL,
    with behavior PonyAVBehavior()

passenger = new Car at passengerSpawnPt,
    with blueprint PASSENGER_MODEL,
    with behavior PassengerBehavior(ponyAV)

require ponyAV.laneSection._fasterLane is not None
require passenger.laneSection._slowerLane is not None
terminate when (distance to passenger) < CRASH_DIST
terminate when (distance to ponyAVSpawnPt) > TERM_DIST