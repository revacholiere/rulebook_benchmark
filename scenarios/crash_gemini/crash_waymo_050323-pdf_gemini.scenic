"""
TITLE: waymo_050323-pdf
DESCRIPTION: On May 3, 2023 at 10:32 AM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving an SUV on Pine Street near Broderick Street. The Waymo AV was traveling in autonomous mode in the middle lane on westbound Pine Street between Divisadero Street and Broderick Street. A slower traveling van in the left adjacent lane began to initiate a right lane change in front of the Waymo AV, and the Waymo AV test driver transitioned to manual mode and braked. The SUV traveling behind the Waymo AV then made contact with the rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. The Waymo AV and SUV sustained damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_WAYMO = 'vehicle.toyota.prius'
MODEL_SUV = 'vehicle.audi.etron'
MODEL_VAN = 'vehicle.volkswagen.t5'

param WAYMO_SPEED = VerifaiRange(5, 7)
param SUV_SPEED = VerifaiRange(8, 12)
param VAN_SPEED = VerifaiRange(3, 5)

param WAYMO_BRAKE = VerifaiRange(0.7, 1.0)

param WAYMO_INIT_LONGITUDINAL_OFFSET = VerifaiRange(20, 30)
param SUV_FOLLOW_DIST = VerifaiRange(10, 15)
param VAN_AHEAD_DIST = VerifaiRange(10, 15)

param WAYMO_REACTION_DIST_TO_VAN = VerifaiRange(5, 10)
CRASH_DIST_SUV_WAYMO = 3
TERM_SCENARIO_DIST = 70

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_SPEED, trajectory=trajectory)
    interrupt when (distance from self to van) < globalParameters.WAYMO_REACTION_DIST_TO_VAN and van.lane is self.lane.fasterLane:
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
    interrupt when (distance from self to adversary) < CRASH_DIST_SUV_WAYMO:
        terminate

behavior VanBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.VAN_SPEED)
    interrupt when (distance from self to ego) < globalParameters.VAN_AHEAD_DIST / 2 and self.lane is ego.lane.fasterLane:
        do LaneChangeBehavior(
            laneSectionToSwitch=self.laneSection.slowerLane,
            target_speed=globalParameters.VAN_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.VAN_SPEED)

behavior SUVBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

egoInitLane = Uniform(*filter(lambda lane: lane.fasterLane is not None and lane.slowerLane is not None, network.lanes))

egoSpawnPt = new OrientedPoint in egoInitLane.centerline at globalParameters.WAYMO_INIT_LONGITUDINAL_OFFSET

vanSpawnPt = new OrientedPoint in egoInitLane.fasterLane.centerline ahead of ego for globalParameters.VAN_AHEAD_DIST

suvSpawnPt = new OrientedPoint in egoInitLane.centerline behind ego for globalParameters.SUV_FOLLOW_DIST

egoTrajectory = [egoInitLane, egoInitLane]

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL_WAYMO,
    with behavior WaymoBehavior(egoTrajectory)

van = new Car at vanSpawnPt,
    with blueprint MODEL_VAN,
    with behavior VanBehavior()

adversary = new Car at suvSpawnPt,
    with blueprint MODEL_SUV,
    with behavior SUVBehavior()

#################################
# REQUIREMENTS                  #
#################################

require ego.lane.fasterLane is not None
require ego.lane.slowerLane is not None

require van.lane is ego.lane.fasterLane

require adversary.lane is ego.lane
require (distance from adversary to ego) > CRASH_DIST_SUV_WAYMO

terminate when (distance from adversary to ego) < CRASH_DIST_SUV_WAYMO
terminate when (distance to egoSpawnPt) > TERM_SCENARIO_DIST