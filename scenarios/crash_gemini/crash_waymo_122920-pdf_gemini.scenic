"""
TITLE: waymo_122920-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was traveling northbound on 3rd Street in San Francisco in manual mode when it was rear-ended. The Waymo AV was traveling in autonomous mode at approximately 30 MPH in the leftmost lane as it approached the intersection at 24th Street. In this location there are traffic pylons on the left edge of the leftmost lane that separate this lane from the municipal tram line that operates in the median of 3rd Street. As the Waymo AV approached the intersection, a San Francisco MUNI city bus traveling at approximately 40 MPH in the right adjacent lane began to overtake the Waymo AV from the right, while moving toward the Waymo’s lane of travel. Due to the encroaching city bus and the pylons on the left edge of the Waymo AV’s lane, the Waymo AV began to brake. The Waymo AV test driver disengaged autonomous mode and took control of the Waymo AV. Approximately 1 second later, the passenger vehicle behind the Waymo AV made contact with the Waymo AV’s rear bumper at approximately 27 MPH. The Waymo AV was traveling approximately 4 MPH. The Waymo AV sustained significant damage to its rear bumper, and the passenger vehicle sustained
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017' # For Waymo AV and Passenger Vehicle
MUNI_MODEL = 'vehicle.bus.citybus' # For MUNI City Bus
PYLON_MODEL = 'static.prop.streetbarrier' # For traffic pylons

# Speeds in m/s (approximate conversion: 1 MPH = 0.44704 m/s)
param WAYMO_INIT_SPEED = VerifaiRange(12, 14) # Approx. 30 MPH
param WAYMO_BRAKE = VerifaiRange(0.5, 1.0) # Braking strength
param MUNI_SPEED = VerifaiRange(17, 19)     # Approx. 40 MPH
param PASSENGER_SPEED = VerifaiRange(11, 13) # Approx. 27 MPH

# Distances
param PASSENGER_DIST_BEHIND = VerifaiRange(-10, -15) # Passenger vehicle initially behind Waymo AV
param SAFETY_DIST_BUS = VerifaiRange(5, 10) # Waymo AV brakes if bus is too close
param SAFETY_DIST_PYLON = VerifaiRange(1, 2) # Waymo AV brakes if pylon is too close laterally
CRASH_DIST = 2 # Distance for collision (rear-end)
INIT_DIST_TO_INTERSECTION = VerifaiRange(30, 50) # Initial distance to intersection for ego
TERM_DIST_AWAY = 100 # Scenario terminates if ego moves too far away without collision

# Pylon specific constants
PYLON_LATERAL_OFFSET = 1.0 # Offset from lane edge to center of pylon
PYLON_SPACING = 5 # Spacing between pylons along the lane
NUM_PYLONS = 10 # Number of pylons to place
PYLON_INITIAL_OFFSET_ALONG_LANE = -20 # Initial pylon offset relative to ego's lane position

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(target_speed):
    try:
        do FollowLaneBehavior(target_speed=target_speed)
    interrupt when (distance to muni) < globalParameters.SAFETY_DIST_BUS:
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
    interrupt when any(distance to pylon_inst < globalParameters.SAFETY_DIST_PYLON for pylon_inst in pylons_instances):
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)

behavior MuniBehavior(target_speed, laneToFollow):
    do FollowLaneBehavior(target_speed=target_speed, laneToFollow=laneToFollow)

behavior PassengerBehavior(target_speed):
    do FollowLaneBehavior(target_speed=target_speed)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*filter(lambda l: l.slowerLane is not None and l.fasterLane is None and l.maneuvers, network.lanes))

egoSpawnPt = new OrientedPoint in egoInitLane.centerline

muniInitLane = egoInitLane.slowerLane
muniSpawnPt = new OrientedPoint in muniInitLane.centerline at egoSpawnPt

passengerSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.PASSENGER_DIST_BEHIND

pylon_spawn_pts = []
for i in range(NUM_PYLONS):
    point_along_center = new OrientedPoint following roadDirection from egoSpawnPt for (PYLON_INITIAL_OFFSET_ALONG_LANE + i * PYLON_SPACING)
    pylon_pos = point_along_center left of point_along_center by (egoInitLane.width / 2 + PYLON_LATERAL_OFFSET)
    pylon_spawn_pts.append(pylon_pos)

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior(globalParameters.WAYMO_INIT_SPEED)

muni = new Car at muniSpawnPt,
    with blueprint MUNI_MODEL,
    with behavior MuniBehavior(globalParameters.MUNI_SPEED, muniInitLane)

passenger = new Car at passengerSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior(globalParameters.PASSENGER_SPEED)

pylons_instances = []
for i, pylon_spawn_pt in enumerate(pylon_spawn_pts):
    pylon = new StaticObject at pylon_spawn_pt,
        with blueprint PYLON_MODEL
    pylons_instances.append(pylon)

#################################
# REQUIREMENTS                  #
#################################

require globalParameters.INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= globalParameters.INIT_DIST_TO_INTERSECTION[1]
require globalParameters.INIT_DIST_TO_INTERSECTION[0] <= (distance from muni to intersection) <= globalParameters.INIT_DIST_TO_INTERSECTION[1]
require globalParameters.INIT_DIST_TO_INTERSECTION[0] <= (distance from passenger to intersection) <= globalParameters.INIT_DIST_TO_INTERSECTION[1]
require ego.lane is egoInitLane
require muni.lane is muniInitLane
require ego.lane.slowerLane is muni.lane
require ego.lane.fasterLane is None

terminate when (distance to passenger) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST_AWAY