"""
TITLE: waymo_ol316_042422-pdf
DESCRIPTION: On April 24, 2022 at 4:36 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving an SUV on Lincoln Way at 17th Avenue. The Waymo AV was in autonomous mode and traveling on westbound Lincoln Way, when it slowed for the vehicle directly in front of the Waymo AV, which stopped shortly after passing 17th Avenue. Shortly after the Waymo AV came to a stop, the SUV behind the Waymo AV was rear-ended by a pickup truck, and the SUV then made contact with the rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode, and a test driver was present (in the driver’s seating position). Both vehicles sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_WAYMO = 'vehicle.toyota.prius'
MODEL_SUV = 'vehicle.ford.explorer'
MODEL_PICKUP = 'vehicle.dodge.ram_2500'

param WAYMO_SPEED = VerifaiRange(8, 10)
param WAYMO_BRAKE = VerifaiRange(0.8, 1.0)

param SUV_SPEED = VerifaiRange(8, 10)
param SUV_BRAKE = VerifaiRange(0.8, 1.0)

param PICKUP_SPEED = VerifaiRange(10, 12)

param BLK_VEH_DIST_INIT = VerifaiRange(20, 30)
param SUV_INIT_DIST = VerifaiRange(7, 10)
param PICKUP_INIT_DIST = VerifaiRange(7, 10)

param STOP_DIST_FRONT = VerifaiRange(5, 8)
param SAFETY_DIST_TO_WAYMO = VerifaiRange(3, 5)

param EGO_DIST_TO_INTERSECTION = VerifaiRange(15, 25)
param BLK_VEH_DIST_PAST_INTERSECTION = VerifaiRange(5, 15)

TERM_DIST = 100
TERM_TIME = 10

#################################
# AGENT BEHAVIORS               #
#################################

behavior BlockingVehicleBehavior():
    take SetSpeedAction(0)

behavior WaymoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_SPEED, trajectory=trajectory)
    interrupt when distance to blocking_vehicle < globalParameters.STOP_DIST_FRONT:
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)

behavior SUVBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.SUV_SPEED, trajectory=trajectory)
    interrupt when distance to ego < globalParameters.SAFETY_DIST_TO_WAYMO:
        take SetBrakeAction(globalParameters.SUV_BRAKE)

behavior PickupBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.PICKUP_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

blocking_vehicle_spawn_pt = new OrientedPoint in egoManeuver.endLane.centerline
blocking_vehicle_spawn_pt = blocking_vehicle_spawn_pt following roadDirection from egoSpawnPt for globalParameters.BLK_VEH_DIST_INIT

suvSpawnPt = new OrientedPoint behind ego for globalParameters.SUV_INIT_DIST

pickupSpawnPt = new OrientedPoint behind adversary1 for globalParameters.PICKUP_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

blocking_vehicle = new Car at blocking_vehicle_spawn_pt,
    with blueprint MODEL_WAYMO,
    with behavior BlockingVehicleBehavior()

ego = new Car at egoSpawnPt,
    with blueprint MODEL_WAYMO,
    with behavior WaymoBehavior(egoTrajectory)

adversary1 = new Car at suvSpawnPt,
    with blueprint MODEL_SUV,
    with behavior SUVBehavior(egoTrajectory)

adversary2 = new Car at pickupSpawnPt,
    with blueprint MODEL_PICKUP,
    with behavior PickupBehavior(egoTrajectory)

require globalParameters.EGO_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= globalParameters.EGO_DIST_TO_INTERSECTION[1]
require globalParameters.BLK_VEH_DIST_PAST_INTERSECTION[0] <= (distance from blocking_vehicle to intersection) <= globalParameters.BLK_VEH_DIST_PAST_INTERSECTION[1]
terminate when (distance from adversary1 to ego) < (adversary1.length + ego.length) / 2
terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when current_time > TERM_TIME