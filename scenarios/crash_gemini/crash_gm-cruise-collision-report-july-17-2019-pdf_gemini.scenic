"""
TITLE: gm-cruise-collision-report-july-17-2019-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV’), operating in autonomous mode, was traveling westbound on Fell Street between Webster and Fillmore Streets when the Cruise AV began to yield to traffic in the left adjacent lane. The driver of the Cruise disengaged from autonomous mode, and shortly thereafter, another vehicle changing into the same lane made contact with the right rear corner of the Cruise AV, damaging the Cruise AV’s rear hatch and window and right rear body and fascia. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.tesla.model3' # A representative model for Cruise AV
ADVERSARY_MODEL = 'vehicle.mercedes.c_class' # A common passenger vehicle model

param EGO_SPEED = VerifaiRange(7, 10) # Cruise AV traveling at approx. 15-22 mph (7-10 m/s)
param EGO_BRAKE = VerifaiRange(0.5, 0.8) # Moderate braking for yielding

param ADV_SPEED = VerifaiRange(8, 11) # Adversary traveling slightly faster to catch up (8-11 m/s)
param ADV_INIT_DIST = VerifaiRange(15, 25) # Adversary starts 15-25 meters *behind* ego in the adjacent lane.
param LANE_CHANGE_TRIGGER_DIST = VerifaiRange(1, 3) # Adversary starts lane change when its front bumper is 1-3m from ego's rear bumper.

param SAFETY_DIST = VerifaiRange(5, 8) # Ego starts braking when any object is within this distance
CRASH_DIST = 3 # Distance for collision detection in behaviors
TERM_DIST = 70 # Distance for scenario termination if ego has driven too far
TERM_TIME = 15 # Maximum scenario duration in seconds

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        # Ego yields by braking when an object (the adversary) gets too close.
        take SetBrakeAction(globalParameters.EGO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate # Terminate if a crash is imminent (within CRASH_DIST)

behavior AdvBehavior():
    try:
        # Follow its current lane, approaching ego, until its front bumper is sufficiently close to ego's rear bumper.
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED) \
            until (distance from self.front to ego.rear) < globalParameters.LANE_CHANGE_TRIGGER_DIST
        
        # Change to ego's lane. In right-hand traffic, if ego is to adversary's left,
        # ego's lane is the adversary's 'fasterLane'. Adversary hits ego's 'right rear corner',
        # confirming it's merging from the right into ego's lane (a leftward lane change for adv).
        do LaneChangeBehavior(
            laneSectionToSwitch=self.laneSection.fasterLane,
            target_speed=globalParameters.ADV_SPEED
        )
        # Continue in the new lane (which is now ego's lane)
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate # Terminate if a crash is imminent during or after lane change

#################################
# SPATIAL RELATIONS             #
#################################

# Find a lane that has a 'slowerLane' (a lane to its right in right-hand traffic).
# This ensures there's an adjacent lane to the right for the adversary to spawn in.
egoInitLane = Uniform(*filter(lambda lane: lane.slowerLane is not None, network.lanes))
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary starts in the lane to the right of ego's lane, positioned behind ego.
advSpawnPt = new OrientedPoint in egoInitLane.slowerLane.centerline \
    behind ego for globalParameters.ADV_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior EgoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint ADVERSARY_MODEL,
    with behavior AdvBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ensure there's enough road ahead for the scenario to unfold without immediately ending due to road end.
require (distance to egoInitLane.road.endPoint) > TERM_DIST
# Ensure adversary starts sufficiently behind ego to allow for approach and lane change maneuver.
require (distance from adversary to ego) > globalParameters.LANE_CHANGE_TRIGGER_DIST * 2

# Termination conditions
# Terminate if ego drives too far, indicating the scenario completed without incident or took too long.
terminate when (distance to egoSpawnPt) > TERM_DIST
# Terminate if the simulation runs out of time.
terminate when simulation().currentTime > TERM_TIME
# Terminate explicitly when vehicles make physical contact (overlap).
terminate when (distance to adversary) < (ego.length + adversary.length) / 2