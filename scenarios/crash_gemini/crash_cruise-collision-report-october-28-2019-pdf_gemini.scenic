"""
TITLE: cruise-collision-report-october-28-2019-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV”), operating in autonomous mode, was traveling southeast bound on Howard Street near the intersection with 9th Street when a bicyclist in the right adjacent dedicated bike lane veered away from a wayward pedestrian throwing an unknown object in the bicyclist's direction in the crosswalk. The driver of the Cruise AV disengaged from autonomous mode and, shortly thereafter, the bicyclist veered into the Cruise AV's lane and made contact with the right front passenger door of the Cruise AV. No injuries were reported at the scene by either party. Police were called but not dispatched to the scene. The bicyclist later reported injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.lincoln.mkz_2017'
BICYCLE_MODEL = 'vehicle.bh.crossbike'
PEDESTRIAN_MODEL = 'vehicle.pedestrian.adult.0001'

param CRUISE_AV_SPEED = VerifaiRange(5, 7)
param CRUISE_AV_BRAKE = VerifaiRange(0.8, 1.0)

BICYCLE_SPEED = 3
PEDESTRIAN_SPEED = 0

param CRUISE_AV_SAFETY_DIST = VerifaiRange(3, 5)
CRASH_DIST = 1.5

INIT_DIST_FROM_INTERSECTION_MIN = 15
INIT_DIST_FROM_INTERSECTION_MAX = 25
TERM_DIST_FROM_SPAWN = 70

param BICYCLIST_AHEAD_OF_AV = VerifaiRange(5, 10)
BICYCLIST_PED_REACTION_DIST = 10
param PEDESTRIAN_AHEAD_OF_BICYCLIST = VerifaiRange(5, 10)

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.CRUISE_AV_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.CRUISE_AV_SAFETY_DIST) and self.lane is bicyclist.lane:
        take SetBrakeAction(globalParameters.CRUISE_AV_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior BicyclistBehavior(initialBikeLane, mainLaneToMergeSec):
    try:
        do FollowLaneBehavior(target_speed=BICYCLE_SPEED, laneToFollow=initialBikeLane) until (distance to pedestrian) < BICYCLIST_PED_REACTION_DIST
        do LaneChangeBehavior(laneSectionToSwitch=mainLaneToMergeSec, target_speed=BICYCLE_SPEED)
        do FollowLaneBehavior(target_speed=BICYCLE_SPEED, laneToFollow=mainLaneToMergeSec.lane)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior PedestrianBehavior():
    take SetSpeedAction(PEDESTRIAN_SPEED)
    wait forever

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

avInitLane = Uniform(*intersection.incomingLanes)
avManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, avInitLane.maneuvers))
avTrajectory = [avInitLane, avManeuver.connectingLane, avManeuver.endLane]
avSpawnPt = new OrientedPoint in avInitLane.centerline

bicyclistInitLaneSec = avInitLane.laneSections[0].slowerLane
bicyclistInitLane = bicyclistInitLaneSec.lane
bicyclistMergeLaneSec = bicyclistInitLaneSec.fasterLane
bicyclistSpawnPt = new OrientedPoint in bicyclistInitLane.centerline ahead of avSpawnPt for globalParameters.BICYCLIST_AHEAD_OF_AV

pedestrianCrosswalk = Uniform(*intersection.crosswalks)
pedestrianSpawnPt = new OrientedPoint in pedestrianCrosswalk ahead of bicyclistSpawnPt for globalParameters.PEDESTRIAN_AHEAD_OF_BICYCLIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at avSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior CruiseAVBehavior(avTrajectory)

bicyclist = new Car at bicyclistSpawnPt,
    with blueprint BICYCLE_MODEL,
    with behavior BicyclistBehavior(bicyclistInitLane, bicyclistMergeLaneSec)

pedestrian = new Pedestrian at pedestrianSpawnPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianBehavior()

#################################
# REQUIREMENTS                  #
#################################

require INIT_DIST_FROM_INTERSECTION_MIN <= (distance to intersection) <= INIT_DIST_FROM_INTERSECTION_MAX
require INIT_DIST_FROM_INTERSECTION_MIN <= (distance from bicyclist to intersection) <= INIT_DIST_FROM_INTERSECTION_MAX
require (distance from pedestrian to intersection) < INIT_DIST_FROM_INTERSECTION_MAX

require avInitLane.laneSections[0].slowerLane is not None
require bicyclistInitLaneSec.fasterLane is not None

terminate when (distance to egoSpawnPt) > TERM_DIST_FROM_SPAWN
terminate when (distance to bicyclist) < CRASH_DIST