"""
TITLE: weride_062921-pdf
DESCRIPTION: On June 29th 2021 at approximately 2:54 PM our safety driver was driving manually down First Street (a one way street) from San Carlos Street on a sunny day at 20 MPH in downtown San Jose. While proceeding straight down First street, a car parallel to our vehicle initiated a sudden lane change and began moving towards our vehicle from the bus only lane at about 10 MPH. At this point, our driver held the horn down and applied the brakes. Our driver was unable to avoid the other vehicle due to the limited amount of space between our vehicle and the other vehicle, and the side curb to the left. At this time the car was struck; collision was unavoidable. During this time, our driver was approached by the occupants of the vehicle and information was exchanged. They said they were going to back up into the parking lot as security said they couldn't stop there. Our driver attempted to back up but due to a grinding noise, stopped. At this point our driver went to continue to get information but the occupants walked off and he couldn't abandon the vehicle. There was moderate damage to our vehicle on the front bumper and passenger side wheel well in the form of deep dents and a small portion of the passenger side front bumper
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param EGO_INIT_SPEED = VerifaiRange(8.5, 9.5)
param EGO_BRAKE = VerifaiRange(0.7, 1.0)
param EGO_INITIAL_DIST_ALONG_LANE = VerifaiRange(30, 50)

param ADV_INIT_SPEED = VerifaiRange(4.0, 5.0)
param ADV_LONG_OFFSET = VerifaiRange(-2.0, 2.0)
param ADV_LANE_CHANGE_START_DIST = VerifaiRange(15, 25)

param SAFETY_DIST = VerifaiRange(5, 10)
CRASH_DIST = 2
TERM_SCENARIO_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_INIT_SPEED)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.EGO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior AdversaryBehavior(targetLaneSection):
    do FollowLaneBehavior(target_speed=globalParameters.ADV_INIT_SPEED) for globalParameters.ADV_LANE_CHANGE_START_DIST meters
    do LaneChangeBehavior(laneSectionToSwitch=targetLaneSection, target_speed=globalParameters.ADV_INIT_SPEED)
    do FollowLaneBehavior(target_speed=globalParameters.ADV_INIT_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

egoInitLane = Uniform(*filter(lambda l:
    l.slowerLane is not None and
    l.length > (globalParameters.EGO_INITIAL_DIST_ALONG_LANE + globalParameters.ADV_LANE_CHANGE_START_DIST + 50) and
    not l.isIntersectionLane,
    network.lanes))

egoSpawnPt = new OrientedPoint in egoInitLane.centerline,
    at globalParameters.EGO_INITIAL_DIST_ALONG_LANE from start

advInitLane = egoInitLane.slowerLane

advSpawnPt = new OrientedPoint in advInitLane.centerline,
    at (distance from egoSpawnPt to egoInitLane.startPoint) + globalParameters.ADV_LONG_OFFSET from advInitLane.startPoint

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior(ego.laneSection)

require (distance to adversary) > (CRASH_DIST + 1)