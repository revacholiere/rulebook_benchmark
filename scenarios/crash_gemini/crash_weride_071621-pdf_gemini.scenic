"""
TITLE: weride_071621-pdf
DESCRIPTION: At about 11:35 am our vehicle (car 1) was waiting behind a USPS truck to make an unprotected left turn, meanwhile one other vehicle (car 2) waited behind our vehicle. Another non involved vehicle notices the queue of vehicles and passes on the right in the bike lane. As the USPS truck begins to make the turn, car 1 begins to move forward at 7 MPH then slowed to 3 MPH when yielding to the vehicle passing in the bike lane. Car 2 directly behind us strikes our passenger rear bumper. The safety driver then disengaged the vehicle (car 1) and moved into a nearby parking lot to exchange information.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'
USPS_TRUCK_MODEL = 'vehicle.truck.ford.f150'
BICYCLE_MODEL = 'vehicle.bh.crossbike'

param EGO_INIT_SPEED = VerifaiRange(3.0, 3.5) # Approx 7 MPH
param EGO_YIELD_SPEED = VerifaiRange(1.0, 1.5) # Approx 3 MPH

param ADV_SPEED = VerifaiRange(2.5, 3.0) # Approx 5-6 MPH
param ADV_DIST_BEHIND = VerifaiRange(5, 7)

param USPS_TRUCK_SPEED = VerifaiRange(2.0, 2.5) # Approx 5 MPH
param USPS_TRUCK_DIST_AHEAD = VerifaiRange(5, 7)
USPS_TRUCK_CLEAR_DIST = 10 # Distance truck moves before ego starts moving

param BICYCLE_SPEED = VerifaiRange(2.0, 2.5) # Approx 5 MPH
param BICYCLE_INIT_DIST_BEHIND = VerifaiRange(20, 30)
param BICYCLE_YIELD_DIST = VerifaiRange(10, 15)
YIELD_DURATION = 3 # Seconds ego yields

CRASH_DIST = 2
INIT_DIST_TO_INTERSECTION = 2
TERM_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior USPSTruckBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.USPS_TRUCK_SPEED, trajectory=trajectory)

behavior EgoBehavior(trajectory):
    # Wait for USPS truck to start turning and clear a certain distance
    take SetSpeedAction(0) until (distance to usps_truck) > USPS_TRUCK_CLEAR_DIST

    # After USPS truck has moved, start moving forward at EGO_INIT_SPEED
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_INIT_SPEED, trajectory=trajectory)
    # Interrupt when bicycle comes close AND has merged into ego's lane
    interrupt when bicycle is not None and \
                 (distance to bicycle) < globalParameters.BICYCLE_YIELD_DIST and \
                 bicycle.lane is self.lane:
        # Slow to EGO_YIELD_SPEED
        take SetSpeedAction(globalParameters.EGO_YIELD_SPEED) for YIELD_DURATION seconds
        # Resume normal speed
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_INIT_SPEED, trajectory=trajectory)
    # Terminate on collision (e.g., if adversary hits ego)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior AdversaryBehavior():
    # Follow the ego's lane at a constant speed, expecting a rear-end
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

behavior BicycleBehavior():
    # Bicycle starts in a bike lane (slowerLane) and merges into the main lane (fasterLane)
    initialLane = self.lane
    fasterLaneSec = initialLane.fasterLane
    do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.BICYCLE_SPEED)
    do FollowLaneBehavior(target_speed=globalParameters.BICYCLE_SPEED, laneToFollow=fasterLaneSec.lane)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

uspsTruckSpawnPt = new OrientedPoint ahead of egoSpawnPt by globalParameters.USPS_TRUCK_DIST_AHEAD
advSpawnPt = new OrientedPoint behind egoSpawnPt by globalParameters.ADV_DIST_BEHIND

bicycleBikeLane = egoInitLane.slowerLane
bicycleSpawnPt = new OrientedPoint in bicycleBikeLane.centerline behind egoSpawnPt by globalParameters.BICYCLE_INIT_DIST_BEHIND

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior(egoTrajectory)

usps_truck = new Car at uspsTruckSpawnPt,
    with blueprint USPS_TRUCK_MODEL,
    with behavior USPSTruckBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior()

bicycle = new Bicycle at bicycleSpawnPt,
    with blueprint BICYCLE_MODEL,
    with behavior BicycleBehavior()

#################################
# REQUIREMENTS                  #
#################################

require (distance to intersection) < INIT_DIST_TO_INTERSECTION
require (distance from usps_truck to intersection) < INIT_DIST_TO_INTERSECTION
require (distance from adversary to intersection) < INIT_DIST_TO_INTERSECTION

require egoInitLane.slowerLane is not None
require bicycle.laneSection._fasterLane is not None
require not (ego.lane is bicycle.lane)

terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when (distance to adversary) < (ego.length + adversary.length) / 2