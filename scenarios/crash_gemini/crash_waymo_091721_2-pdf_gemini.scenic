"""
TITLE: waymo_091721_2-pdf
DESCRIPTION: On September 17, 2021 at 11:39 AM PDT a Waymo Autonomous Vehicle (““Waymo AV”) operating in San Francisco, California was in a collision involving a passenger vehicle on the 400 block of Washington Street. While in autonomous mode, the Waymo AV was stopped behind a double-parked passenger vehicle in the right-hand lane of traffic with slow-moving (same directional) traffic to its left. The driver of the Waymo AV transitioned the vehicle to manual mode and initiated a lane change into the congested left-hand lane. Before the driver of the Waymo AV could complete this maneuver, the passenger vehicle in front of the Waymo AV shifted into reverse and proceeded to make contact with the rear right sensor of the Waymo AV. Both vehicles sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = 'vehicle.tesla.model3'
MODEL = 'vehicle.lincoln.mkz_2017'

# Waymo AV parameters
WAYMO_INIT_SPEED = 0
param WAYMO_LANECHANGE_SPEED = VerifaiRange(2, 4)
param LANE_CHANGE_INITIATION_TIME = VerifaiRange(2, 4)

# Double-parked passenger vehicle (adversary_front) parameters
param ADV_FRONT_DIST = VerifaiRange(5, 10)
ADV_FRONT_INIT_SPEED = 0
param ADV_FRONT_REVERSE_SPEED = VerifaiRange(-2, -1)
param REVERSE_INITIATION_TIME = VerifaiRange(3, 5)

# Slow-moving traffic (adversary_left) parameters
param ADV_LEFT_OFFSET_FROM_EGO_LONGITUDINAL = VerifaiRange(0, 5)
param ADV_LEFT_SPEED = VerifaiRange(1, 3)

# Scenario constants
COLLISION_BUFFER = 0.5
TERM_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior():
    take SetSpeedAction(WAYMO_INIT_SPEED) for globalParameters.LANE_CHANGE_INITIATION_TIME seconds
    try:
        fasterLaneSec = self.laneSection.fasterLane
        do LaneChangeBehavior(
                laneSectionToSwitch=fasterLaneSec,
                target_speed=globalParameters.WAYMO_LANECHANGE_SPEED)
        do FollowLaneBehavior(
                target_speed=globalParameters.WAYMO_LANECHANGE_SPEED,
                laneToFollow=fasterLaneSec.lane)
    interrupt when distance to adversary_front < (self.length + adversary_front.length) / 2 + COLLISION_BUFFER:
        terminate

behavior DoubleParkedBehavior():
    take SetSpeedAction(ADV_FRONT_INIT_SPEED) for globalParameters.REVERSE_INITIATION_TIME seconds
    take SetSpeedAction(globalParameters.ADV_FRONT_REVERSE_SPEED)

behavior SlowTrafficBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV_LEFT_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

eligibleLaneSections = [
    ls for road in network.roads for lg in road.laneGroups for lane in lg.lanes for ls in lane.laneSections
    if ls.fasterLane is not None
]
egoInitLaneSection = Uniform(*eligibleLaneSections)
egoSpawnPt = new OrientedPoint in egoInitLaneSection.lane.centerline

advFrontSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.ADV_FRONT_DIST

advLeftSpawnPt = new OrientedPoint in egoInitLaneSection.fasterLane.lane.centerline \
                 at egoSpawnPt offset along roadDirection by globalParameters.ADV_LEFT_OFFSET_FROM_EGO_LONGITUDINAL

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoAVBehavior()

adversary_front = new Car at advFrontSpawnPt,
    with blueprint MODEL,
    with behavior DoubleParkedBehavior()

adversary_left = new Car at advLeftSpawnPt,
    with blueprint MODEL,
    with behavior SlowTrafficBehavior()

require ego.laneSection.fasterLane is not None
require adversary_front.lane is ego.lane
require adversary_left.lane is ego.laneSection.fasterLane.lane
require (distance from ego to adversary_front) > 0
require (distance from ego to adversary_left) > 0
require (distance from adversary_front to adversary_left) > 0

terminate when distance to adversary_front < (ego.length + adversary_front.length) / 2 + COLLISION_BUFFER
terminate when (distance to egoSpawnPt) > TERM_DIST