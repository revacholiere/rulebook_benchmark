"""
TITLE: waymo_050723-pdf
DESCRIPTION: On May 7, 2023 at 3:27 PM PDT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a cyclist on Bay Street near Mason Street. The Waymo AV was traveling westbound in the left lane on Bay Street and had just passed Mason Street when it detected an oncoming pickup truck traveling eastbound in the Waymo AV’s lane. The Waymo AV stopped and the pickup truck re-entered the correct lane for eastbound traffic and passed the Waymo AV. The pickup truck was immediately followed by a large group of cyclists traveling eastbound in multiple lanes of the roadway, including the right lanes and on the wrong side of the double-yellow centerline. The Waymo AV remained stopped as the oncoming cyclists rode around both sides of the Waymo AV. One cyclist then made contact with the front of the stationary Waymo AV, and then immediately left the scene. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = 'vehicle.lincoln.mkz_2017'
PICKUP_TRUCK_MODEL = 'vehicle.tesla.cybertruck'
BICYCLE_MODEL = 'vehicle.bh.crossbike'

param WAYMO_INITIAL_SPEED = VerifaiRange(7, 10)
param WAYMO_BRAKE = VerifaiRange(0.5, 1.0)

param PICKUP_TRUCK_SPEED = VerifaiRange(8, 12)
param CYCLIST_SPEED = VerifaiRange(3, 6)

param SAFETY_DIST_WAYMO_TRUCK = VerifaiRange(20, 30)
CRASH_DIST = 1.5

param PICKUP_TRUCK_INIT_DIST_FROM_EGO = VerifaiRange(-50, -40) # Truck oncoming, ahead of ego
param CYCLIST_GROUP_INIT_DIST_FROM_TRUCK = VerifaiRange(5, 10) # Behind truck relative to its direction
param WRONG_WAY_CYCLIST_DIST = VerifaiRange(-20, -10) # Ahead of ego, in ego's lane, but facing opposite

TERM_DIST_EGO = 100
TERM_TIME = 30

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(pickupTruck, collidingCyclist):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_INITIAL_SPEED)
    interrupt when (distance to pickupTruck) < globalParameters.SAFETY_DIST_WAYMO_TRUCK:
        # Waymo AV stops and remains stopped for the truck and subsequent cyclists
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
        do SetSpeedAction(0) \
           until (distance to collidingCyclist) < CRASH_DIST
        terminate

behavior PickupTruckBehavior(waymoAV, targetLane):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.PICKUP_TRUCK_SPEED)
    interrupt when waymoAV.speed == 0 and self.lane is not targetLane:
        # Waymo AV stopped, pickup truck 're-enters correct lane'
        # Assumes targetLane is a 'slowerLane' relative to current lane (truckInitialLane.fasterLane -> mainEastboundLane)
        do LaneChangeBehavior(laneSectionToSwitch=targetLane.laneSections[0], target_speed=globalParameters.PICKUP_TRUCK_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.PICKUP_TRUCK_SPEED, laneToFollow=targetLane) \
           until (distance to waymoAV) > 20
        terminate

behavior CyclistBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.CYCLIST_SPEED)

behavior WrongWayCyclistBehavior():
    # This cyclist is driving against traffic in ego's lane.
    # We model it as maintaining its initial heading and speed.
    do SetSpeedAction(globalParameters.CYCLIST_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

road = Uniform(*filter(lambda r:
    len(r.lanes) >= 2 and
    r.lanes[0].direction is not r.lanes[-1].direction,
    network.roads))

egoLane = Uniform(*filter(lambda l: l.index == 1, road.lanes))
require egoLane.getOppositeLane() is not None

mainEastboundLane = egoLane.getOppositeLane()
require mainEastboundLane.slowerLane is not None
require mainEastboundLane.fasterLane is not None

egoSpawnPt = new OrientedPoint in egoLane.centerline

truckInitialLane = mainEastboundLane.fasterLane
pickupTruckSpawnPt = new OrientedPoint in truckInitialLane.centerline \
    offset along roadDirection from egoSpawnPt for globalParameters.PICKUP_TRUCK_INIT_DIST_FROM_EGO

collidingCyclistSpawnPt = new OrientedPoint in truckInitialLane.centerline \
    offset along roadDirection from pickupTruckSpawnPt for globalParameters.CYCLIST_GROUP_INIT_DIST_FROM_TRUCK

otherCyclistCorrectWaySpawnPt = new OrientedPoint in mainEastboundLane.centerline \
    offset along roadDirection from pickupTruckSpawnPt for globalParameters.CYCLIST_GROUP_INIT_DIST_FROM_TRUCK

wrongWayCyclistSpawnPt = new OrientedPoint in egoLane.centerline \
    offset along roadDirection.opposite() from egoSpawnPt for globalParameters.WRONG_WAY_CYCLIST_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_MODEL

pickupTruck = new Car at pickupTruckSpawnPt,
    with blueprint PICKUP_TRUCK_MODEL

collidingCyclist = new Bicycle at collidingCyclistSpawnPt,
    with blueprint BICYCLE_MODEL

otherCyclistCorrectWay = new Bicycle at otherCyclistCorrectWaySpawnPt,
    with blueprint BICYCLE_MODEL

wrongWayCyclist = new Bicycle at wrongWayCyclistSpawnPt,
    with blueprint BICYCLE_MODEL

ego.setBehavior(WaymoBehavior(pickupTruck, collidingCyclist))
pickupTruck.setBehavior(PickupTruckBehavior(ego, mainEastboundLane))
collidingCyclist.setBehavior(CyclistBehavior())
otherCyclistCorrectWay.setBehavior(CyclistBehavior())
wrongWayCyclist.setBehavior(WrongWayCyclistBehavior())

require (distance to egoLane.centerline) < 0.5
require (distance from pickupTruck to truckInitialLane.centerline) < 0.5
require (distance from collidingCyclist to truckInitialLane.centerline) < 0.5
require (distance from otherCyclistCorrectWay to mainEastboundLane.centerline) < 0.5
require (distance from wrongWayCyclist to egoLane.centerline) < 0.5
require (distance from ego to pickupTruck) > globalParameters.SAFETY_DIST_WAYMO_TRUCK + 5
require (distance from pickupTruck to collidingCyclist) > globalParameters.CYCLIST_GROUP_INIT_DIST_FROM_TRUCK - 5

terminate when (distance to collidingCyclist) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST_EGO
terminate when simulation.currentTime > TERM_TIME