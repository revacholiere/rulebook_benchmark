"""
TITLE: waymo_030622-pdf
DESCRIPTION: On March 6, 2022 at 6:00 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision on Oak Street at Divisadero Street. The Waymo AV was parked in manual mode on the right side of Oak Street just east of Divisadero Street. The Waymo AV inched forward and to the left momentarily, but stopped as two cyclists approached the rear of the vehicle. As the second of the two cyclists attempted to pass the Waymo AV, they made contact with the left rear view mirror. The cyclist stopped momentarily but then rode away without exchanging information. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. The Waymo AV sustained minor damage. No injuries were reported.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = 'vehicle.toyota.prius'
CYCLIST_MODEL = 'vehicle.bh.crossbike'

param WAYMO_INIT_DIST_FROM_INTERSECTION = VerifaiRange(5, 15)
param WAYMO_LATERAL_OFFSET_FROM_CENTERLINE = VerifaiRange(2.0, 3.0) # To place Waymo on the "right side"
param WAYMO_THROTTLE_INCH = VerifaiRange(0.05, 0.15)
param WAYMO_STEER_LEFT_AMOUNT = VerifaiRange(0.1, 0.3)
param WAYMO_MOVE_DURATION = VerifaiRange(1.0, 2.0)
param WAYMO_BRAKE = VerifaiRange(0.5, 0.8)

param PARK_TIME = VerifaiRange(1.0, 3.0) # Initial duration Waymo is fully parked

param CYCLIST_SPEED = VerifaiRange(5, 7)
param CYCLIST_1_INIT_DIST_BEHIND_WAYMO = VerifaiRange(15, 25)
param CYCLIST_2_INIT_DIST_BEHIND_CYCLIST_1 = VerifaiRange(5, 10)
param CYCLIST_LATERAL_OFFSET_FROM_WAYMO = VerifaiRange(0.5, 1.0) # Cyclists pass on the left of Waymo AV

param CYCLIST_APPROACH_DIST = VerifaiRange(5, 10) # Distance at which Waymo AV stops
COLLISION_DIST = 1.0 # For contact with rear view mirror
RIDE_AWAY_TIME = 5 # Time for cyclist 2 to ride away after contact
TERM_TIME = 20 # Overall scenario termination time

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    # Initially parked
    take SetSpeedAction(0)
    wait globalParameters.PARK_TIME seconds

    # Inch forward and to the left momentarily, then stop if cyclists are close
    try:
        take SetThrottleAction(globalParameters.WAYMO_THROTTLE_INCH)
        take SetSteerAction(globalParameters.WAYMO_STEER_LEFT_AMOUNT)
        wait globalParameters.WAYMO_MOVE_DURATION seconds
        # If no cyclists approach, just stop
        take SetSpeedAction(0)
        wait 10 seconds # Stay stopped
    interrupt when withinDistanceToAnyObjs(self, globalParameters.CYCLIST_APPROACH_DIST):
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
        take SetSpeedAction(0)
        wait 10 seconds # Stay stopped
        terminate

behavior Cyclist1Behavior():
    # Cyclist 1 just passes the Waymo AV
    do FollowLaneBehavior(target_speed=globalParameters.CYCLIST_SPEED)

behavior Cyclist2Behavior(waymo_av):
    # Cyclist 2 attempts to pass and makes contact
    try:
        do FollowLaneBehavior(target_speed=globalParameters.CYCLIST_SPEED)
    interrupt when distance to waymo_av < COLLISION_DIST:
        # Made contact, brake momentarily
        take SetBrakeAction(1.0)
        wait 2 seconds
        # Ride away
        do FollowLaneBehavior(target_speed=globalParameters.CYCLIST_SPEED) for RIDE_AWAY_TIME seconds
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

# Find a suitable intersection (e.g., 4-way)
intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Waymo AV is on the right side of an incoming lane, just east of the intersection
waymoInitLane = Uniform(*filter(lambda l: l.numLaneSections > 2, intersection.incomingLanes))
waymoBasePoint = new OrientedPoint in waymoInitLane.centerline
waymoSpawnPt = new OrientedPoint at waymoBasePoint
    for globalParameters.WAYMO_INIT_DIST_FROM_INTERSECTION,
    offset by (0, globalParameters.WAYMO_LATERAL_OFFSET_FROM_CENTERLINE) # X, Y in local coords (Y is lateral)

# Cyclist 1 is behind Waymo AV, slightly to its left to pass
cyclist1SpawnPt = new OrientedPoint behind waymoSpawnPt
    for globalParameters.CYCLIST_1_INIT_DIST_BEHIND_WAYMO,
    offset by (0, -globalParameters.CYCLIST_LATERAL_OFFSET_FROM_WAYMO) # -Y for left in local coords

# Cyclist 2 is behind Cyclist 1, also slightly to the left
cyclist2SpawnPt = new OrientedPoint behind cyclist1SpawnPt
    for globalParameters.CYCLIST_2_INIT_DIST_BEHIND_CYCLIST_1,
    offset by (0, -globalParameters.CYCLIST_LATERAL_OFFSET_FROM_WAYMO) # -Y for left in local coords

#################################
# SCENARIO SPECIFICATION        #
#################################

waymo_av = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior()

cyclist1 = new Bicycle at cyclist1SpawnPt,
    with blueprint CYCLIST_MODEL,
    with behavior Cyclist1Behavior()

cyclist2 = new Bicycle at cyclist2SpawnPt,
    with blueprint CYCLIST_MODEL,
    with behavior Cyclist2Behavior(waymo_av)

#################################
# REQUIREMENTS                  #
#################################

require cyclist1.lane == waymo_av.lane # For simplicity, all in the same road, laterally offset
require cyclist2.lane == waymo_av.lane

terminate when current simulation time > TERM_TIME