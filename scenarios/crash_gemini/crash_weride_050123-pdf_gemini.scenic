"""
TITLE: weride_050123-pdf
DESCRIPTION: On Monday May Ist at 11:41am a Weride autonomous vehicle (Vehicle 1) was in Autonomous Mode stopped at the intersection of Bay St towards Columbus Ave appropriately yielding to a illegally U turning skateboard on Bay St North to South direction in front of the AV (Vehicle 1). While yielding, a bicyclist was coming from behind our AV (Vehicle 1) head was turned left possibly looking for cross traffic. When the cyclist turned his head forward, it was too late to react in time to our stopped vehicle(Vehicle 1) with the given distance and speed they were traveling at in which the cyclist collided with our vehicle (Vehicle 1). Our Weride safety officer immediately disengaged and hand signaled to the bicyclist to pull over to the closest safe place to park as to not obstruct traffic. As our safety officer parked and got out of the car to check on the bicyclist, the bicyclist was already on in motion on his bicycle and "fist bumped" our safety officer while passing by him and leaving the scene without exchanging any information.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

AV_MODEL = 'vehicle.lincoln.mkz_2017'
BICYCLE_MODEL = 'vehicle.bh.crossbike'
SKATEBOARD_MODEL = 'vehicle.micro.microlino'

AV_STOP_SPEED = 0
param SKATEBOARD_SPEED = VerifaiRange(3, 5)
param BICYCLIST_SPEED = VerifaiRange(7, 9)

param AV_AT_INTERSECTION_OFFSET = VerifaiRange(-5, 0)
param SKATEBOARD_TO_INTERSECTION_DIST = VerifaiRange(5, 10)
param BICYCLIST_BEHIND_AV_DIST = VerifaiRange(8, 12)

param BICYCLIST_HEAD_TURN_TIME = VerifaiRange(1.5, 2.5)

COLLISION_PROXIMITY = 1.5
TERM_DIST = 50
SCENARIO_TIMEOUT = 30

#################################
# AGENT BEHAVIORS               #
#################################

behavior AVBehavior():
    while True:
        take SetSpeedAction(AV_STOP_SPEED)

behavior SkateboardBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.SKATEBOARD_SPEED, trajectory=trajectory)

behavior BicyclistBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.BICYCLIST_SPEED) for globalParameters.BICYCLIST_HEAD_TURN_TIME seconds
    do FollowLaneBehavior(target_speed=globalParameters.BICYCLIST_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

avInitLane = Uniform(*intersection.incomingLanes)
avSpawnPt = new OrientedPoint in avInitLane.centerline ahead of intersection for globalParameters.AV_AT_INTERSECTION_OFFSET

avStraightManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, avInitLane.maneuvers))
skateboardInitLane = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, avStraightManeuver.reverseManeuvers)).startLane

skateboardUturnManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, skateboardInitLane.maneuvers))
skateboardTrajectory = [skateboardInitLane, skateboardUturnManeuver.connectingLane, skateboardUturnManeuver.endLane]

skateboardSpawnPt = new OrientedPoint in skateboardInitLane.centerline ahead of intersection for globalParameters.SKATEBOARD_TO_INTERSECTION_DIST

bicyclistSpawnPt = new OrientedPoint in avInitLane.centerline behind av for globalParameters.BICYCLIST_BEHIND_AV_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at avSpawnPt,
    with blueprint AV_MODEL,
    with behavior AVBehavior()

skateboard = new Car at skateboardSpawnPt,
    with blueprint SKATEBOARD_MODEL,
    with behavior SkateboardBehavior(skateboardTrajectory)

bicyclist = new Car at bicyclistSpawnPt,
    with blueprint BICYCLE_MODEL,
    with behavior BicyclistBehavior()

#################################
# REQUIREMENTS                  #
#################################

require (distance to intersection) <= globalParameters.AV_AT_INTERSECTION_OFFSET[1]
require skateboard is ahead of ego
require (distance from skateboard to ego) <= globalParameters.SKATEBOARD_TO_INTERSECTION_DIST[1] + abs(globalParameters.AV_AT_INTERSECTION_OFFSET[0])
require bicyclist is behind ego
require (distance from bicyclist to ego) >= globalParameters.BICYCLIST_BEHIND_AV_DIST[0]
require ego.lane is bicyclist.lane

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance to bicyclist) < COLLISION_PROXIMITY
terminate when (distance to avSpawnPt) > TERM_DIST
terminate after SCENARIO_TIMEOUT seconds