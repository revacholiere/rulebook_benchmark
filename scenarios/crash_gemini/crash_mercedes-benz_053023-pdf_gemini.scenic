"""
TITLE: mercedes-benz_053023-pdf
DESCRIPTION: The Mercedes-Benz was traveling eastbound on Condensa Street at the merge of the eastbound Central Expressway. The driver of the Mercedes-Benz was yielding to cross-traffic and came to a complete stop as he waited for an opening to merge. The driver of the Mazda following the Mercedes-Benz did not come to a stop and contacted the Mercedes-Benz at the rear bumper. The Mazda was travel <Smph at the time of contact with the Mercedes-Benz. No injuries were incurred and both parties were able to drive away from the incident.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param EGO_INIT_SPEED = VerifaiRange(7, 10)
param ADV_INIT_SPEED = VerifaiRange(7, 10)
param ADV_CONTACT_SPEED = VerifaiRange(3, 5)

param ADV_DIST_BEHIND_EGO = VerifaiRange(10, 15)
param YIELD_DIST_FROM_EGO_END_LANE = VerifaiRange(15, 20)
param ADV_SAFETY_DIST_FOR_BRAKING = VerifaiRange(5, 8)

CRASH_DIST = 5
TERM_DIST = 70

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_INIT_SPEED, trajectory=trajectory)
    interrupt when distance to (self.lane.end.point) < globalParameters.YIELD_DIST_FROM_EGO_END_LANE:
        take SetSpeedAction(0)
        wait 10 seconds

behavior AdversaryBehavior(ego_vehicle):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADV_INIT_SPEED)
    interrupt when withinDistanceToObjsInLane(self, globalParameters.ADV_SAFETY_DIST_FOR_BRAKING) and ego_vehicle.speed < 1:
        take SetSpeedAction(globalParameters.ADV_CONTACT_SPEED)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

egoInitLane = Uniform(*filter(lambda l: len(filter(lambda m: m.type is ManeuverType.STRAIGHT, l.maneuvers)) > 0, network.lanes))
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]

egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advSpawnPt = new Car behind ego by globalParameters.ADV_DIST_BEHIND_EGO

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior(ego)

#################################
# REQUIREMENTS                  #
#################################

require (distance to egoInitLane.end.point) > globalParameters.YIELD_DIST_FROM_EGO_END_LANE + 10
require (distance from adversary to egoInitLane.end.point) > globalParameters.YIELD_DIST_FROM_EGO_END_LANE + globalParameters.ADV_DIST_BEHIND_EGO + 10
require ego.lane is adversary.lane
require len(filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers)) > 0

terminate when (distance to adversary) < (ego.length + adversary.length) / 2 + CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST