"""
TITLE: zoox_071321-pdf
DESCRIPTION: While providing space to pass, a Zoox vehicle in conventional mode was slowly moving forward in response to an oncoming truck. While passing, the truck came into contact with the Zoox vehicle's rear radar sensor. There were no injuries and the police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOOX_MODEL = 'vehicle.lincoln.mkz_2017'
TRUCK_MODEL = 'vehicle.carlamotors.carlaccola'

param EGO_SPEED = VerifaiRange(0.5, 1.5)
param ADV_SPEED = VerifaiRange(5, 10)
param INIT_DIST_EGO_ADV = VerifaiRange(30, 60)

CRASH_THRESHOLD = 1.0
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)

behavior TruckBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

egoInitLane = Uniform(*filter(lambda l: l.road.numLanes > 1, network.lanes))
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advInitLane = Uniform(*filter(lambda l:
    l.drivingDirection == egoInitLane.drivingDirection.opposite and l.road == egoInitLane.road,
    network.lanes))

advSpawnPt = new OrientedPoint in advInitLane.centerline at egoSpawnPt offset along egoInitLane.drivingDirection for globalParameters.INIT_DIST_EGO_ADV

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint ZOOX_MODEL,
    with behavior ZooxBehavior()

adversary = new Car at advSpawnPt,
    with blueprint TRUCK_MODEL,
    with behavior TruckBehavior()

#################################
# REQUIREMENTS                  #
#################################

require ego.lane is not adversary.lane
require ego.drivingDirection is not adversary.drivingDirection
require (distance from ego to adversary) >= globalParameters.INIT_DIST_EGO_ADV - 5

terminate when (distance from adversary to ego.rear) < CRASH_THRESHOLD
terminate when (distance to egoSpawnPt) > TERM_DIST or (distance from adversary to advSpawnPt) > TERM_DIST