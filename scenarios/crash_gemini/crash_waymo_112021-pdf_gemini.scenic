"""
TITLE: waymo_112021-pdf
DESCRIPTION: On November 20, 2021 at 11:11 AM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, CA was ina collision involving an SUV on the 1700 block of Steiner Street. The Waymo AV was in autonomous mode and traveling northbound on Steiner Street as it crossed the intersection at Post Street. An SUV then turned right from Post Street onto Steiner Street and began closely following the Waymo AV. The Waymo AV test driver then took manual control and stopped the Waymo AV. The SUV then stopped, reversed, and drove around the Waymo AV and made contact with the Waymo AV’s driver side rear fender. At the time of the impact the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. The Waymo AV sustained minor damage and the SUV left the scene without exchanging information.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = 'vehicle.toyota.prius'
SUV_MODEL = 'vehicle.audi.q7'

param WAYMO_SPEED = VerifaiRange(2.5, 3.5)
param SUV_TURN_SPEED = VerifaiRange(6, 8)
param SUV_FOLLOW_SPEED = VerifaiRange(3.5, 4.5)
param WAYMO_BRAKE = VerifaiRange(0.8, 1.0)
param WAYMO_STOP_DIST = VerifaiRange(4, 6)
param SUV_REVERSE_SPEED_MAG = VerifaiRange(1.5, 2.5)
param REVERSE_DURATION = VerifaiRange(1.5, 2.5)
param SUV_OVERTAKE_SPEED = VerifaiRange(4, 6)

INIT_DIST = 20
TERM_DIST = 50
COLLISION_DIST = 1.5

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.WAYMO_STOP_DIST):
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
        wait until self.speed < 0.1

behavior SUVBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.SUV_TURN_SPEED, trajectory=trajectory)
    do FollowLaneBehavior(target_speed=globalParameters.SUV_FOLLOW_SPEED) until ego.speed < 0.1
    take SetBrakeAction(1.0) until self.speed < 0.1
    take SetSpeedAction(-globalParameters.SUV_REVERSE_SPEED_MAG) for globalParameters.REVERSE_DURATION
    take SetSpeedAction(globalParameters.SUV_OVERTAKE_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

waymoInitLane = Uniform(*intersection.incomingLanes)
waymoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, waymoInitLane.maneuvers))
waymoTrajectory = [waymoInitLane, waymoManeuver.connectingLane, waymoManeuver.endLane]
waymoSpawnPt = new OrientedPoint in waymoInitLane.centerline

possibleAdvInitLanes = filter(lambda l:
    l.road is not waymoInitLane.road and
    any(m.type is ManeuverType.RIGHT_TURN and m.endLane.road is waymoManeuver.endLane.road
        for m in l.maneuvers),
    intersection.incomingLanes
)
advInitLane = Uniform(*possibleAdvInitLanes)
advManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN and m.endLane.road is waymoManeuver.endLane.road, advInitLane.maneuvers))
advTrajectory = [advInitLane, advManeuver.connectingLane, advManeuver.endLane]
advSpawnPt = new OrientedPoint in advInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior(waymoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint SUV_MODEL,
    with behavior SUVBehavior(advTrajectory)

#################################
# REQUIREMENTS                  #
#################################

require (distance to intersection) <= INIT_DIST
require (distance from adversary to intersection) <= INIT_DIST

terminate when (distance from adversary to ego) < COLLISION_DIST
terminate when (distance to waymoSpawnPt) > TERM_DIST