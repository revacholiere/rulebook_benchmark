"""
TITLE: mercedesbenz_08182023-pdf
DESCRIPTION: The driver was manually driving the Mercedes-Benz vehicle on the interchange from the 105W to 405S when the vehicle in front of him came to an abrupt stop due to slowed traffic on the freeway. The driver manually brought the Mercedes-Benz vehicle to a stop in his lane. The vehicle behind him did not come to a stop in time and rear ended the Mercedes-Benz. There was no injury or property damage. The Mercedes-Benz was able to drive away from the accident. Damange was sustained to the rear bumper of the Mercedes Benz and the front bumper of the following vehicle. At no point during the incident was the vehicle operating in autonomous mode.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_EGO = 'vehicle.mercedes.e220'
MODEL_OBS = 'vehicle.lincoln.mkz_2017'
MODEL_ADV = 'vehicle.lincoln.mkz_2017'

param EGO_SPEED = VerifaiRange(10, 15)
param EGO_BRAKE = VerifaiRange(0.8, 1.0)

param OBS_SPEED = VerifaiRange(10, 15)
param OBS_BRAKE = VerifaiRange(0.8, 1.0)
param STOP_DIST_OBS = VerifaiRange(20, 30) # Distance obstacle travels before stopping
param STOP_TIME_OBS = VerifaiRange(3, 5) # Time obstacle stays stopped

param ADV_SPEED = VerifaiRange(10, 15)

param OBS_DIST_FROM_EGO_INIT = VerifaiRange(15, 25) # Obstacle ahead of ego
param ADV_DIST_FROM_EGO_INIT = VerifaiRange(-10, -15) # Adversary behind ego (negative value)

param SAFETY_DIST = VerifaiRange(10, 15) # Ego reaction distance to obstacle
MIN_LANE_LENGTH = 100 # Minimum lane length for the scenario
TERM_TIME = 10 # General scenario termination time if no collision

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when withinDistanceToObjsInLane(self, globalParameters.SAFETY_DIST, filter=lambda obj: obj is obstacle):
        take SetBrakeAction(globalParameters.EGO_BRAKE)

behavior ObstacleBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.OBS_SPEED) for globalParameters.STOP_DIST_OBS meters
    take SetBrakeAction(globalParameters.OBS_BRAKE)
    wait globalParameters.STOP_TIME_OBS seconds
    do FollowLaneBehavior(target_speed=globalParameters.OBS_SPEED) # Resume driving, but collision might terminate first

behavior AdversaryBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*filter(lambda lane: lane.length > MIN_LANE_LENGTH, network.lanes))

egoSpawnPt = new OrientedPoint in initLane.centerline

obstacleSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.OBS_DIST_FROM_EGO_INIT

advSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.ADV_DIST_FROM_EGO_INIT

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL_EGO,
    with behavior EgoBehavior()

obstacle = new Car at obstacleSpawnPt,
    with blueprint MODEL_OBS,
    with behavior ObstacleBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL_ADV,
    with behavior AdversaryBehavior()

require ego.lane is obstacle.lane
require ego.lane is adversary.lane
require obstacle.aheadOf(ego)
require adversary.behind(ego)
require (distance to initLane.end) > (globalParameters.STOP_DIST_OBS + 50) # Ensure enough road ahead for events

terminate when (distance from ego to adversary) < (ego.length + adversary.length) / 2
terminate when (distance from obstacle to ego) < (obstacle.length + ego.length) / 2