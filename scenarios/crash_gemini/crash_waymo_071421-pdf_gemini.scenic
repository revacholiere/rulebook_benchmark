"""
TITLE: waymo_071421-pdf
DESCRIPTION: On July 14, 2021 at 4:47 PM PDT, a Waymo Autonomous Vehicle (“Waymo AV”) was proceeding straight westbound on Clement Street in San Francisco, when a passenger vehicle struck the Waymo AV from behind two times. The passenger vehicle then struck the Waymo AV a third time, on the left side of the Waymo AV, as it passed on the left, then immediately fled the scene. The San Francisco Police Department is investigating the event as a criminal act. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode, and a test driver was present (in the driver’s seating position).
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'
param WAYMO_SPEED = VerifaiRange(5, 8)
param PASSENGER_SPEED = VerifaiRange(10, 15)
param PASSENGER_FLEE_SPEED = VerifaiRange(15, 20)
param PASSENGER_INIT_OFFSET = VerifaiRange(-15, -25)

param REAR_END_THRESHOLD = VerifaiRange(3, 7)
param FLEE_DISTANCE = VerifaiRange(30, 50)
INIT_DIST_FROM_INTERSECTION = 50
TERM_MAX_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.WAYMO_SPEED)

behavior PassengerBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED) \
        until (distance to ego) < globalParameters.REAR_END_THRESHOLD
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED) for 1 second

    fasterLaneSec = self.laneSection.fasterLane
    if fasterLaneSec is not None:
        do LaneChangeBehavior(
            laneSectionToSwitch=fasterLaneSec,
            target_speed=globalParameters.PASSENGER_SPEED)
        do FollowLaneBehavior(
            target_speed=globalParameters.PASSENGER_FLEE_SPEED,
            laneToFollow=fasterLaneSec.lane)
    else:
        do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_FLEE_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*filter(lambda l: l.fasterLane is not None, network.lanes))

waymoSpawnPt = new OrientedPoint in initLane.centerline
passengerSpawnPt = new OrientedPoint following roadDirection from waymoSpawnPt for globalParameters.PASSENGER_INIT_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary = new Car at passengerSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior()

require (distance to intersection) > INIT_DIST_FROM_INTERSECTION
require (distance from adversary to intersection) > INIT_DIST_FROM_INTERSECTION
require initLane.fasterLane is not None

terminate when (distance to egoSpawnPt) > TERM_MAX_DIST
terminate when (distance from adversary to ego) > globalParameters.FLEE_DISTANCE