"""
TITLE: waymo_060523-pdf
DESCRIPTION: On June 5, 2023 at 12:53 PM PT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a van in a parking lot at 3911 3rd Street. The Waymo AV came to a stop while yielding to a pickup truck which was reversing into a perpendicular parking space in front of the Waymo AV. While the Waymo AV was stopped, a van which was in a parking space immediately to the right of the Waymo AV began reversing out of the parking space. The rear of the van made contact with the right side of the Waymo AV. The Waymo AV sustained damage. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
VAN_MODEL = "vehicle.nissan.nv200"
PICKUP_MODEL = "vehicle.ford.f150"

param WAYMO_INITIAL_SPEED = VerifaiRange(0.5, 1.5)
param WAYMO_BRAKE = VerifaiRange(0.8, 1.0)
param PICKUP_SPEED = VerifaiRange(0.5, 1.0)
param VAN_SPEED = VerifaiRange(0.5, 1.0)

param WAYMO_STOP_DIST = VerifaiRange(5, 8)
CRASH_DIST = 2
TERM_DIST = 50

# Relative positioning constants (made constants if used in 'require')
PICKUP_FRONT_DIST = 10
param PICKUP_SIDE_OFFSET = VerifaiRange(2, 4)
param PICKUP_REVERSE_LENGTH = VerifaiRange(2, 4)

VAN_SIDE_DIST = 4
param VAN_REVERSE_LENGTH = VerifaiRange(2, 4)

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_INITIAL_SPEED, trajectory=trajectory)
    interrupt when distance to pickup <= globalParameters.WAYMO_STOP_DIST:
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
        do FollowLaneBehavior(target_speed=0)
    interrupt when distance to adversary <= CRASH_DIST:
        terminate

behavior PickupTruckBehavior():
    try:
        do
            take SetSpeedAction(-globalParameters.PICKUP_SPEED)
            take SetSteerAction(0.5)
        for globalParameters.PICKUP_REVERSE_LENGTH seconds
    finally:
        do FollowLaneBehavior(target_speed=0)

behavior VanBehavior(waymo):
    do FollowLaneBehavior(target_speed=0) until waymo.speed < 0.1
    try:
        do
            take SetSpeedAction(-globalParameters.VAN_SPEED)
            take SetSteerAction(-0.5)
        for globalParameters.VAN_REVERSE_LENGTH seconds
    finally:
        do FollowLaneBehavior(target_speed=0)

#################################
# SPATIAL RELATIONS             #
#################################

waymoAisleLane = Uniform(*filter(lambda l: l.length > 30 and not l.isStartOfIntersection and not l.isEndOfIntersection, network.lanes))

waymoSpawnPt = new OrientedPoint in waymoAisleLane.centerline

waymoTrajectory = [waymoAisleLane]

pickupSpawnPt = new OrientedPoint ahead of waymoSpawnPt by PICKUP_FRONT_DIST offset right by globalParameters.PICKUP_SIDE_OFFSET, with heading waymoSpawnPt.heading + 90 deg

vanSpawnPt = new OrientedPoint right of waymoSpawnPt by VAN_SIDE_DIST, with heading waymoSpawnPt.heading

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoAVBehavior(waymoTrajectory)

pickup = new Car at pickupSpawnPt,
    with blueprint PICKUP_MODEL,
    with behavior PickupTruckBehavior()

adversary = new Car at vanSpawnPt,
    with blueprint VAN_MODEL,
    with behavior VanBehavior(ego)

require (distance from ego to network.intersections) > 10
require (distance from pickup to network.intersections) > 10
require (distance from adversary to network.intersections) > 10

require (distance from ego to pickup) < PICKUP_FRONT_DIST + 5
require (distance from ego to adversary) < VAN_SIDE_DIST + 5

terminate when (distance to waymoSpawnPt) > TERM_DIST