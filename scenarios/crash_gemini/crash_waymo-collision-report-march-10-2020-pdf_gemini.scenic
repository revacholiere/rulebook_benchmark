"""
TITLE: waymo-collision-report-march-10-2020-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was in autonomous mode in the slip lane from southbound Whisman Station Drive to northbound Central Expressway in Mountain View when it was rear-ended. The Waymo AV was yielding to approaching traffic on Central Expressway when a passenger vehicle made contact with the Waymo AV’s rear bumper at approximately 4 MPH. The Waymo AV sustained minor damage to its rear bumper, and the passenger vehicle sustained minor damage to its front bumper. No injuries were reported.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
PASSENGER_MODEL = "vehicle.lincoln.mkz_2017"

param WAYMO_INITIAL_SPEED = VerifaiRange(5, 7)
WAYMO_YIELD_SPEED = 1 # Waymo AV speed when yielding (very slow, near stop)

param PASSENGER_SPEED = VerifaiRange(7, 9)
param PASSENGER_INIT_DIST = VerifaiRange(-10, -15) # Initial distance behind Waymo AV

param YIELD_DIST = VerifaiRange(15, 25) # Distance to merge point to start yielding
CRASH_DIST = 5 # Distance for collision detection
TERM_DIST = 100 # Termination distance for the ego vehicle

param EGO_INIT_POS_FROM_MERGE = VerifaiRange(25, 35) # Initial distance of ego from merge point

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior(trajectory, mergePoint):
    try:
        # Move towards the merge point
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_INITIAL_SPEED, trajectory=trajectory) \
            until (distance to mergePoint) < globalParameters.YIELD_DIST
        # Once near the merge point, yield by slowing down significantly
        take SetSpeedAction(WAYMO_YIELD_SPEED) for 5 seconds
        # After yielding, if scenario hasn't terminated, continue along trajectory
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_INITIAL_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

# Find an intersection
intersection = Uniform(*filter(lambda i: i.is3Way or i.is4Way, network.intersections))

# Choose an incoming lane and a turn maneuver to simulate a slip lane
initEntryLane = Uniform(*intersection.incomingLanes)
slipManeuver = Uniform(*filter(lambda m: m.type in [ManeuverType.RIGHT_TURN, ManeuverType.LEFT_TURN], initEntryLane.maneuvers))

# The connectingLane is the slip lane
slipLane = slipManeuver.connectingLane
egoTrajectory = [slipLane, slipManeuver.endLane] # Waymo AV follows the slip lane and then merges

# The point where the slip lane merges into the main road
mergePoint = slipLane.endPoint

# Spawn the Waymo AV in the slip lane, at a certain distance before the merge point
egoSpawnPt = new OrientedPoint following -roadDirection from mergePoint for globalParameters.EGO_INIT_POS_FROM_MERGE

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoAVBehavior(egoTrajectory, mergePoint)

adversary = new Car following roadDirection from ego for globalParameters.PASSENGER_INIT_DIST,
    with blueprint PASSENGER_MODEL,
    with behavior FollowTrajectoryBehavior(target_speed=globalParameters.PASSENGER_SPEED, trajectory=egoTrajectory)

require adversary.lane is ego.lane
require adversary.distanceTo(ego) < 0

terminate when (distance to adversary) < (ego.length + adversary.length) / 2
terminate when (distance to egoSpawnPt) > TERM_DIST