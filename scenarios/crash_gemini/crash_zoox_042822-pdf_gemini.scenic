"""
TITLE: zoox_042822-pdf
DESCRIPTION: A Zoox vehicle in autonomous mode came to a complete stop at the T-junction stop sign at Colin P. Kelly Jr. St. and Brannan St. and yielded to oncoming traffic from the left. Due to traffic flow, the driver then disengaged autonomous mode and reversed, making contact with a vehicle that had approached from the rear and was attempting to pass the Zoox vehicle to make a right turn. There were no injuries and the police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

EGO_MODEL = 'vehicle.zoox.zoox_2019'
OTHER_MODEL = 'vehicle.lincoln.mkz_2017'

param EGO_SPEED_APPROACH = VerifaiRange(5, 7)
param EGO_REVERSE_SPEED = VerifaiRange(-2.5, -3.5)
EGO_STOP_DIST = 5
EGO_REVERSE_DURATION = 2

param ADV1_SPEED = VerifaiRange(8, 12)
param ADV1_INITIAL_DIST_TO_JUNCTION = VerifaiRange(15, 25)

param ADV2_SPEED = VerifaiRange(5, 7)
param ADV2_DIST_BEHIND_EGO_INIT = VerifaiRange(5, 10)

param YIELD_DIST = VerifaiRange(10, 20)
MAX_YIELD_TIME = 5

CRASH_DIST = 2
TERM_DIST = 100
INITIAL_JUNC_DIST_FOR_EGO = VerifaiRange(20, 30)

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(junction_pt):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED_APPROACH)
        wait until (distance to junction_pt) < EGO_STOP_DIST
        
        take SetSpeedAction(0)
        
        wait until (distance from adversary1 to junction_pt) > globalParameters.YIELD_DIST or currentSimulation.currentTime > MAX_YIELD_TIME

        take SetSpeedAction(globalParameters.EGO_REVERSE_SPEED)
        wait for EGO_REVERSE_DURATION seconds
        
        take SetSpeedAction(0)

    interrupt when (distance to adversary2) < CRASH_DIST:
        terminate

behavior Adv1Behavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.ADV1_SPEED, trajectory=trajectory)

behavior Adv2Behavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADV2_SPEED)
    interrupt when (distance to ego) < (ego.length + self.length) / 2 + 1:
        take SetSpeedAction(0)
    interrupt when (distance to ego) < CRASH_DIST:
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

junction = Uniform(*filter(lambda i: i.isTJunction, network.intersections))

egoInitLane = Uniform(*junction.incomingLanes)
junction_pt = new OrientedPoint in egoInitLane.centerline at junction.position

adv1InitLane = Uniform(*filter(lambda l: l.road is not egoInitLane.road, junction.incomingLanes))
adv1Maneuver = Uniform(*adv1InitLane.maneuvers)
adv1Trajectory = [adv1InitLane, adv1Maneuver.connectingLane, adv1Maneuver.endLane]
adv1SpawnPt = new OrientedPoint in adv1InitLane.centerline

egoSpawnPt = new OrientedPoint in egoInitLane.centerline

adv2SpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for -globalParameters.ADV2_DIST_BEHIND_EGO_INIT

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint EGO_MODEL,
    with behavior EgoBehavior(junction_pt)

adversary1 = new Car at adv1SpawnPt,
    with blueprint OTHER_MODEL,
    with behavior Adv1Behavior(adv1Trajectory)

adversary2 = new Car at adv2SpawnPt,
    with blueprint OTHER_MODEL,
    with behavior Adv2Behavior()

#################################
# REQUIREMENTS                  #
#################################

require INITIAL_JUNC_DIST_FOR_EGO[0] <= (distance to junction_pt) <= INITIAL_JUNC_DIST_FOR_EGO[1]
require ADV1_INITIAL_DIST_TO_JUNCTION[0] <= (distance from adversary1 to junction_pt) <= ADV1_INITIAL_DIST_TO_JUNCTION[1]
require (distance from adversary2 to ego) > (ego.length + adversary2.length) / 2

terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when (distance from adversary1 to junction_pt) > TERM_DIST
terminate when (distance from adversary2 to ego) > TERM_DIST