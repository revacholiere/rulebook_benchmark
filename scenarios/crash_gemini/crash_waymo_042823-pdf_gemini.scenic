"""
TITLE: waymo_042823-pdf
DESCRIPTION: The Waymo AV was traveling east on 25th Street between Sanchez Street and Vicksburg Street when it approached an SUV that was stopped in the lane in front of the Waymo AV. The Waymo AV began passing the stopped SUV on the left when the SUV began reversing in the lane. The Waymo AV then stopped behind and to the left of the SUV, and the SUV continued reversing and began a turning maneuver to enter a parking space. The left side of the SUV made contact with the front right corner of the Waymo AV. At the time of the impact, the Waymo AV was stopped and the AV’s Level 4 ADS was engaged in autonomous mode. Both vehicles sustained damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_WAYMO = 'vehicle.toyota.prius'
MODEL_SUV = 'vehicle.lincoln.mkz_2017'

param WAYMO_INIT_SPEED = VerifaiRange(5, 7)
param WAYMO_BRAKE = VerifaiRange(0.8, 1.0)

SUV_STOPPED_SPEED = 0
param SUV_REVERSE_SPEED = VerifaiRange(-2, -4)
param SUV_TURN_STEER = VerifaiRange(-0.4, -0.6) # Negative steer for turning its front left while reversing

param EGO_ADV_INIT_DIST = VerifaiRange(20, 30)
param PASSING_START_DIST = VerifaiRange(10, 15)
param SUV_REVERSE_TRIGGER_DIST = VerifaiRange(3, 5)

CRASH_DIST = 2
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED)
    interrupt when (distance to adversary) < globalParameters.PASSING_START_DIST:
        fasterLaneSec = self.laneSection.fasterLane
        require fasterLaneSec is not None
        do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.WAYMO_INIT_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED, laneToFollow=fasterLaneSec.lane) \
            until (adversary.speed < 0 and withinDistanceToAnyObjs(self, globalParameters.SUV_REVERSE_TRIGGER_DIST))
    interrupt when (adversary.speed < 0 and withinDistanceToAnyObjs(self, globalParameters.SUV_REVERSE_TRIGGER_DIST)):
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior SUVBehavior():
    do FollowLaneBehavior(target_speed=SUV_STOPPED_SPEED) \
        until (distance from ego to self) < globalParameters.PASSING_START_DIST

    take SetSpeedAction(globalParameters.SUV_REVERSE_SPEED) for 2 seconds

    take SetSpeedAction(globalParameters.SUV_REVERSE_SPEED)
    take SetSteerAction(globalParameters.SUV_TURN_STEER)

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*network.lanes)
require initLane.laneSections[0].fasterLane is not None

advSpawnPt = new OrientedPoint in initLane.centerline

egoSpawnPt = new OrientedPoint behind advSpawnPt by globalParameters.EGO_ADV_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

adversary = new Car at advSpawnPt,
    with blueprint MODEL_SUV,
    with behavior SUVBehavior()

ego = new Car at egoSpawnPt,
    with blueprint MODEL_WAYMO,
    with behavior WaymoBehavior()

require (distance from ego to adversary) >= globalParameters.EGO_ADV_INIT_DIST
require not (distance to intersection) < 30
require not (distance from adversary to intersection) < 30