"""
TITLE: zoox_083022-pdf
DESCRIPTION: A Zoox vehicle in autonomy was proceeding straight on Kearney Street in San Francisco, CA, in stop-and-go traffic. The Zoox vehicle came to a stop for a vehicle ahead when Vehicle Two made light contact with the Zoox vehicle's rear bumper from behind. There were no injuries and the police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param EGO_SPEED = VerifaiRange(5, 7)
param EGO_BRAKE = VerifaiRange(0.5, 0.8)
param DRIVE_BEFORE_STOP_DIST = VerifaiRange(20, 30)

param ADV_SPEED = VerifaiRange(7, 9)
param ADV_DIST_FROM_EGO_INIT = VerifaiRange(5, 10)

TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when (distance to egoSpawnPt) > globalParameters.DRIVE_BEFORE_STOP_DIST:
        take SetBrakeAction(globalParameters.EGO_BRAKE)

behavior VehicleTwoBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*network.lanes)
egoSpawnPt = new OrientedPoint in initLane.centerline
adversarySpawnPt = new OrientedPoint in egoSpawnPt.lane.centerline \
    behind egoSpawnPt by globalParameters.ADV_DIST_FROM_EGO_INIT

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior ZooxBehavior()

adversary = new Car at adversarySpawnPt,
    with blueprint MODEL,
    with behavior VehicleTwoBehavior()

require ego.lane is adversary.lane
terminate when (distance to adversary) < (ego.length + adversary.length) / 2