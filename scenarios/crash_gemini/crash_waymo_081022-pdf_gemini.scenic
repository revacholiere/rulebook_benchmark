"""
TITLE: waymo_081022-pdf
DESCRIPTION: On August 10, 2022 at 5:05 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving an SUV on Clayton Street at Market Street. While approaching a merge onto southbound Market Street from southbound Clayton Street, the Waymo AV came to a stop to yield for approaching traffic on the left. While the Waymo AV was stopped, an SUV approached from behind and made contact with the rear bumper of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged. Both vehicles sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = 'vehicle.lincoln.mkz_2017'
SUV_MODEL = 'vehicle.jeep.wrangler_rubicon_2017'

param WAYMO_PRE_STOP_SPEED = VerifaiRange(5, 7)
WAYMO_STOP_BRAKE = 1.0
param WAYMO_STOP_DIST = VerifaiRange(10, 15)

param SUV_SPEED = VerifaiRange(7, 9)
param ADV_INIT_DIST = VerifaiRange(-15, -20) # SUV starts behind Waymo AV

CRASH_DIST = 1
TERM_DIST = 70

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_PRE_STOP_SPEED, trajectory=trajectory)
    interrupt when (distance to intersection) < globalParameters.WAYMO_STOP_DIST:
        take SetBrakeAction(WAYMO_STOP_BRAKE)
        wait forever

behavior SUVBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

waymoInitLane = Uniform(*intersection.incomingLanes)
waymoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, waymoInitLane.maneuvers))
waymoTrajectory = [waymoInitLane, waymoManeuver.connectingLane, waymoManeuver.endLane]
waymoSpawnPt = new OrientedPoint in waymoInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoAVBehavior(waymoTrajectory)

adversary = new Car following roadDirection from ego for globalParameters.ADV_INIT_DIST,
    with blueprint SUV_MODEL,
    with behavior SUVBehavior()

#################################
# REQUIREMENTS                  #
#################################

require (distance to intersection) > globalParameters.WAYMO_STOP_DIST
require (distance to intersection) < TERM_DIST
require abs(adversary.position.x - ego.position.x) < 2

terminate when (distance to adversary) < CRASH_DIST
terminate when (distance to waymoSpawnPt) > TERM_DIST