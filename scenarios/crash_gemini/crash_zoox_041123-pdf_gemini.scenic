"""
TITLE: zoox_041123-pdf
DESCRIPTION: A Zoox vehicle in autonomy was proceeding northbound on Kearny Street in stop-and-go traffic through an active construction zone. At the same time, an e-scooter traveling near the right curb was passing other slow traffic behind the Zoox vehicle. Before the e-scooter could also pass the Zoox vehicle on the right, the e-scooter weaved away from the curb, seemingly to avoid a drainage grate, and came within a close following distance behind the Zoox vehicle. As the Zoox vehicle came to a stop again for traffic ahead the e-scooter rider did not stop, and the e-scooter made contact with the right rear tail light of the Zoox vehicle. The e-scooter rider remained upright, did not stop to exchange information, and immediately rode off while the Zoox vehicle was still stopped. There were no injuries and police were not called. The damage to the Zoox vehicle was limited to a cracked tail light lens.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017' # Represents the Zoox vehicle
SCOOTER_MODEL = 'vehicle.bh.crossbike' # Represents the e-scooter

param EGO_SPEED = VerifaiRange(2, 5) # Zoox vehicle's speed in stop-and-go traffic
param EGO_BRAKE = VerifaiRange(0.7, 1.0) # Braking force when Zoox vehicle stops
param PRE_STOP_TIME = VerifaiRange(3, 6) # Time Zoox vehicle travels before coming to a stop

param SCOOTER_INITIAL_SPEED = VerifaiRange(5, 8) # E-scooter's speed when passing traffic
param SCOOTER_INIT_OFFSET = VerifaiRange(-20, -30) # Initial distance of scooter behind Zoox vehicle

param SCOOTER_WEAVE_DIST = VerifaiRange(5, 8) # Distance to drainage grate that triggers the scooter's weave
param LANE_CHANGE_DURATION = VerifaiRange(1, 2) # Duration of a single lane change during the weave
param GRATE_DISTANCE = VerifaiRange(10, 15) # Distance of the drainage grate from the scooter's spawn point
param GRATE_OFFSET_RIGHT = VerifaiRange(1.0, 1.5) # Lateral offset of the drainage grate within its lane

CRASH_DIST = 1.0 # Distance threshold for declaring a collision
TERM_DIST = 60 # Maximum distance for the ego vehicle to travel before terminating the scenario

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior():
    # Zoox vehicle proceeds for some time, then comes to a complete stop for traffic ahead
    do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED) for globalParameters.PRE_STOP_TIME seconds
    take SetBrakeAction(globalParameters.EGO_BRAKE) # Apply brakes to stop
    wait until True # Remain stopped indefinitely, allowing the scooter to collide

behavior ScooterBehavior():
    # E-scooter's behavior: travel, weave to avoid grate, then continue without stopping
    try:
        # Initial travel in its lane
        do FollowLaneBehavior(target_speed=globalParameters.SCOOTER_INITIAL_SPEED)
    interrupt when (distance to drainageGratePt) < globalParameters.SCOOTER_WEAVE_DIST:
        # Weave away from the curb (move left to the faster lane, which is the Zoox's lane)
        if self.laneSection._fasterLane is not None:
            fasterLaneSec = self.laneSection.fasterLane
            do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.SCOOTER_INITIAL_SPEED)
            do FollowLaneBehavior(target_speed=globalParameters.SCOOTER_INITIAL_SPEED, laneToFollow=fasterLaneSec.lane) for globalParameters.LANE_CHANGE_DURATION seconds
            # Weave back towards the curb (move right to the original slower lane)
            if self.laneSection._slowerLane is not None:
                slowerLaneSec = self.laneSection.slowerLane
                do LaneChangeBehavior(laneSectionToSwitch=slowerLaneSec, target_speed=globalParameters.SCOOTER_INITIAL_SPEED)
    # After the weave, continue following the lane at speed; the rider does not stop
    do FollowLaneBehavior(target_speed=globalParameters.SCOOTER_INITIAL_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Select a lane for the Zoox vehicle that has a slower lane (e.g., a bike lane or rightmost lane)
egoLane = Uniform(*filter(lambda l: l._slowerLane is not None, network.lanes))

# The scooter starts in the slower lane relative to the ego vehicle, representing "near the right curb"
scooterInitialLane = egoLane.slowerLane

# Zoox vehicle's initial position
egoSpawnPt = new OrientedPoint in egoLane.centerline

# E-scooter's initial position, behind the Zoox vehicle in its slower lane
scooterSpawnPt = new OrientedPoint in scooterInitialLane.centerline following roadDirection from egoSpawnPt for globalParameters.SCOOTER_INIT_OFFSET

# Drainage grate's position: in the scooter's initial lane, ahead of it, and slightly to the right (towards the curb)
drainageGratePt = new Point following roadDirection from scooterSpawnPt for globalParameters.GRATE_DISTANCE,
    offset right by globalParameters.GRATE_OFFSET_RIGHT

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior ZooxBehavior()

scooter = new Bicycle at scooterSpawnPt,
    with blueprint SCOOTER_MODEL,
    with behavior ScooterBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ensure the slower lane exists for the scooter to start in
require scooterInitialLane is not None
# Ensure the lane structure allows the scooter to weave into ego's lane and back
require scooterInitialLane._fasterLane is egoLane
require egoLane._slowerLane is scooterInitialLane
# Ensure an initial safe separation between ego and scooter
require (distance to scooter) > abs(globalParameters.SCOOTER_INIT_OFFSET) / 2

#################################
# TERMINATION CONDITIONS        #
#################################

# Terminate when the scooter collides with the ego vehicle
terminate when (distance to scooter) < CRASH_DIST
# Terminate if the ego vehicle travels too far, indicating scenario completion or failure to trigger collision
terminate when (distance to egoSpawnPt) > TERM_DIST