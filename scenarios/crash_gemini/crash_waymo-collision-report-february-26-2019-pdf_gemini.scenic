"""
TITLE: waymo-collision-report-february-26-2019-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was stopped in autonomous mode at the intersection of Miramonte Avenue and Covington Road in Los Altos when it was involved in a collision. The Waymo AV was traveling northbound on Miramonte Avenue, when it reached a four-way stop sign intersection. The Waymo AV stopped to yield to another vehicle at the intersection, at which time a passenger vehicle rear-ended the Waymo AV at approximately 39 MPH. At the time of the collision the Waymo AV had been stopped for approximately 1.5 seconds. The Waymo AV sustained major damage to its rear bumper, rear hatch, and rear quarter panels, and the passenger vehicle sustained major damage to its front bumper, hood, and front quarter panels. First responders attended to the scene, but neither party reported injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param WAYMO_INIT_SPEED = VerifaiRange(3, 5)
param WAYMO_STOP_TIME_SECONDS = VerifaiRange(1.3, 1.7)

param PASSENGER_SPEED_MPS = VerifaiRange(16, 18)
param PASSENGER_DIST_FROM_EGO = VerifaiRange(-10, -15)

param EGO_INIT_DIST_TO_INTERSECTION = VerifaiRange(15, 20)
CRASH_DIST = 2
STOP_LINE_OFFSET = 3
TERM_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory, stop_line_point):
    do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED, trajectory=[trajectory[0]]) \
        until (distance to stop_line_point) < 0.5

    take SetSpeedAction(0) for globalParameters.WAYMO_STOP_TIME_SECONDS seconds

    do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED, trajectory=trajectory)

    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior PassengerBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.PASSENGER_SPEED_MPS, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

stop_line_point = new ScenicPoint at egoInitLane.points[-1] offset along -roadDirection by STOP_LINE_OFFSET

adversarySpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.PASSENGER_DIST_FROM_EGO

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior(egoTrajectory, stop_line_point)

adversary = new Car at adversarySpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior(egoTrajectory)

require EGO_INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= EGO_INIT_DIST_TO_INTERSECTION[1]
require (distance from adversary to ego) > CRASH_DIST
terminate when (distance to adversary) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST