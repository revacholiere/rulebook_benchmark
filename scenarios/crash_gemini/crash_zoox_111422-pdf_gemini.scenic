"""
TITLE: zoox_111422-pdf
DESCRIPTION: A Zoox vehicle in autonomy was proceeding straight on Folsom Street when a leading vehicle in the lane began to slow down prompting the Zoox vehicle to slow correspondingly. The Zoox vehicle, with brake lights illuminated, had slowed to 5 mph when it was struck from the rear by vehicle number 2. Zoox vehicle camera footage shows the driver of vehicle 2 holding their cellphone raised in their right hand. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

ZOOX_INIT_DIST_RANGE = [20, 25]
param ZOOX_SPEED_INITIAL = VerifaiRange(7, 10) # Initial speed for Zoox (m/s)
ZOOX_SPEED_FINAL = 2.2352 # Approximately 5 mph in m/s
param ZOOX_BRAKE = VerifaiRange(0.5, 1.0) # Brake amount for Zoox

param LEADER_DIST_AHEAD = VerifaiRange(10, 15) # Distance of leader ahead of Zoox
param LEADER_SPEED_INITIAL = VerifaiRange(7, 10) # Initial speed for leader
LEADER_SPEED_FINAL = 1.34112 # Approximately 3 mph in m/s
param LEADER_SLOW_DOWN_TRIGGER_DIST = VerifaiRange(15, 20) # Distance from intersection for leader to start slowing
LEADER_SLOW_DOWN_DURATION = 3 # Seconds for leader to slow down

param ADV_DIST_BEHIND = VerifaiRange(5, 8) # Distance of adversary behind Zoox
param ADV_SPEED_INITIAL = VerifaiRange(8, 12) # Initial speed for adversary (faster than Zoox/leader)

param SAFETY_DIST = VerifaiRange(8, 12) # Distance to leader for Zoox to start braking
CRASH_DIST = 1
TERM_DIST = 70

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.ZOOX_SPEED_INITIAL, trajectory=trajectory)
    interrupt when withinDistanceToObjsInLane(self, globalParameters.SAFETY_DIST):
        take SetSpeedAction(ZOOX_SPEED_FINAL)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior LeaderBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.LEADER_SPEED_INITIAL, trajectory=trajectory) \
        until (distance from self to intersection) < globalParameters.LEADER_SLOW_DOWN_TRIGGER_DIST
    take SetSpeedAction(LEADER_SPEED_FINAL) \
        for LEADER_SLOW_DOWN_DURATION seconds
    do FollowTrajectoryBehavior(target_speed=LEADER_SPEED_FINAL, trajectory=trajectory)

behavior AdversaryBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.ADV_SPEED_INITIAL, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

zooxInitLane = Uniform(*intersection.incomingLanes)
zooxManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, zooxInitLane.maneuvers))
zooxTrajectory = [zooxInitLane, zooxManeuver.connectingLane, zooxManeuver.endLane]
zooxSpawnPt = new OrientedPoint in zooxInitLane.centerline

leaderSpawnPt = new OrientedPoint following roadDirection from zooxSpawnPt for globalParameters.LEADER_DIST_AHEAD
leaderTrajectory = zooxTrajectory

advSpawnPt = new OrientedPoint following roadDirection from zooxSpawnPt for -globalParameters.ADV_DIST_BEHIND
advTrajectory = zooxTrajectory

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at zooxSpawnPt,
    with blueprint MODEL,
    with behavior ZooxBehavior(zooxTrajectory)

leader = new Car at leaderSpawnPt,
    with blueprint MODEL,
    with behavior LeaderBehavior(leaderTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior(advTrajectory)

#################################
# REQUIREMENTS                  #
#################################

require ZOOX_INIT_DIST_RANGE[0] <= (distance to intersection) <= ZOOX_INIT_DIST_RANGE[1]
require (distance from leader to ego) > 0
require (distance from ego to adversary) > 0

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance to adversary) < (ego.length + adversary.length) / 2
terminate when (distance to zooxSpawnPt) > TERM_DIST