"""
TITLE: waymo_08232023-pdf
DESCRIPTION: On August 23, 2023 at 9:54 PM PT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a heavy truck on Mason Street at Vandewater Street. The Waymo AV was traveling northbound on Mason Street when it approached a heavy truck and trailer that was stopped in the adjacent lane on the left side of the street. As the Waymo began to slowly pass the truck, the truck initiated a reversing turn maneuver into a loading bay on the left side of Mason Street. The Waymo AV then came to a stop, and as the Waymo AV was initiating its own reversing maneuver to clear the path for the truck, the right side of the trailer made contact with the front driver’s side corner of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode. The Waymo AV sustained damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
TRUCK_MODEL = "vehicle.dodge.ram_2500" # Using a general large vehicle model

param WAYMO_PASSING_SPEED = VerifaiRange(3, 5) # Waymo slowly passes
param WAYMO_REVERSING_SPEED = VerifaiRange(0.5, 1.5) # Waymo's attempt to reverse
param WAYMO_BRAKE = VerifaiRange(0.5, 1.0) # Waymo's brake force

param TRUCK_REVERSING_SPEED = VerifaiRange(0.5, 2.0) # Truck's reversing speed
param TRUCK_STEER_ANGLE = VerifaiRange(0.2, 0.4) # Truck's left turn steer angle (positive for left in Metadrive-like systems)

param TRUCK_AHEAD_DIST = VerifaiRange(15, 25) # Truck is initially ahead of Waymo
param TRUCK_REVERSE_START_DIST_FROM_WAYMO = VerifaiRange(10, 15) # Distance from Waymo to truck when truck starts reversing
param WAYMO_TRUCK_DIST_COLLISION_WARNING = VerifaiRange(5, 8) # Distance for Waymo to react/stop

CRASH_DIST = 3 # Distance at which collision is considered to have occurred
TERM_DIST = 70 # General termination distance for scenario

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    # Waymo tries to pass the truck
    try:
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_PASSING_SPEED)
    # Interrupt when truck is too close, indicating potential collision or blockage
    interrupt when (distance to truck) < globalParameters.WAYMO_TRUCK_DIST_COLLISION_WARNING:
        # Waymo stops
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
        # As Waymo AV was initiating its own reversing maneuver
        # Simulate a brief reverse attempt
        take SetSpeedAction(-globalParameters.WAYMO_REVERSING_SPEED) for 1 second
        # After this, the collision is expected, so no further actions in this behavior needed.

behavior TruckBehavior():
    # Truck is initially stopped
    take SetSpeedAction(0)
    # Wait for the Waymo AV to approach before initiating its maneuver
    wait until (distance from self to ego) < globalParameters.TRUCK_REVERSE_START_DIST_FROM_WAYMO
    # Truck initiates a reversing turn maneuver into a loading bay (simplified)
    # Move backward and steer left
    do SetSpeedAction(-globalParameters.TRUCK_REVERSING_SPEED)
    take SetSteerAction(globalParameters.TRUCK_STEER_ANGLE)
    # Continue this maneuver until the scenario terminates (e.g., collision)

#################################
# SPATIAL RELATIONS             #
#################################

# Find a suitable lane for Waymo to travel
# Ensure the lane has a slower (left adjacent) lane for the truck
# And ensure it's long enough to accommodate the initial setup and movement
waymoInitialLane = Uniform(*filter(lambda l:
    l.slowerLane is not None and l.length > (globalParameters.TRUCK_AHEAD_DIST + TERM_DIST), network.lanes))

# Waymo's initial position
waymoSpawnPt = new OrientedPoint in waymoInitialLane.centerline

# Truck's initial position: in the adjacent lane on the left, ahead of Waymo
truckInitialLane = waymoInitialLane.slowerLane
truckSpawnPt = new OrientedPoint following roadDirection from waymoSpawnPt for globalParameters.TRUCK_AHEAD_DIST,
    in truckInitialLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior()

truck = new Car at truckSpawnPt,
    with blueprint TRUCK_MODEL,
    with behavior TruckBehavior()

#################################
# REQUIREMENTS                  #
#################################

require ego.lane is not truck.lane # Ensure Waymo and truck are in different lanes initially
require waymoInitialLane.slowerLane is not None # Ensure the truck's adjacent lane exists

#################################
# TERMINATION                   #
#################################

terminate when (distance to truck) < CRASH_DIST # Terminate on collision
terminate when (distance to waymoSpawnPt) > TERM_DIST # Terminate if Waymo travels too far