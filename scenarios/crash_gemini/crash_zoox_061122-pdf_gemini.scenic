"""
TITLE: zoox_061122-pdf
DESCRIPTION: A Zoox vehicle was in autonomy exiting a parking space on Halsey Ave. between S. Norfolk St. and Eisenhower St. in San Mateo, CA, with a second vehicle stopped in the lane with its right turn indicator on, when a third vehicle overtook the second vehicle and cut in abruptly from the left, making contact with the front left side and sensors of the Zoox vehicle as it was exiting the space. The Zoox operator disengaged to manual mode just before the contact.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOOX_MODEL = 'vehicle.lincoln.mkz_2017' # Placeholder, can be a specific Zoox model if available
STOPPED_MODEL = 'vehicle.audi.tt'
OVERTAKE_MODEL = 'vehicle.mercedes.cclass'

param ZOOX_SPEED = VerifaiRange(0.5, 1.5) # m/s, approx 1-3 mph for exiting parking
STOPPED_SPEED = 0
param OVERTAKE_SPEED = VerifaiRange(7, 10) # m/s, approx 15-22 mph

# Zoox initial position relative to the main lane centerline and stopped vehicle
param ZOOX_LAT_OFFSET = VerifaiRange(-2.0, -1.0) # Lateral offset to the right of centerline (negative values for right)
param ZOOX_LONG_OFFSET = VerifaiRange(5, 10) # Longitudinal offset ahead of stopped vehicle

# Overtake vehicle initial distance behind the stopped vehicle in the faster lane
param OVERTAKE_INIT_DIST = VerifaiRange(20, 30)

# Distance for overtaking vehicle to start cutting in relative to the stopped vehicle
param OVERTAKE_CUT_IN_TRIGGER_DIST = VerifaiRange(5, 10)

param ZOOX_BRAKE = VerifaiRange(0.5, 1.0)
param SAFETY_DIST = VerifaiRange(3, 5) # Distance for Zoox to start braking
CRASH_DIST = 1 # Distance for scenario termination on contact

TERM_DIST = 50 # General termination distance
TERM_TIME = 10 # General termination time for behaviors

#################################
# AGENT BEHAVIABLES             #
#################################

behavior ZooxBehavior():
    try:
        # Zoox vehicle attempts to merge into the lane from its offset position
        do FollowLaneBehavior(target_speed=globalParameters.ZOOX_SPEED)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        # Zoox operator disengages to manual mode and brakes
        take SetBrakeAction(globalParameters.ZOOX_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior StoppedVehicleBehavior():
    # The second vehicle is stopped in the lane
    take SetSpeedAction(STOPPED_SPEED)

behavior OvertakeAndCutInBehavior(targetStoppedVehicle, targetZooxVehicle):
    try:
        # Overtake vehicle drives in the faster lane until it's close enough to the stopped vehicle
        do FollowLaneBehavior(target_speed=globalParameters.OVERTAKE_SPEED) \
            until (distance to targetStoppedVehicle) < globalParameters.OVERTAKE_CUT_IN_TRIGGER_DIST

        # Then, cut in abruptly from the left by changing to the slower lane (the main lane)
        slowerLaneSec = self.laneSection.slowerLane
        do LaneChangeBehavior(laneSectionToSwitch=slowerLaneSec, target_speed=globalParameters.OVERTAKE_SPEED)

        # Continue driving in the target lane until the scenario ends
        do FollowLaneBehavior(target_speed=globalParameters.OVERTAKE_SPEED) for TERM_TIME seconds
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

# Select a main lane that has a faster lane for the overtaking vehicle
mainLane = Uniform(*filter(lambda l: l.successors and l.fasterLane is not None, network.lanes))

# Position the stopped vehicle in the main lane
stoppedSpawnPt = new OrientedPoint in mainLane.centerline

# Position the Zoox vehicle slightly ahead of the stopped vehicle and offset to the right
# (simulating exiting a parking space on the right side of the road)
zooxSpawnPt = new OrientedPoint at stoppedSpawnPt \
    offset by (globalParameters.ZOOX_LAT_OFFSET, globalParameters.ZOOX_LONG_OFFSET)

# Position the overtaking vehicle behind the stopped vehicle in the faster lane
overtakeSpawnPt = new OrientedPoint in mainLane.fasterLane.centerline \
    behind stoppedSpawnPt for globalParameters.OVERTAKE_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

zoox = new Car at zooxSpawnPt,
    with blueprint ZOOX_MODEL,
    with behavior ZooxBehavior()

stoppedVehicle = new Car at stoppedSpawnPt,
    with blueprint STOPPED_MODEL,
    with behavior StoppedVehicleBehavior()

overtakeVehicle = new Car at overtakeSpawnPt,
    with blueprint OVERTAKE_MODEL,
    with behavior OvertakeAndCutInBehavior(stoppedVehicle, zoox)

# Ensure Zoox starts off the centerline to simulate exiting a parking space
require abs(distance from zoox to zoox.laneSection.centerline) > 0.5
# Ensure the stopped vehicle is in the main lane
require stoppedVehicle.lane is mainLane
# Ensure the overtaking vehicle starts in the faster lane
require overtakeVehicle.lane is mainLane.fasterLane

# Terminate on collision between Zoox and overtaking vehicle
terminate when (distance from zoox to overtakeVehicle) < (zoox.length + overtakeVehicle.length) / 2
# Terminate if Zoox drives too far from its initial position