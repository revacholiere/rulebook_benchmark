"""
TITLE: zoox_082322-pdf
DESCRIPTION: A Zoox vehicle in autonomy had made a right turn from Oakdell Rd. onto Santa Cruz Ave. in Menlo Park, CA and was preparing to make an immediate, unprotected left turn onto Sharon Road. The Zoox vehicle was slowing and moving at approximately 2 mph with its brake lamps and left turn indicator illuminated, yielding to an oncoming vehicle with the right of way. A following vehicle - traveling at approximately 24 mph - then struck the Zoox vehicle's right rear bumper, and that vehicle's driver airbag appeared to have deployed on impact. The Zoox operator disengaged autonomy, proceeded with the left turn, and pulled over. The following vehicle continued its path of travel, veered out of the lane, and collided with a tree on the left side of the road. The Menlo Park Police Department was called to the scene. Two Zoox operators sustained minor injuries and it is unknown if the driver of the other vehicle sustained injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_ZOOX = 'vehicle.lincoln.mkz_2017'
MODEL_FOLLOWING = 'vehicle.toyota.prius'
MODEL_ONCOMING = 'vehicle.tesla.model3'

param ZOOX_LOW_SPEED = VerifaiRange(0.8, 1.2) # Approximately 2 mph (0.89 m/s)
param ZOOX_BRAKE = VerifaiRange(0.5, 0.8)

param FOLLOWING_SPEED = VerifaiRange(10, 12) # Approximately 24 mph (10.73 m/s)
param FOLLOWING_DIST_BEHIND = VerifaiRange(10, 15) # Initial distance adversary1 is behind ego

param ONCOMING_SPEED = VerifaiRange(8, 10) # Typical speed for oncoming vehicle
param ONCOMING_INIT_OFFSET = VerifaiRange(20, 30) # Distance from intersection for oncoming vehicle

param SAFETY_DIST_YIELD = VerifaiRange(15, 25) # Zoox yields to oncoming within this distance
CRASH_DIST = 2 # Small distance for collision termination

param EGO_INIT_DIST_TO_INTERSECTION = VerifaiRange(10, 20)
TERM_MAX_DIST = 70

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior(trajectory):
    # Zoox vehicle is slowing and preparing for a left turn, yielding to oncoming.
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.ZOOX_LOW_SPEED, trajectory=trajectory)
    interrupt when (distance to adversary2) < globalParameters.SAFETY_DIST_YIELD:
        # Yield to the oncoming vehicle by braking
        take SetBrakeAction(globalParameters.ZOOX_BRAKE)

behavior FollowingBehavior():
    # Following vehicle travels at approximately 24 mph
    do FollowLaneBehavior(target_speed=globalParameters.FOLLOWING_SPEED)

behavior OncomingBehavior(trajectory):
    # Oncoming vehicle has the right of way and proceeds at a normal speed.
    do FollowTrajectoryBehavior(target_speed=globalParameters.ONCOMING_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

# Select a 4-way intersection for the maneuvers
intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Ego (Zoox vehicle) is preparing for an unprotected left turn.
egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary1 (following vehicle) is behind ego in the same lane.
adv1SpawnPt = new OrientedPoint behind ego by globalParameters.FOLLOWING_DIST_BEHIND

# Adversary2 (oncoming vehicle) is in an opposing lane with a straight maneuver.
adv2InitLane = Uniform(*filter(lambda lane:
    lane.isOppositeTo(egoInitLane) and any(m.type is ManeuverType.STRAIGHT for m in lane.maneuvers),
    intersection.incomingLanes))
adv2Maneuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, adv2InitLane.maneuvers))
adv2Trajectory = [adv2InitLane, adv2Maneuver.connectingLane, adv2Maneuver.endLane]
adv2SpawnPt = new OrientedPoint in adv2InitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL_ZOOX,
    with behavior ZooxBehavior(egoTrajectory)

adversary1 = new Car at adv1SpawnPt,
    with blueprint MODEL_FOLLOWING,
    with behavior FollowingBehavior()

adversary2 = new Car at adv2SpawnPt,
    with blueprint MODEL_ONCOMING,
    with behavior OncomingBehavior(adv2Trajectory)

#################################
# REQUIREMENTS                  #
#################################

require globalParameters.EGO_INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= globalParameters.EGO_INIT_DIST_TO_INTERSECTION[1]
require globalParameters.ONCOMING_INIT_OFFSET[0] <= (distance from adversary2 to intersection) <= globalParameters.ONCOMING_INIT_OFFSET[1]
require (distance to adversary1) > CRASH_DIST

terminate when (distance to adversary1) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_MAX_DIST