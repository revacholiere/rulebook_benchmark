"""
TITLE: cruise_122122-pdf
DESCRIPTION: A Cruise autonomous vehicle ("Cruise AV"), operating in supervised autonomous mode, was traveling westbound on Brannan Street between Ritch Street and 3rd Street. At the same time, a black BMW traveling eastbound on Brannan Street swerved into oncoming traffic and in front of the Cruise AV. The AV operator disengaged from autonomous into manual mode and braked to avoid the oncoming BMW, but shortly thereafter, contact was made with the Cruise AV's front right quarter panel, damaging the front passenger side of the Cruise AV. The BMW then struck a parked vehicle that was beside the Cruise AV. The driver of the BMW fled the scene on foot. There were no reported injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_MODEL = 'vehicle.lincoln.mkz_2017'
BMW_MODEL = 'vehicle.audi.a2'
PARKED_MODEL = 'vehicle.toyota.prius'

param EGO_SPEED = VerifaiRange(8, 12)
param EGO_BRAKE = VerifaiRange(0.7, 1.0)

param ADV_SPEED = VerifaiRange(15, 20)
param ADV_SWERVE_TRIGGER_DIST = VerifaiRange(25, 35)

param PARKED_LATERAL_OFFSET = VerifaiRange(3.5, 4.5)
param PARKED_LONGITUDINAL_OFFSET = VerifaiRange(-5, 5)

SAFETY_DIST = 10
CRASH_DIST = 3
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(targetAdversary):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when (targetAdversary.lane is self.lane) and (distance to targetAdversary) < globalParameters.SAFETY_DIST:
        take SetBrakeAction(globalParameters.EGO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior BMWBehavior(initialLane, targetLaneForSwerve):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED, laneToFollow=initialLane)
    interrupt when distance to ego < globalParameters.ADV_SWERVE_TRIGGER_DIST:
        do LaneChangeBehavior(laneSectionToSwitch=targetLaneForSwerve.laneSection, target_speed=globalParameters.ADV_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED, laneToFollow=targetLaneForSwerve)

#################################
# SPATIAL RELATIONS             #
#################################

road = Uniform(*filter(lambda r: not r.isIntersection and len(r.drivingLanes) >= 2, network.roads))

egoInitLane = Uniform(*road.drivingLanes)
advInitLane = egoInitLane.oppositeLane

require advInitLane is not None

egoSpawnPt = new OrientedPoint in egoInitLane.centerline
advSpawnPt = new OrientedPoint in advInitLane.centerline

parkedSpawnPt = new OrientedPoint at egoSpawnPt offset right of ego by globalParameters.PARKED_LATERAL_OFFSET offset along roadDirection by globalParameters.PARKED_LONGITUDINAL_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

adversary = new Car at advSpawnPt,
    with blueprint BMW_MODEL,
    with behavior BMWBehavior(advInitLane, egoInitLane)

ego = new Car at egoSpawnPt,
    with blueprint CRUISE_MODEL,
    with behavior EgoBehavior(adversary)

parkedVehicle = new Car at parkedSpawnPt,
    with blueprint PARKED_MODEL,
    with behavior None,
    is static

#################################
# REQUIREMENTS                  #
#################################

require (distance to adversary) > globalParameters.ADV_SWERVE_TRIGGER_DIST + CRASH_DIST
require (distance to parkedVehicle) > CRASH_DIST
require (distance from adversary to parkedVehicle) > CRASH_DIST

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance to adversary) < CRASH_DIST
terminate when (distance from adversary to parkedVehicle) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST