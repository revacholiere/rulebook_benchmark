"""
TITLE: zoox_06182023-pdf
DESCRIPTION: A Zoox vehicle in manual mode was stopped in stop-and-go traffic southbound on Montgomery St. at the intersection of Pine St. when it was struck from behind by vehicle 2. Police were not called, and Zoox operators later reported injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param ADV_INIT_DIST = VerifaiRange(-10, -15)
param ADV_SPEED = VerifaiRange(7, 9)

CRASH_DIST = 2
TERM_DIST = 40

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior():
    try:
        take SetSpeedAction(0)
        wait 10 seconds
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior AdversaryBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

adversarySpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.ADV_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior()

adversary = new Car at adversarySpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior()

require adversary.lane is ego.lane
terminate when (distance from adversary to ego) < CRASH_DIST