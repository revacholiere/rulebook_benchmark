"""
TITLE: cruise-collision-report-october-26-2019-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV”), operating in autonomous mode, was traveling southeast bound on The Embarcadero near the intersection with Battery Street when the Cruise AV yielded to another vehicle in the left adjacent lane that encroached into the Cruise AV’s lane. The driver of the Cruise AV disengaged from autonomous mode and, shortly thereafter, a second vehicle behind the Cruise AV made contact with the rear bumper of the Cruise AV, damaging the Cruise AV’s right rear bumper, fascia, signal lamp, and radar assembly. There were no injuries reported at the scene by either party and police were not called. Both of the Cruise AV test operators later mentioned neck and back injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.lincoln.mkz_2017' # Placeholder model for Cruise AV
OTHER_VEHICLE_MODEL = 'vehicle.toyota.prius' # Placeholder model for other vehicles

# Ego (Cruise AV) parameters
param EGO_SPEED = VerifaiRange(7, 10)  # Approx 15-22 MPH
param EGO_BRAKE = VerifaiRange(0.7, 1.0) # Strong brake to yield

# Adversary 1 (Encroaching Vehicle) parameters
param ADV1_SPEED = VerifaiRange(7, 10) # Similar speed to Ego
param ADV1_INIT_OFFSET = VerifaiRange(10, 15) # Adv1 starts this far ahead of Ego
param ADV1_ENCROACH_DIST = VerifaiRange(5, 8) # Adv1 starts its lane change when this far from Ego

# Adversary 2 (Rear-ending Vehicle) parameters
param ADV2_SPEED = VerifaiRange(10, 13) # Faster than Ego initially
param ADV2_INIT_OFFSET = VerifaiRange(-10, -15) # Adv2 starts this far behind Ego
param ADV2_BRAKE = VerifaiRange(0.4, 0.6) # Moderate brake, not enough to avoid collision

# Scenario parameters
param SAFETY_DIST_ENCROACH = VerifaiRange(6, 9) # Ego reacts when Adv1 is within this distance
param SAFETY_DIST_REAR = VerifaiRange(8, 12) # Adv2 reacts when Ego is within this distance
COLLISION_DIST = 1.0 # Distance for collision detection
INIT_ROAD_CLEARANCE = 30 # Minimum distance from intersections for initial placement
TERM_DIST = 100 # Scenario terminates if Ego travels this far without incident

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when (distance from self to adversary1) < globalParameters.SAFETY_DIST_ENCROACH and \
                     adversary1.lane is self.lane.fasterLane:
        # Ego yields to the encroaching vehicle (which is in the left adjacent lane and attempting to merge)
        take SetBrakeAction(globalParameters.EGO_BRAKE)
        # Stay stopped or very slow to allow for rear-end collision
        take SetSpeedAction(0)
    interrupt when withinDistanceToAnyObjs(self, COLLISION_DIST):
        terminate

behavior EncroachingVehicleBehavior():
    # Follow its lane until it's close enough to Ego to start encroaching
    do FollowLaneBehavior(target_speed=globalParameters.ADV1_SPEED) \
        until (distance from self to ego) < globalParameters.ADV1_ENCROACH_DIST

    # Encroach into Ego's lane (which is its slower lane)
    do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.slowerLane, target_speed=globalParameters.ADV1_SPEED)

    # After attempting lane change, continue in the new lane (or its original if interrupted)
    do FollowLaneBehavior(target_speed=globalParameters.ADV1_SPEED)

behavior RearEndingVehicleBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADV2_SPEED)
    interrupt when (distance from self to ego) < globalParameters.SAFETY_DIST_REAR:
        # Try to brake, but may not be enough
        take SetBrakeAction(globalParameters.ADV2_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, COLLISION_DIST):
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

# Find a suitable multi-lane, straight road segment
lane = Uniform(*filter(lambda l: l.length > INIT_ROAD_CLEARANCE * 2 and l.fasterLane is not None, network.lanes))

egoSpawnPt = new OrientedPoint in lane.centerline

# Adversary 1 (encroaching vehicle) in the left adjacent lane (fasterLane)
adv1Lane = lane.fasterLane
adv1SpawnPt = new OrientedPoint in adv1Lane.centerline ahead of egoSpawnPt by globalParameters.ADV1_INIT_OFFSET

# Adversary 2 (rear-ending vehicle) in the same lane as Ego, behind Ego
adv2SpawnPt = new OrientedPoint in lane.centerline behind egoSpawnPt by abs(globalParameters.ADV2_INIT_OFFSET)

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior CruiseAVBehavior()

adversary1 = new Car at adv1SpawnPt,
    with blueprint OTHER_VEHICLE_MODEL,
    with behavior EncroachingVehicleBehavior()

adversary2 = new Car at adv2SpawnPt,
    with blueprint OTHER_VEHICLE_MODEL,
    with behavior RearEndingVehicleBehavior()

#################################
# REQUIREMENTS                  #
#################################

require lane.fasterLane is not None # Ensure a faster lane exists for Adv1
require (distance to intersection) > INIT_ROAD_CLEARANCE # Start away from intersections
require (distance from adversary1 to intersection) > INIT_ROAD_CLEARANCE
require (distance from adversary2 to intersection) > INIT_ROAD_CLEARANCE

# Initial lane placements
require ego.lane is lane
require adversary1.lane is adv1Lane
require adversary2.lane is lane

# Ensure initial separation
require (distance from ego to adversary1) > ego.length / 2 + adversary1.length / 2 + 5
require (distance from ego to adversary2) > ego.length / 2 + adversary2.length / 2 + 5

# Termination conditions
terminate when (distance to egoSpawnPt) > TERM_DIST # Scenario ends if Ego travels too far
terminate when (distance from adversary2 to ego) < COLLISION_DIST # Rear-end collision