"""
TITLE: waymo_070222_1-pdf
DESCRIPTION: On July 2, 2022 at 6:54 AM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a passenger car on the Embarcadero at Broadway. The Waymo AV was stopped in the dedicated left turn lane facing north on the Embarcadero, awaiting a green signal for a protected left turn onto Broadway. The signal for traffic proceeding north on the Embarcadero turned green, and traffic in adjacent lanes began moving. The left turn arrow signal for the dedicated turn lane occupied by the Waymo AV remained red. The passenger car that had been stopped directly behind the Waymo AV began moving forward. The front of the passenger car made contact with the rear of the Waymo AV, immediately after which the passenger car left the scene.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = "vehicle.toyota.prius"

param WAYMO_BRAKE = 1.0 # Waymo AV is stopped, awaiting a signal

param PASSENGER_SPEED = VerifaiRange(1, 5) # Passenger car begins moving forward
param PASSENGER_DIST_BEHIND = VerifaiRange(-3, -5) # Passenger car initial position behind Waymo AV

INITIAL_STOP_DIST = 10 # Waymo AV is stopped close to the intersection
CRASH_DIST = 1 # Distance for collision detection
TERM_DIST_MAX = 20 # Maximum distance travelled by ego or adversary
TERM_TIME_MAX = 5 # Maximum simulation time

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    # The Waymo AV is stopped, awaiting a green signal for a protected left turn.
    take SetBrakeAction(globalParameters.WAYMO_BRAKE)

behavior PassengerBehavior():
    # The passenger car begins moving forward after the signal change.
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Find an intersection, preferably a 4-way for typical left turns
intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Select an incoming lane to this intersection
incomingLane = Uniform(*intersection.incomingLanes)

# Find a left turn maneuver from this incoming lane
leftTurnManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, incomingLane.maneuvers))

# The Waymo AV is in the start lane of this left turn maneuver
egoInitLane = leftTurnManeuver.startLane

# Waymo AV spawn point: in the dedicated left turn lane, near the intersection
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Passenger car spawn point: directly behind the Waymo AV in the same lane
advSpawnPt = new OrientedPoint following roadDirection for globalParameters.PASSENGER_DIST_BEHIND from egoSpawnPt

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ensure the Waymo AV is positioned close to the intersection to wait for the turn
require (distance to intersection) < INITIAL_STOP_DIST
# Ensure the passenger car is initially in the same lane as the Waymo AV
require ego.lane is adversary.lane

# Terminate when the front of the passenger car makes contact with the rear of the Waymo AV
terminate when (distance to adversary) < CRASH_DIST
# Terminate if the Waymo AV moves significantly from its initial spot (e.g., if scenario fails to trigger)
terminate when (distance from ego to egoSpawnPt) > TERM_DIST_MAX
# Terminate if the passenger car moves significantly from its initial spot without collision
terminate when (distance from adversary to advSpawnPt) > TERM_DIST_MAX
# Terminate if the simulation runs for too long as a safeguard
terminate when Scenic.currentTime > TERM_TIME_MAX