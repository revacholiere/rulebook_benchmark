"""
TITLE: apple_09292023-pdf
DESCRIPTION: On September 29th, a test vehicle operating with the automated driving system engaged was traveling Southbound on Highway 101 in San Jose when a nearby white Jeep Cherokee ran over a piece of lumber, which was projected onto the test vehicle. No injuries were reported and law enforcement was not called to the scene. The test vehicle sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

EGO_MODEL = 'vehicle.lincoln.mkz_2017'
ADV_MODEL = 'vehicle.audi.a2' # Placeholder for a Jeep Cherokee
LUMBER_MODEL = 'misc.object.lumber' # Assuming this model exists. Use 'misc.object.cone' if not.

param EGO_SPEED = VerifaiRange(20, 25) # Highway speed for test vehicle
param ADV_SPEED = VerifaiRange(25, 30) # Slightly faster for adversary to interact with lumber first

# Initial positioning parameters
param EGO_INIT_POS_ALONG_LANE = VerifaiRange(20, 30) # How far ego starts along the selected lane
param ADV_DIST_AHEAD_OF_EGO = VerifaiRange(5, 10) # Adversary starts this distance ahead of ego
param LUMBER_LATERAL_OFFSET = VerifaiRange(2, 4) # Lumber initial offset from adversary's path, to the side
param LUMBER_LONGITUDINAL_OFFSET = VerifaiRange(0, 2) # Lumber initial offset from adversary, forward/backward

# Projection parameters for lumber
param ADV_TRIGGER_DIST = VerifaiRange(3, 5) # Distance for adversary to "trigger" lumber projection
PROJECTION_SPEED = 15 # Speed of lumber when projected onto ego's path
PROJECTION_DURATION = 0.3 # Duration of the projection movement (seconds)
LUMBER_EGO_TARGET_OFFSET = 5 # How far ahead of ego the lumber will be projected to in ego's lane

# Scenario termination and safety
SAFETY_DIST = 10 # Distance for ego to react to objects
CRASH_DIST = 2 # Minimum distance for an impact to be considered a crash
TERM_DIST = 150 # Ego travels this far before scenario terminates normally
TERM_TIME = 15 # Maximum simulation time in seconds

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when withinDistanceToAnyObjs(self, SAFETY_DIST):
        take SetBrakeAction(1.0) # Emergency brake to avoid collision
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate # Scenario terminates upon collision

behavior AdversaryBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

behavior LumberBehavior(target_ego_vehicle, target_adversary_vehicle):
    # Initially, the lumber is static
    take SetSpeedAction(0)
    # When the adversary vehicle is close enough, trigger the projection
    interrupt when (distance from self to target_adversary_vehicle) < globalParameters.ADV_TRIGGER_DIST:
        # Calculate a target point in ego's lane, slightly ahead of ego
        target_pt = new OrientedPoint at target_ego_vehicle ahead of by LUMBER_EGO_TARGET_OFFSET
        
        # Calculate the velocity components required to move the lumber to the target point
        # within the specified projection duration.
        vel_x = (target_pt.x - self.x) / PROJECTION_DURATION
        vel_y = (target_pt.y - self.y) / PROJECTION_DURATION
        
        # Apply the calculated velocity for the projection duration
        take SetVelocityAction(vel_x, vel_y) for PROJECTION_DURATION
        # After the projection movement, the lumber becomes static again
        take SetSpeedAction(0)
    
    # Terminate the scenario if the lumber makes contact with the ego vehicle
    interrupt when (distance from self to target_ego_vehicle) < CRASH_DIST:
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

# Select a long, multi-lane road to simulate a highway environment
road = Uniform(*filter(lambda r: len(r.lanes) > 1 and r.length > 200, network.roads))
# Pick a random lane on this road for the ego vehicle
egoLane = Uniform(*road.lanes)

# Ego vehicle spawn point, along the chosen lane
egoSpawnPt = new OrientedPoint in egoLane.centerline following roadDirection for globalParameters.EGO_INIT_POS_ALONG_LANE

# Adversary vehicle spawn point: ahead of ego.
# Place it in an adjacent lane (e.g., the slower lane) if available, otherwise in ego's lane.
advLane = egoLane.slowerLane if egoLane.slowerLane else egoLane
advSpawnPt = new OrientedPoint in advLane.centerline following roadDirection \
    for (globalParameters.EGO_INIT_POS_ALONG_LANE + globalParameters.ADV_DIST_AHEAD_OF_EGO)

# Lumber initial position: relative to the adversary, slightly to the side of its path
# and potentially a small offset longitudinally. This simulates it being near the path
# where the adversary will "run over" it.
lumberSpawnPt = new OrientedPoint at advSpawnPt \
    offset along (advSpawnPt.heading - 90 deg) by globalParameters.LUMBER_LATERAL_OFFSET \
    offset along advSpawnPt.heading by globalParameters.LUMBER_LONGITUDINAL_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint EGO_MODEL,
    with behavior EgoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint ADV_MODEL,
    with behavior AdversaryBehavior()

lumber = new ScenicObject at lumberSpawnPt,
    with blueprint LUMBER_MODEL,
    with behavior LumberBehavior(ego, adversary)

#################################
# REQUIREMENTS                  #
#################################

# Ensure ego and adversary are on the same general road segment
require ego.road is adversary.road
# Ensure the scenario starts with sufficient road ahead
require (distance to egoSpawnPt) < TERM_DIST 
# Terminate if the ego vehicle travels too far without an event
terminate when (distance to egoSpawnPt) > TERM_DIST
# Terminate if simulation time exceeds a limit
terminate when current_time > TERM_TIME