"""
TITLE: waymo-collision-report-september-5-2020-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (““Waymo AV”) was stopped at a stop sign intersection in manual mode at westbound Clement Street at 12th Avenue in San Francisco when it was rear-ended. The Waymo AV test driver was yielding to a pedestrian in the crosswalk when a passenger vehicle made contact with the Waymo AV’s rear bumper at approximately 6 MPH. The Waymo AV sustained minor damage to its rear bumper and hatch, and the passenger vehicle sustained minor damage to its front bumper. No injuries were reported.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius'
PEDESTRIAN_MODEL = 'vehicle.diamondback.century'

WAYMO_INIT_SPEED = 0
param PASSENGER_SPEED = VerifaiRange(2.5, 3.5) # Approximately 6 MPH (around 2.68 m/s)
param PASSENGER_DIST_BEHIND_WAYMO = VerifaiRange(-10, -15) # Distance behind Waymo AV, negative for 'behind'

param PED_X_OFFSET = VerifaiRange(2, 3) # Sideways offset from ego's path for pedestrian
param PED_Y_OFFSET_AHEAD_EGO = VerifaiRange(5, 10) # Forward offset from ego for pedestrian
PED_SPEED = 1.5 # Walking speed of pedestrian (m/s)
PED_CROSS_TIME = 3 # Time for pedestrian to move across the lane (seconds)

STOP_SIGN_PROXIMITY_DIST = 15 # Waymo is within this distance to a stop sign intersection
CRASH_DIST = 2 # Distance threshold for collision detection (e.g., front of adv to rear of ego)
TERM_DIST = 30 # Terminate if ego moves too far from its initial spawn point

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    # Waymo AV is stopped, yielding to a pedestrian.
    # It remains stopped until collision or scenario termination.
    take SetSpeedAction(WAYMO_INIT_SPEED)
    wait # Wait indefinitely, until an external condition terminates the scenario

behavior PassengerBehavior():
    # Passenger vehicle approaches Waymo AV and collides.
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)

behavior PedestrianBehavior():
    # Pedestrian crosses the road.
    # We assume the pedestrian is spawned with a heading to cross the lane.
    take SetSpeedAction(PED_SPEED) for PED_CROSS_TIME seconds
    terminate # Pedestrian finishes crossing after a short time

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.isStopSign, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.PASSENGER_DIST_BEHIND_WAYMO

pedSpawnPt = new OrientedPoint offset by (globalParameters.PED_X_OFFSET, globalParameters.PED_Y_OFFSET_AHEAD_EGO) from egoSpawnPt,
    with heading (egoSpawnPt.heading + 90 deg)

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior()

pedestrian = new Pedestrian at pedSpawnPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianBehavior()

require (distance to intersection.point) < STOP_SIGN_PROXIMITY_DIST
require adversary.lane is ego.lane and adversary is behind ego
require (distance from pedestrian to ego) < globalParameters.PED_Y_OFFSET_AHEAD_EGO * 1.5

terminate when (distance from adversary.front to ego.rear) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST