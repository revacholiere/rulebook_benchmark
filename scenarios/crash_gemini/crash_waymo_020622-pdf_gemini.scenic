"""
TITLE: waymo_020622-pdf
DESCRIPTION: On February 6, 2022 at 1:53 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a passenger vehicle on Pine Street at Fillmore Street. The Waymo AV was stopped in the right lane of a three lane, one-way street in manual mode while boarding a passenger. A passenger vehicle stopped behind the Waymo AV then attempted to go around the Waymo AV, attempting to merge with traffic in the center lane but colliding instead with a third passenger vehicle and also making contact with the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. The Waymo AV and the passenger vehicle that made contact with it sustained moderate damage. The third vehicle sustained minor damage. The Waymo AV passenger reported minor discomfort at the scene but advised they did not require medical attention.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = 'vehicle.toyota.prius'
PASSENGER_MODEL = 'vehicle.lincoln.mkz_2017'

WAYMO_SPEED = 0

param ADV1_SPEED = VerifaiRange(3, 5)
param ADV2_SPEED = VerifaiRange(7, 9)

param ADV1_INIT_DIST_BEHIND_WAYMO = VerifaiRange(5, 10)
param ADV2_RELATIVE_DIST_FROM_WAYMO = VerifaiRange(-2, 2)

CRASH_DIST = 2
TERM_TIME = 15

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    take SetSpeedAction(WAYMO_SPEED)

behavior Adv1Behavior(targetLaneToMerge):
    try:
        do LaneChangeBehavior(laneSectionToSwitch=targetLaneToMerge.laneSection, target_speed=globalParameters.ADV1_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.ADV1_SPEED, laneToFollow=targetLaneToMerge)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior Adv2Behavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV2_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

waymoInitLane = Uniform(*filter(lambda l: l.fasterLane is not None and l.fasterLane.fasterLane is not None, network.lanes))
centerLane = waymoInitLane.fasterLane

waymoSpawnPt = new OrientedPoint in waymoInitLane.centerline

adv1SpawnPt = new OrientedPoint behind waymo for globalParameters.ADV1_INIT_DIST_BEHIND_WAYMO

adv2SpawnPt = new OrientedPoint in centerLane.centerline following roadDirection from waymo for globalParameters.ADV2_RELATIVE_DIST_FROM_WAYMO

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior()

adversary1 = new Car at adv1SpawnPt,
    with blueprint PASSENGER_MODEL,
    with behavior Adv1Behavior(centerLane)

adversary2 = new Car at adv2SpawnPt,
    with blueprint PASSENGER_MODEL,
    with behavior Adv2Behavior()

#################################
# REQUIREMENTS                  #
#################################

require (distance from adversary1 to adversary2) > CRASH_DIST
require (distance from adversary1 to ego) > CRASH_DIST
require (distance from ego to adversary2) > CRASH_DIST

terminate when (distance from adversary1 to adversary2) < CRASH_DIST
terminate when (distance from adversary1 to ego) < CRASH_DIST
terminate when currentSimulation.currentTime > TERM_TIME