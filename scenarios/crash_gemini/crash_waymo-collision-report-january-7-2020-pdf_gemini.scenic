"""
TITLE: waymo-collision-report-january-7-2020-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was stopped in autonomous mode in the slip lane from westbound Nita Avenue to northbound San Antonio Road in Palo Alto when it was rear-ended. The Waymo AV was yielding to approaching traffic when a commercial box truck made contact with the Waymo AV’s rear bumper at approximately 3 MPH. The Waymo AV sustained minor damage to its rear bumper, and the commercial box truck left without exchanging information. Waymo contacted the Palo Alto Police Department and a police report was filed. No injuries were reported at the scene.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_AV_MODEL = "vehicle.toyota.prius"
TRUCK_MODEL = "vehicle.carlamotors.box_truck"

WAYMO_AV_INIT_SPEED = 0
param TRUCK_APPROACH_SPEED = VerifaiRange(2.5, 3.5) # Approximately 3 MPH
param TRUCK_DIST_BEHIND = VerifaiRange(5, 10) # Initial distance the truck is behind the Waymo AV

CRASH_DIST = 5 # Distance to consider for collision termination
INIT_DIST = 20 # Max initial distance to intersection for vehicles
TERM_DIST = 40 # Max distance from ego's spawn point for scenario termination

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior():
    # The Waymo AV is stopped, yielding to approaching traffic
    do FollowLaneBehavior(target_speed=WAYMO_AV_INIT_SPEED)

behavior TruckBehavior():
    # The commercial box truck approaches at the specified speed
    do FollowLaneBehavior(target_speed=globalParameters.TRUCK_APPROACH_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Find a 4-way intersection in the network
intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Select an incoming lane to the intersection that has a right-turn maneuver,
# simulating the context of a slip lane.
egoInitLane = Uniform(*filter(lambda l:
    l.isIncomingToIntersection and any(m.type is ManeuverType.RIGHT_TURN for m in l.maneuvers),
    network.lanes
))

# Waymo AV is positioned in the center of this selected lane
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary (truck) is positioned behind the Waymo AV on the same lane
adversarySpawnPt = new OrientedPoint behind egoSpawnPt by globalParameters.TRUCK_DIST_BEHIND

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_AV_MODEL,
    with behavior WaymoAVBehavior()

adversary = new Car at adversarySpawnPt,
    with blueprint TRUCK_MODEL,
    with behavior TruckBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ensure both vehicles are initially close to the intersection
require (distance to intersection) < INIT_DIST
require (distance from adversary to intersection) < INIT_DIST

# Ensure the truck is on the same lane as the Waymo AV
require ego.lane is adversary.lane

# Terminate when the vehicles collide (their bounding boxes overlap)
terminate when (distance to adversary) < (ego.length + adversary.length) / 2
# Terminate if ego moves too far from its initial position (timeout/escape)
terminate when (distance to egoSpawnPt) > TERM_DIST