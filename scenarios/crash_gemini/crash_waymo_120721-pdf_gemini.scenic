"""
TITLE: waymo_120721-pdf
DESCRIPTION: On December 7, 2021 at 10:47 AM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, CA was in a collision involving an SUV at Oak Street at Stanyan Street. While in autonomous mode, the Waymo AV came to a stop at a stop sign on Oak Street. While the ADV was stopped, waiting for a pedestrian to cross and for traffic on Stanyan Street to clear, an SUV approached the Waymo AV from behind and made contact with the rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode, and a test driver was present (in the driver’s seating position). The Waymo AV sustained minor damage to the rear bumper.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = 'vehicle.lincoln.mkz_2017'
SUV_MODEL = 'vehicle.mercedes.sprinter'
PEDESTRIAN_MODEL = 'vehicle.bh.crossbike'

param WAYMO_INITIAL_SPEED = VerifaiRange(5, 7)
param SUV_SPEED = VerifaiRange(7, 10)
param ADV_INIT_DIST = VerifaiRange(10, 20)

param STOPPING_DIST_FROM_INTERSECTION = VerifaiRange(5, 10)
param STOP_WAIT_TIME_AFTER_PEDESTRIAN = VerifaiRange(1, 3)

CRASH_DIST = 3
TERM_DIST = 50

PEDESTRIAN_SPEED = 2
param PEDESTRIAN_DIST_AHEAD = VerifaiRange(10, 15)
PEDESTRIAN_SIDE_OFFSET = 5
PEDESTRIAN_CROSSING_LENGTH = 10

PEDESTRIAN_CLEAR_DIST = 5

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(intersection, pedestrian):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_INITIAL_SPEED)
    interrupt when distance to intersection < globalParameters.STOPPING_DIST_FROM_INTERSECTION:
        take SetSpeedAction(0)
        wait until (distance from pedestrian to self) > globalParameters.PEDESTRIAN_CLEAR_DIST
        wait for globalParameters.STOP_WAIT_TIME_AFTER_PEDESTRIAN seconds
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_INITIAL_SPEED)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior SUVBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED)

behavior PedestrianBehavior(crossingLength):
    try:
        take SetVelocityAction(0, PEDESTRIAN_SPEED)
    interrupt when (distance to self.initialPosition) > crossingLength:
        take SetSpeedAction(0)
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

adversarySpawnPt = new OrientedPoint behind ego by globalParameters.ADV_INIT_DIST

pedestrianSpawnPt = new OrientedPoint at egoSpawnPt \
    offset along roadDirection for globalParameters.PEDESTRIAN_DIST_AHEAD \
    right of ego for PEDESTRIAN_SIDE_OFFSET \
    with heading (ego.heading + 90 deg)

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior(intersection, pedestrian)

adversary = new Car at adversarySpawnPt,
    with blueprint SUV_MODEL,
    with behavior SUVBehavior()

pedestrian = new Bicycle at pedestrianSpawnPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianBehavior(PEDESTRIAN_CROSSING_LENGTH)

#################################
# REQUIREMENTS                  #
#################################

require (distance to intersection) > globalParameters.STOPPING_DIST_FROM_INTERSECTION + 5
require (distance from adversary to intersection) > globalParameters.STOPPING_DIST_FROM_INTERSECTION + 15
require adversary.lane is ego.lane
require (distance from pedestrian to ego) < (globalParameters.PEDESTRIAN_DIST_AHEAD + PEDESTRIAN_SIDE_OFFSET + 5)
require (distance from pedestrian to ego) > (globalParameters.PEDESTRIAN_DIST_AHEAD - PEDESTRIAN_SIDE_OFFSET - 5)

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance to adversary) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST