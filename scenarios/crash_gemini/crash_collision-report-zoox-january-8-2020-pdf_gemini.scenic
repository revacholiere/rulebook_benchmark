"""
TITLE: collision-report-zoox-january-8-2020-pdf
DESCRIPTION: A Zoox vehicle was parked with hazard lights blinking while in manual mode on Green St. facing east towards Varennes St. A car reversed from a horizontal parking spot of the oncoming lane and made contact with the rear left corner of the Zoox Vehicle, damaging the sensors. Police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOOX_MODEL = 'vehicle.lincoln.mkz_2017'
CAR_MODEL = 'vehicle.audi.a2'

ZOOX_SPEED = 0 # Zoox vehicle is parked

param CAR_REVERSE_SPEED = VerifaiRange(-1.5, -2.5) # Speed for reversing (negative for backward)
param CAR_INIT_OFFSET_LATERAL = VerifaiRange(2.0, 3.5) # Lateral offset from ego (to the right, for a collision with ego's rear-left)
param CAR_INIT_OFFSET_LONGITUDINAL = VerifaiRange(2.0, 3.5) # Longitudinal offset from ego (behind ego)

COLLISION_DIST = 1.0 # Distance to consider as contact
TERM_TIMEOUT = 15 # Max simulation time in seconds

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior():
    take SetSpeedAction(ZOOX_SPEED)

behavior CarReverseBehavior():
    try:
        take SetSpeedAction(globalParameters.CAR_REVERSE_SPEED)
    interrupt when (distance to ego) < COLLISION_DIST:
        terminate
    for TERM_TIMEOUT seconds

#################################
# SPATIAL RELATIONS             #
#################################

egoInitLane = Uniform(*network.lanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# The reversing car is positioned behind and to the right of the Zoox from Zoox's perspective.
# Its initial heading is set to be perpendicular to Zoox's forward direction, simulating
# a "horizontal parking spot". When it reverses (moves opposite to its heading),
# it will move towards the Zoox's rear-left corner.
carSpawnPt = new OrientedPoint \
    right of egoSpawnPt by globalParameters.CAR_INIT_OFFSET_LATERAL, \
    behind egoSpawnPt by globalParameters.CAR_INIT_OFFSET_LONGITUDINAL, \
    with heading egoSpawnPt.heading - 90deg # Sets heading perpendicular to ego's direction.
                                            # If ego is facing East (0 deg), car's initial heading is South (-90 deg).
                                            # Reversing (negative speed) will make it move North (90 deg),
                                            # thus allowing it to collide with ego's rear-left.

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint ZOOX_MODEL,
    with behavior ZooxBehavior()

adversary = new Car at carSpawnPt,
    with blueprint CAR_MODEL,
    with behavior CarReverseBehavior()

#################################
# REQUIREMENTS                  #
#################################

require egoInitLane.oppositeLane is not None # Ensure a two-way road to conceptualize "oncoming lane"
require not (distance from adversary to egoSpawnPt) < (ego.length + adversary.length) / 2 # Prevent immediate overlap at start
terminate when current simulation time > TERM_TIMEOUT + 5 # Add a small buffer to the behavior timeout