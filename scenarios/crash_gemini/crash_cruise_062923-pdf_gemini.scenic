"""
TITLE: cruise_062923-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV”), operating in supervised autonomous mode, was traveling southbound on Selby Street between Palou Avenue and Oakdale Avenue. The Cruise AV came to a stop behind a semi-trailer truck that was slowly reversing diagonally onto Selby Street from the intersection with Palou Avenue. As the semi-trailer truck began encroaching into the Cruise AV’s lane of travel, the Cruise AV operator disengaged from autonomous into manual mode and began reversing the Cruise AV, causing the Cruise AV to back into a different semi-trailer truck parked behind the Cruise AV. This caused damage to the Cruise AV’s rear passenger side wheel molding. The Cruise AV operator left information for the other party and there were no reported injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.lincoln.mkz_2017' # Using a standard car model for Cruise AV
TRUCK_MODEL = 'vehicle.cargroup.carlamotors'

CRUISE_INITIAL_SPEED = 5 # Speed for Cruise AV to approach the reversing truck
CRUISE_STOP_SPEED = 0
param CRUISE_REVERSE_SPEED = VerifaiRange(-2, -4) # Negative speed for reversing

param REVERSING_TRUCK_SPEED = VerifaiRange(-1, -2) # Negative speed for reversing
PARKED_TRUCK_SPEED = 0 # Parked truck remains stationary

param DIST_TO_REVERSING_TRUCK_TO_STOP = VerifaiRange(5, 8) # Distance at which Cruise AV stops
param ENCROACHMENT_DISTANCE = VerifaiRange(2, 4) # Distance at which reversing truck is considered encroaching
param DIST_BEHIND_CRUISE_AV_TO_PARKED_TRUCK = VerifaiRange(5, 8) # Initial distance of parked truck behind Cruise AV

CRASH_DIST = 1.0 # Distance for a collision to be registered
TERM_DIST_TRAVELLED = 20 # Max distance Cruise AV can travel backward/forward before terminating
TERM_TIMEOUT = 40 # Max scenario time to prevent infinite loops

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior(reversingTruck, parkedTruck):
    # Phase 1: Approach the reversing truck and stop
    try:
        do FollowLaneBehavior(target_speed=CRUISE_INITIAL_SPEED) \
            until (distance to reversingTruck) < globalParameters.DIST_TO_REVERSING_TRUCK_TO_STOP

        # Once close enough, stop the Cruise AV
        take SetSpeedAction(CRUISE_STOP_SPEED)
        # Wait for a condition to trigger reversal or for a long time
        wait until currentScenario.currentTime > TERM_TIMEOUT

    # Interrupt when the reversing truck encroaches
    interrupt when (distance to reversingTruck) < globalParameters.ENCROACHMENT_DISTANCE:
        # Operator disengages and begins reversing the Cruise AV
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_REVERSE_SPEED)

    # Interrupt when backing into the parked truck (collision)
    interrupt when (distance to parkedTruck) < CRASH_DIST:
        terminate

behavior ReversingTruckBehavior(trajectory):
    # The semi-trailer truck slowly reverses along its trajectory
    do FollowTrajectoryBehavior(target_speed=globalParameters.REVERSING_TRUCK_SPEED, trajectory=trajectory)

behavior ParkedTruckBehavior():
    # The parked semi-trailer truck remains stationary
    take SetSpeedAction(PARKED_TRUCK_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Find an intersection to simulate the truck reversing "from the intersection"
intersection = Uniform(*filter(lambda i: i.is3Way or i.is4Way, network.intersections))

# Cruise AV's initial lane, typically a straight incoming lane to an intersection
cruiseAVLane = Uniform(*filter(lambda l: l.isStraight, intersection.incomingLanes))
cruiseAVSpawnPt = new OrientedPoint in cruiseAVLane.centerline

# Reversing semi-trailer truck's initial position and trajectory.
# It starts in a different incoming lane at the intersection and will reverse towards the Cruise AV's lane.
reversingTruckInitialLane = Uniform(*filter(lambda l: l != cruiseAVLane and l.isStraight, intersection.incomingLanes))
# Define a trajectory for the reversing truck from its initial lane to the Cruise AV's lane
reversingTruckTrajectory = [reversingTruckInitialLane, cruiseAVLane]
reversingTruckSpawnPt = new OrientedPoint in reversingTruckInitialLane.centerline

# Parked semi-trailer truck's initial position, behind the Cruise AV
parkedTruckSpawnPt = new OrientedPoint behind cruiseAVSpawnPt by globalParameters.DIST_BEHIND_CRUISE_AV_TO_PARKED_TRUCK

#################################
# SCENARIO SPECIFICATION        #
#################################

# Instance for the reversing semi-trailer truck
reversingTruck = new Car at reversingTruckSpawnPt,
    with blueprint TRUCK_MODEL,
    with behavior ReversingTruckBehavior(reversingTruckTrajectory)

# Instance for the parked semi-trailer truck
parkedTruck = new Car at parkedTruckSpawnPt,
    with blueprint TRUCK_MODEL,
    with behavior ParkedTruckBehavior()

# Instance for the Cruise AV
cruiseAV = new Car at cruiseAVSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior CruiseAVBehavior(reversingTruck, parkedTruck)

#################################
# REQUIREMENTS                  #
#################################

# Ensure initial spacing between vehicles
require (distance from cruiseAV to reversingTruck) > globalParameters.DIST_TO_REVERSING_TRUCK_TO_STOP
require (distance from cruiseAV to parkedTruck) > globalParameters.DIST_BEHIND_CRUISE_AV_TO_PARKED_TRUCK

#################################
# TERMINATION CONDITIONS        #
#################################

# Terminate when Cruise AV backs into the parked truck
terminate when (distance from cruiseAV to parkedTruck) < CRASH_DIST
# Terminate if the Cruise AV travels too far (forward or backward)
terminate when (distance from cruiseAV to cruiseAVSpawnPt) > TERM_DIST_TRAVELLED
# Terminate scenario after a certain time to prevent indefinite execution
terminate when currentScenario.currentTime > TERM_TIMEOUT