"""
TITLE: waymo_102721-pdf
DESCRIPTION: On October 27, 2021 at 3:54 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco was in a collision involving a passenger vehicle at Flower Street and Bayshore Avenue. While in manual mode, the operator of the Waymo AV was at a complete stop while yielding to traffic approaching from the left, waiting to make a left turn onto Bayshore Avenue from northwest Flower Street. A passenger vehicle approached from behind and made contact with the rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. Both vehicles sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius'

WAYMO_SPEED = 0 # Waymo AV is at a complete stop
param PASSENGER_SPEED = VerifaiRange(3, 4) # Approaching speed (approx 8 MPH = 3.57 m/s)
param PASSENGER_INIT_DIST = VerifaiRange(5, 10) # Passenger vehicle is initially behind Waymo AV

INIT_DIST_TO_INTERSECTION = [5, 10] # Waymo AV is waiting at the intersection
CRASH_DIST = 1 # Distance for collision detection
TERM_DIST = 50 # General termination distance if ego moves significantly

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    take SetSpeedAction(WAYMO_SPEED) # Waymo AV remains at a complete stop

behavior PassengerBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Waymo AV is waiting to make a left turn
waymoInitLane = Uniform(*intersection.incomingLanes)
waymoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, waymoInitLane.maneuvers))
waymoTrajectory = [waymoInitLane, waymoManeuver.connectingLane, waymoManeuver.endLane]

waymoSpawnPt = new OrientedPoint in waymoInitLane.centerline

# Passenger vehicle approaches from behind Waymo AV on the same lane
advSpawnPt = new OrientedPoint behind waymoSpawnPt by globalParameters.PASSENGER_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior()

require INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= INIT_DIST_TO_INTERSECTION[1]
require ego.lane is adversary.lane # Passenger vehicle is in the same lane as Waymo AV

terminate when (distance to adversary) < CRASH_DIST
terminate when (distance to waymoSpawnPt) > TERM_DIST