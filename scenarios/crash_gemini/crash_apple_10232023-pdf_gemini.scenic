"""
TITLE: apple_10232023-pdf
DESCRIPTION: On October 23rd, a test vehicle operating in manual driving mode was stopped at a red light in the righthand lane of Lawrence Expressway at the intersection with Kifer Road in Santa Clara. A Lexus RX300 attempted to pass through traffic in the adjacent bike lane, and made contact with the test vehicle’s side mirror. No injuries were reported and law enforcement was not called to the scene. The test vehicle sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

EGO_MODEL = 'vehicle.lincoln.mkz_2017' # Represents the test vehicle
ADVERSARY_MODEL = 'vehicle.lexus.rx300' # Represents the Lexus RX300 (using a generic model if RX300 is not available)

param EGO_STOP_SPEED = VerifaiRange(0, 0.1) # Ego is stopped or moving very slowly
param ADV_SPEED = VerifaiRange(7, 12) # Adversary attempting to pass

param ADV_INIT_BEHIND_DIST = VerifaiRange(5, 15) # Adversary's initial distance behind ego
param ADJACENT_OFFSET = VerifaiRange(-3, -1) # Longitudinal offset from ego (along adversary's heading) at which adversary starts steering. Negative means adversary's origin is behind ego's origin.
param ADVERSARY_STEER_LEFT = VerifaiRange(-0.5, -0.2) # Steering angle for adversary to drift left (negative for left in common Scenic setups)
param STEER_DURATION = VerifaiRange(1.0, 2.0) # Duration for which the adversary applies the steer action
COLLISION_DIST = 1.0 # Distance for collision detection
TERM_DIST = 50 # General termination distance if vehicles move too far from their spawn points
INIT_DIST_TO_INTERSECTION = VerifaiRange(5, 15) # Initial distance for ego and adversary from the intersection center

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoStoppedBehavior():
    take SetSpeedAction(globalParameters.EGO_STOP_SPEED) # The test vehicle was stopped

behavior AdversaryPassingBehavior(target_speed, ego_vehicle):
    # Drive forward in its lane until it is roughly alongside the ego vehicle.
    # The condition `self.longitudinalOffsetTo(ego_vehicle.position) >= globalParameters.ADJACENT_OFFSET`
    # means the adversary's longitudinal position relative to ego has reached a certain point (e.g., its front is aligned with ego's side).
    do FollowLaneBehavior(target_speed=target_speed) \
        until self.longitudinalOffsetTo(ego_vehicle.position) >= globalParameters.ADJACENT_OFFSET

    # Once sufficiently adjacent, apply a left steer and maintain speed to make contact.
    take SetSteerAction(globalParameters.ADVERSARY_STEER_LEFT)
    take SetSpeedAction(target_speed)
    wait globalParameters.STEER_DURATION seconds

    # After the steer duration, continue following its lane if the scenario hasn't terminated due to collision.
    do FollowLaneBehavior(target_speed=target_speed)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Ego is in a right-hand lane at the intersection, which must have a 'slowerLane' to its right
# for the adversary (representing the bike lane).
egoInitLaneCandidates = filter(lambda lane: lane.slowerLane is not None, intersection.incomingLanes)
egoInitLane = Uniform(*egoInitLaneCandidates)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary is in the adjacent bike lane, which is modeled as the 'slowerLane' relative to ego's lane.
advInitLane = egoInitLane.slowerLane
# Adversary starts behind ego, in its own lane, to "attempt to pass".
advSpawnPt = new OrientedPoint in advInitLane.centerline behind egoSpawnPt by globalParameters.ADV_INIT_BEHIND_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint EGO_MODEL,
    with behavior EgoStoppedBehavior()

adversary = new Car at advSpawnPt,
    with blueprint ADVERSARY_MODEL,
    with behavior AdversaryPassingBehavior(globalParameters.ADV_SPEED, ego)

# Requirements to ensure the vehicles are positioned near the intersection initially
require globalParameters.INIT_DIST_TO_INTERSECTION.lower_bound <= (distance to intersection.center) <= globalParameters.INIT_DIST_TO_INTERSECTION.upper_bound
require globalParameters.INIT_DIST_TO_INTERSECTION.lower_bound <= (distance from adversary to intersection.center) <= globalParameters.INIT_DIST_TO_INTERSECTION.upper_bound

# Ensure the adversary starts sufficiently behind the point where it would begin steering,
# so the 'until' condition in its behavior has room to execute.
require adversary.longitudinalOffsetTo(ego.position) < globalParameters.ADJACENT_OFFSET

# Terminate the scenario upon collision
terminate when (distance to adversary) < COLLISION_DIST
# Terminate if either vehicle moves too far from its initial position (to prevent infinitely long scenarios)
terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when (distance from adversary to advSpawnPt) > TERM_DIST