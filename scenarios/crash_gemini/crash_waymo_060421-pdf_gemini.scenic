"""
TITLE: waymo_060421-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was traveling in manual mode southbound on Jones Street at Ellis Street in San Francisco when a cyclist fell while passing between the Waymo AV and another vehicle. The Waymo AV test driver was traveling approximately 15 MPH and then gradually slowed and came to a stop for a passenger vehicle in its lane making a right turn onto Ellis Street. A cyclist following the Waymo AV at approximately 19 MPH then attempted to pass the Waymo AV on the left side and travel between the Waymo AV’s driver’s side and a faster-moving passenger vehicle in the left adjacent lane. As the cyclist attempted to overtake the Waymo AV and was in turn being overtaken by the adjacent passenger vehicle, the cyclist fell between the two vehicles. As the bicycle was falling, the bicycle’s front tire appears to have made contact with the rear driver’s side wheel of the Waymo AV, and the cyclist appears to have made contact with the side of the other passenger vehicle in the left adjacent lane. The Waymo AV sustained no damage. The passenger vehicle did not stop and left the scene. The cyclist was transported from the scene and reportedly treated for potential head injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = 'vehicle.toyota.prius'
BICYCLE_MODEL = 'vehicle.bh.crossbike'
PASSENGER_MODEL = 'vehicle.lincoln.mkz_2017'

WAYMO_SPEED_INIT = 6.7  # Approximately 15 MPH
param WAYMO_BRAKE = VerifaiRange(0.5, 1.0)

CYCLIST_SPEED = 8.5  # Approximately 19 MPH
param PASSENGER_TURN_SPEED = VerifaiRange(2, 4) # Passenger vehicle slowing for turn
param PASSENGER_ADJ_SPEED = VerifaiRange(9, 12) # Faster-moving passenger vehicle

param WAYMO_APPROACH_DIST = VerifaiRange(20, 30) # Waymo's initial distance from the intersection
param PASSENGER_TURN_AHEAD_DIST = VerifaiRange(5, 10) # Turning vehicle initially ahead of Waymo
param CYCLIST_BEHIND_DIST = VerifaiRange(5, 10) # Cyclist initially behind Waymo
param ADJ_PASSENGER_OFFSET_FROM_CYCLIST = VerifaiRange(-5, 5) # Initial position of adjacent passenger relative to cyclist

param SAFETY_DIST_WAYMO_STOP = VerifaiRange(8, 12) # Distance at which Waymo starts braking
OVERTAKE_TRIGGER_DIST = 5 # Cyclist attempts to pass when this close to Waymo
FALL_CRASH_DIST = 1.5 # Distance threshold for contact leading to fall
TERM_DIST = 100 # Scenario termination if agents drive too far from initial spawn

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior():
    try:
        do FollowLaneBehavior(target_speed=WAYMO_SPEED_INIT)
    interrupt when withinDistanceToObjsInLane(self, globalParameters.SAFETY_DIST_WAYMO_STOP):
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
        take SetSpeedAction(0)
        do FollowLaneBehavior(target_speed=0)

behavior TurningPassengerBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.PASSENGER_TURN_SPEED, trajectory=trajectory)

behavior CyclistBehavior(waymoAV):
    try:
        do FollowLaneBehavior(target_speed=CYCLIST_SPEED)
    interrupt when distance to waymoAV < OVERTAKE_TRIGGER_DIST:
        fasterLaneSec = self.laneSection.fasterLane
        do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=CYCLIST_SPEED)
        do FollowLaneBehavior(target_speed=CYCLIST_SPEED, laneToFollow=fasterLaneSec.lane)

behavior AdjacentPassengerBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_ADJ_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

waymoInitLane = Uniform(*intersection.incomingLanes)
waymoSpawnPt = new OrientedPoint in waymoInitLane.centerline

# Turning passenger vehicle is in Waymo's lane, making a right turn
turnManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, waymoInitLane.maneuvers))
turnTrajectory = [waymoInitLane, turnManeuver.connectingLane, turnManeuver.endLane]
turningPassengerSpawnPt = new OrientedPoint in waymoInitLane.centerline \
                          ahead of waymoSpawnPt by globalParameters.PASSENGER_TURN_AHEAD_DIST

# Cyclist is behind the Waymo AV in the same lane
cyclistSpawnPt = new OrientedPoint in waymoInitLane.centerline \
                 behind waymoSpawnPt by globalParameters.CYCLIST_BEHIND_DIST

# Adjacent passenger vehicle is in the lane to the left of Waymo/Cyclist
adjPassengerLane = waymoInitLane.fasterLane
adjPassengerSpawnPt = new OrientedPoint in adjPassengerLane.centerline \
                      ahead of cyclistSpawnPt by globalParameters.ADJ_PASSENGER_OFFSET_FROM_CYCLIST

#################################
# SCENARIO SPECIFICATION        #
#################################

waymoAV = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoAVBehavior()

turningPassenger = new Car at turningPassengerSpawnPt,
    with blueprint PASSENGER_MODEL,
    with behavior TurningPassengerBehavior(turnTrajectory)

cyclist = new Bicycle at cyclistSpawnPt,
    with blueprint BICYCLE_MODEL,
    with behavior CyclistBehavior(waymoAV)

adjacentPassenger = new Car at adjPassengerSpawnPt,
    with blueprint PASSENGER_MODEL,
    with behavior AdjacentPassengerBehavior()

#################################
# REQUIREMENTS                  #
#################################

require (distance to intersection) < globalParameters.WAYMO_APPROACH_DIST
require (distance from turningPassenger to intersection) < globalParameters.WAYMO_APPROACH_DIST
require waymoInitLane.fasterLane is not None
require adjacentPassenger.lane is waymoInitLane.fasterLane
require (distance from cyclist to waymoAV) == globalParameters.CYCLIST_BEHIND_DIST
require (distance from adjacentPassenger to cyclist) < 20

terminate when (distance from cyclist to waymoAV) < FALL_CRASH_DIST
terminate when (distance from cyclist to adjacentPassenger) < FALL_CRASH_DIST
terminate when (distance to waymoSpawnPt) > TERM_DIST