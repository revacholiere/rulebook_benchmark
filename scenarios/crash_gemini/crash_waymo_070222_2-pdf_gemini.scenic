"""
TITLE: waymo_070222_2-pdf
DESCRIPTION: On July 2, 2022 at 11:23 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a passenger car on Bayshore Boulevard at Jerrold Avenue. The Waymo AV was traveling north on Bayshore Boulevard in the rightmost lane when a passenger car approached the Waymo AV from behind on the left. Just after passing the Waymo AV, the passenger car veered across the path of the Waymo AV into the entrance of a gas station on the right hand side of the roadway. The right rear corner of the passenger vehicle made contact with the front left corner of the Waymo AV, immediately after which the passenger car left the scene. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius'

param EGO_SPEED = VerifaiRange(5, 7)
param ADV_SPEED = VerifaiRange(8, 12)
param ADV_INIT_OFFSET = VerifaiRange(15, 25) # Distance behind ego for adversary
param PASS_AHEAD_DIST = VerifaiRange(5, 10)  # Distance ahead of ego when adversary starts veering
param VEER_RIGHT_STEER_ANGLE = VerifaiRange(0.8, 1.0) # Aggressive steer action for veering

CRASH_DIST = 3 # Distance for collision detection
TERM_DIST = 100 # Scenario termination distance

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)

behavior AdversaryBehavior(egoVehicle):
    # Phase 1: Approach and pass ego in the left lane
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED) until (distance from self to egoVehicle) > globalParameters.PASS_AHEAD_DIST

    # Phase 2: Veer across path (lane change right, then turn right off-road)
    # First, change lane to the right (into ego's lane)
    do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.slowerLane, target_speed=globalParameters.ADV_SPEED) until self.lane is egoVehicle.lane or (distance to egoVehicle) < CRASH_DIST

    # Now in ego's lane (or very close), make a sharp right turn to simulate exiting into gas station.
    # This action should lead to collision or adversary driving off.
    try:
        take SetSteerAction(globalParameters.VEER_RIGHT_STEER_ANGLE)
        take SetSpeedAction(globalParameters.ADV_SPEED * 0.7) # Reduce speed slightly for the turn
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate # Collision, terminate
    interrupt when (distance from self to egoVehicle) > globalParameters.PASS_AHEAD_DIST + 15: # Adversary has driven further away after collision or missing
        terminate # Adversary leaves the scene

#################################
# SPATIAL RELATIONS             #
#################################

# Select a road
someRoad = Uniform(*network.roads)

# Find the rightmost lane on this road for the ego vehicle
egoInitLane = someRoad.lanes[0]
while egoInitLane.slowerLane is not None:
    egoInitLane = egoInitLane.slowerLane

egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary starts in the lane immediately to the left of ego's lane
advInitLane = egoInitLane.fasterLane
advSpawnPt = new OrientedPoint in advInitLane.centerline behind ego by globalParameters.ADV_INIT_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior(ego)

require ego.lane.slowerLane is None # Ego is in the rightmost lane
require adversary.lane is ego.lane.fasterLane # Adversary starts in the lane to the left of ego
require ego.lane.fasterLane is not None # Ensure there is a lane to the left for the adversary

# Ensure scenario happens on a relatively straight road segment, not right at an intersection
require (distance to intersection) > 50
require (distance from adversary to intersection) > 50

# Termination conditions
terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when (distance from adversary to egoSpawnPt) > TERM_DIST
terminate when (distance to adversary) < CRASH_DIST # Terminate on collision for scenario analysis