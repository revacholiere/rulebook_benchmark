"""
TITLE: zoox_112822-pdf
DESCRIPTION: A Zoox vehicle in autonomy was fully stopped with brake lights illuminated in the left turn lane at a red traffic light waiting to complete a left hand turn from Harrison St. onto 11th St in San Francisco, Ca. As the light turned green, the Zoox vehicle appropriately yielded to oncoming traffic when Vehicle 2 attempted to make a lane change to the right and struck the rear of the Zoox vehicle. The Zoox vehicle incurred minor damage to the rear sensors and bumper. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param ZOOX_TARGET_SPEED = VerifaiRange(2, 4)
param ZOOX_BRAKE = VerifaiRange(0.5, 1.0)

param VEHICLE2_SPEED = VerifaiRange(7, 10)
param VEHICLE2_INIT_DIST = VerifaiRange(5, 10)
param VEHICLE2_LANE_CHANGE_START_TRIGGER_DIST = VerifaiRange(5, 8)

param SAFETY_DIST_ZOOX = VerifaiRange(2, 4)
CRASH_DIST = 1

INIT_DIST_TO_INTERSECTION = [5, 15]
TERM_DIST = 50
LANE_CHANGE_DURATION = 3

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior(trajectory):
    take SetSpeedAction(0)
    wait 1 second
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.ZOOX_TARGET_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST_ZOOX):
        take SetBrakeAction(globalParameters.ZOOX_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior Vehicle2Behavior():
    do FollowLaneBehavior(target_speed=globalParameters.VEHICLE2_SPEED) until (distance to ego) < globalParameters.VEHICLE2_LANE_CHANGE_START_TRIGGER_DIST
    do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.slowerLane, target_speed=globalParameters.VEHICLE2_SPEED)
    do FollowLaneBehavior(target_speed=globalParameters.VEHICLE2_SPEED) for LANE_CHANGE_DURATION seconds

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*filter(lambda l: l.isTurningLeft and l.hasManeuver(ManeuverType.LEFT_TURN), intersection.incomingLanes))
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advInitLane = egoInitLane.fasterLane
advSpawnPt = new OrientedPoint in advInitLane.centerline behind ego for globalParameters.VEHICLE2_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior ZooxBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior Vehicle2Behavior()

require INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= INIT_DIST_TO_INTERSECTION[1]
require advInitLane is not None
require adversary.laneSection._slowerLane is not None
require ego.lane is not adversary.lane

terminate when (distance from adversary to ego) < CRASH_DIST