"""
TITLE: zoox_022323-pdf
DESCRIPTION: A Zoox vehicle in manual mode was proceeding southbound in the turn lane on Sixth Street with a green light, yielding to a pedestrian before completing a right turn onto eastbound Harrison Street, in San Francisco, CA with turn signals illuminated. A large truck in the left adjacent lane abruptly turned right and cut in front of the Zoox vehicle making contact with the left front sensor. There were no injuries, the other vehicle did not stop to exchange information, and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017' # Generic car for Zoox
TRUCK_MODEL = 'vehicle.volkswagen.t2' # Example truck model
PEDESTRIAN_MODEL = 'walker.scenario_pedestrian.0000' # Common pedestrian blueprint in some simulators

param EGO_SPEED = VerifaiRange(2, 4) # Slow for turning/yielding
param EGO_BRAKE = VerifaiRange(0.7, 1.0)

param ADV_SPEED = VerifaiRange(6, 8) # Truck turning abruptly, potentially faster
param ADV_INIT_OFFSET = VerifaiRange(-5, 0) # Truck starts slightly behind or at same line longitudinally relative to ego

PED_SPEED = 1.0 # Pedestrian walking speed
PED_YIELD_DIST = 12 # Distance at which ego yields to pedestrian
PED_CROSS_DISTANCE = 5 # How far the pedestrian crosses

param SAFETY_DIST = VerifaiRange(7, 10) # For collision avoidance with truck
CRASH_DIST = 3

EGO_INIT_DIST_FROM_INTERSECTION = [15, 20] # Ego starts this far from intersection
TERM_DIST_EGO = 70 # Ego has completed journey
TERM_DIST_PED_MAX = 20 # Pedestrian terminates after crossing some distance
TERM_TIME_MAX = 30 # Max simulation time for scenario to complete

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(egoTrajectory, pedestrian, pedestrianCrossingEndPt):
    try:
        # Move towards intersection until close to pedestrian
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED, trajectory=egoTrajectory) \
            until (distance to pedestrian) < PED_YIELD_DIST
        
        # Yield to pedestrian: brake while pedestrian is in the crossing area
        while (distance to pedestrian) < PED_YIELD_DIST and (distance from pedestrian to pedestrianCrossingEndPt) > 1:
            take SetBrakeAction(globalParameters.EGO_BRAKE)
            wait 0.5 seconds # Wait for pedestrian to move
        
        # After pedestrian clears, complete the turn
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED, trajectory=egoTrajectory)
        
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST): # For truck collision
        take SetBrakeAction(globalParameters.EGO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior AdversaryBehavior(advTrajectory):
    # Truck "abruptly turned right and cut in front".
    # Higher speed for turn is modeled by ADV_SPEED, no explicit collision avoidance for ego.
    do FollowTrajectoryBehavior(target_speed=globalParameters.ADV_SPEED, trajectory=advTrajectory)

behavior PedestrianBehavior(crossingEndPt):
    # Pedestrian walks towards its crossing end point
    # Assuming initial orientation is set correctly in spatial relations for crossing
    take SetSpeedAction(PED_SPEED)
    interrupt when (distance to crossingEndPt) < 1:
        terminate
    interrupt when (distance to ego) < CRASH_DIST: # Pedestrian collision
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Ego: southbound in turn lane (right turn)
# Find an incoming lane to the intersection that has a right turn maneuver.
egoInitLane = Uniform(*filter(lambda l:
    l.isIncoming and any(m.type is ManeuverType.RIGHT_TURN for m in l.maneuvers),
    intersection.incomingLanes
))

egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary: in left adjacent lane, also turns right
# Get the first lane section of the ego's initial lane
egoLaneSection = egoInitLane.laneSections[0]
# Get the fasterLane (which is to the left in right-hand traffic)
advLaneSection = egoLaneSection.fasterLane

# Require advLaneSection to exist, and its lane to also have a right turn
require advLaneSection is not None
advInitLane = advLaneSection.lane

require advInitLane is not None
require any(m.type is ManeuverType.RIGHT_TURN for m in advInitLane.maneuvers)

advManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, advInitLane.maneuvers))
advTrajectory = [advInitLane, advManeuver.connectingLane, advManeuver.endLane]
advSpawnPt = new OrientedPoint in advInitLane.centerline \
    offset along roadDirection by globalParameters.ADV_INIT_OFFSET # Start slightly behind or level with ego

# Pedestrian: yielded to before completing turn. Implies crossing the destination street.
# Place pedestrian near the start of the endLane, to the side, facing across.
pedestrianRefLane = egoManeuver.endLane
# A point along the destination road, where the pedestrian would start crossing
pedestrianPointOnRoad = new OrientedPoint in pedestrianRefLane.centerline \
    following roadDirection from pedestrianRefLane.startPoint for 5 # 5m into the destination road

# Position pedestrian laterally off the lane (on the sidewalk) and set heading to cross
pedestrianSpawnPt = pedestrianPointOnRoad \
    offset by (0, pedestrianRefLane.width / 2 + 1) # Move laterally to the right, onto the sidewalk (y-axis is lateral in lane's local frame)
pedestrianSpawnPt.heading = pedestrianPointOnRoad.heading + 90 deg # Rotate to face across the road

# Define the point where the pedestrian should finish crossing
pedestrianCrossingEndPt = pedestrianSpawnPt \
    offset along direction of pedestrianSpawnPt.heading for PED_CROSS_DISTANCE # Move forward from spawn point by crossing distance

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior(egoTrajectory, pedestrian, pedestrianCrossingEndPt)

adversary = new Car at advSpawnPt,
    with blueprint TRUCK_MODEL,
    with behavior AdversaryBehavior(advTrajectory)

pedestrian = new Pedestrian at pedestrianSpawnPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianBehavior(pedestrianCrossingEndPt)

#################################
# REQUIREMENTS                  #
#################################

require EGO_INIT_DIST_FROM_INTERSECTION[0] <= (distance to intersection) <= EGO_INIT_DIST_FROM_INTERSECTION[1]
require EGO_INIT_DIST_FROM_INTERSECTION[0] <= (distance from adversary to intersection) <= EGO_INIT_DIST_FROM_INTERSECTION[1]

# Ensure the truck is indeed in the lane to the left of ego
require ego.lane.id != adversary.lane.id
require ego.lane.index < adversary.lane.index # Assuming lane indices increase from right to left (common convention)

terminate when (distance to adversary) < CRASH_DIST # Collision between ego and adversary
terminate when (distance to egoSpawnPt) > TERM_DIST_EGO # Ego has completed journey past the intersection
terminate when (distance from pedestrian to pedestrianSpawnPt) > TERM_DIST_PED_MAX # Pedestrian has crossed enough distance
terminate when currentScenario.currentTime > TERM_TIME_MAX # Max simulation time reached