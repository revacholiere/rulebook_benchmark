"""
TITLE: waymo_020122-pdf
DESCRIPTION: On February 2, 2022 at 8:44 AM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a SUV on Clipper Street and Noe Street. The Waymo AV was stopped at a stop sign facing west on Clipper Street in autonomous mode while yielding to pedestrians in the crosswalk. After the pedestrians had crossed, the Waymo started to edge forward when an SUV to the Waymo AV’s rear passed the Waymo AV by driving in the oncoming traffic lane and made contact with the left rear sensor housing of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode and a test driver was present (in the driver’s seating position). The Waymo AV sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

EGO_MODEL = "vehicle.toyota.prius" # Waymo AV model
ADV_MODEL = "vehicle.lincoln.mkz_2017" # SUV model
PEDESTRIAN_MODEL = "walker.standing" # Generic pedestrian model

PI = 3.141592653589793 # Definition of PI for calculations

# Waymo AV (ego) constants
EGO_INIT_DIST_TO_INTERSECTION = 10 # Constant distance from intersection for Waymo's initial stop
param WAYMO_EDGE_SPEED = VerifaiRange(0.5, 1.5) # Speed when Waymo AV edges forward

# SUV (adversary) constants
param SUV_SPEED = VerifaiRange(7, 9)
param SUV_MOUNT_DIST = VerifaiRange(-15, -20) # SUV starts behind Waymo (negative distance)
param SUV_PASS_DIST_TRIGGER = VerifaiRange(5, 10) # Distance from ego to trigger SUV's pass maneuver
param SUV_PASS_STEER_LEFT = VerifaiRange(0.3, 0.6) # Steering angle to move into oncoming traffic path
param SUV_PASS_TIME_LEFT = VerifaiRange(1.0, 1.5) # Time duration to steer left
param SUV_PASS_TIME_STRAIGHT = VerifaiRange(1.5, 2.5) # Time duration to drive straight in 'oncoming' path

# Pedestrian constants
param PED_SPEED = VerifaiRange(1.0, 1.5)
param PED_CLEARANCE_DIST = VerifaiRange(8, 12) # Distance from pedestrian for Waymo to proceed

# General scenario constants
CRASH_DIST = 5 # Distance to detect a collision
TERM_DIST = 40 # Total distance from spawn to terminate scenario

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory, pedestrian):
    # Waymo AV is stopped at a stop sign, yielding to pedestrians
    try:
        # Keep speed 0 until pedestrian is far enough from self
        do FollowTrajectoryBehavior(target_speed=0, trajectory=trajectory)
    interrupt when (distance from pedestrian to self) > globalParameters.PED_CLEARANCE_DIST:
        # Pedestrians have cleared, Waymo AV starts to edge forward
        try:
            do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_EDGE_SPEED, trajectory=trajectory)
        interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
            # Terminate if a crash occurs
            terminate

behavior SUVBehavior(ego):
    # SUV initially follows behind the Waymo AV in its lane
    do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED) \
        until (distance to ego) < globalParameters.SUV_PASS_DIST_TRIGGER and ego.speed < globalParameters.WAYMO_EDGE_SPEED
    
    # Waymo AV is slow/stopped, SUV starts its passing maneuver
    # Steer left to move into the 'oncoming traffic lane'
    take SetSteerAction(globalParameters.SUV_PASS_STEER_LEFT) for globalParameters.SUV_PASS_TIME_LEFT seconds
    # Drive straight while passing the ego vehicle in the 'oncoming traffic lane'
    take SetSteerAction(0) for globalParameters.SUV_PASS_TIME_STRAIGHT seconds
    # After the passing attempt (collision happens during this phase), continue straight
    do FollowLaneBehavior(target_speed=globalParameters.SUV_SPEED)
    # The collision is handled by the Waymo's interrupt, so this behavior might terminate prematurely

behavior PedestrianCrosswalkBehavior(speed, destination):
    # Pedestrian walks across the crosswalk towards a destination point
    take SetSpeedAction(speed=speed, heading=angle to destination)
    wait until (distance to destination) < 1
    take SetSpeedAction(speed=0)
    terminate # Pedestrian stops after reaching destination

#################################
# SPATIAL RELATIONS             #
#################################

# Select an intersection (assuming a 4-way or 3-way intersection exists in Town04)
intersection = Uniform(*filter(lambda i: i.is4Way or i.is3Way, network.intersections))

# Waymo AV (ego) initial position and trajectory
# Ego is on an incoming lane to the intersection, facing west (implied by lane direction)
egoInitLane = Uniform(*intersection.incomingLanes)
# Waymo AV proceeds straight through the intersection
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# SUV (adversary) initial position
# SUV starts behind the Waymo AV
advSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.SUV_MOUNT_DIST

# Pedestrian initial position and destination
crosswalk = Uniform(*intersection.crosswalks)
# Spawn pedestrian at one corner of the crosswalk
pedestrianSpawnPt = new OrientedPoint at crosswalk.points[0]
# Define a destination point across the crosswalk (e.g., the opposite corner)
pedestrianEndPt = new OrientedPoint at crosswalk.points[2]

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint EGO_MODEL,
    with behavior WaymoBehavior(egoTrajectory, pedestrian)

adversary = new Car at advSpawnPt,
    with blueprint ADV_MODEL,
    with behavior SUVBehavior(ego)

pedestrian = new Pedestrian at pedestrianSpawnPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianCrosswalkBehavior(globalParameters.PED_SPEED, pedestrianEndPt)

#################################
# REQUIREMENTS                  #
#################################

# Waymo AV must be initially at a stop sign close to the intersection
require (distance to intersection) < EGO_INIT_DIST_TO_INTERSECTION
# Ensure no initial collision between Waymo AV and SUV
require (distance from adversary to ego) > CRASH_DIST
# Pedestrian must be initially close enough to the Waymo AV to necessitate yielding
require (distance from pedestrian to ego) < globalParameters.PED_CLEARANCE_DIST[1]

# Terminate the scenario if Waymo AV has driven far enough from its spawn point
terminate when (distance to egoSpawnPt) > TERM_DIST
# Terminate immediately if Waymo AV collides with any object
terminate when withinDistanceToAnyObjs(ego, CRASH_DIST)