"""
TITLE: zoox_020823-pdf
DESCRIPTION: A Zoox vehicle in autonomy was stopped with brake lights illuminated in traffic southbound on Embarcadero Street towards Folsom Street. When traffic ahead began to move the Zoox vehicle was appropriately following the car ahead at low speed when it was rear ended by Vehicle #2 at low speed. The other party did not stop to exchange information and left the scene. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param INITIAL_STOP_DURATION = VerifaiRange(2, 5) # Time ego and lead are stopped (seconds)
param TRAFFIC_SPEED = VerifaiRange(1, 2)         # Low speed when moving (m/s)
param ADVERSARY_SPEED = VerifaiRange(3, 5)       # Adversary speed (m/s), faster to cause collision

param LEAD_DIST = VerifaiRange(5, 10)            # Distance lead car is ahead of ego (m)
param ADVERSARY_INIT_DIST = VerifaiRange(10, 20) # Distance adversary is behind ego (m)

COLLISION_THRESHOLD = 2.5 # Approximate combined half-lengths for collision (m)
TERM_DIST = 50            # Max distance for scenario termination if no collision (m)

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(moving_speed):
    # Ego vehicle is initially stopped with brake lights illuminated
    try:
        do SetSpeedAction(0) for globalParameters.INITIAL_STOP_DURATION seconds
    then:
        # When traffic ahead moves, ego follows at low speed
        do FollowLaneBehavior(target_speed=moving_speed)
    # The ego is rear-ended, so no explicit avoidance behavior is modeled here

behavior LeadBehavior(moving_speed):
    # Lead vehicle is initially stopped with traffic
    try:
        do SetSpeedAction(0) for globalParameters.INITIAL_STOP_DURATION seconds
    then:
        # Then moves with traffic at low speed
        do FollowLaneBehavior(target_speed=moving_speed)

behavior AdversaryBehavior(target_speed):
    # Adversary approaches from behind at a low speed
    do FollowLaneBehavior(target_speed=target_speed)

#################################
# SPATIAL RELATIONS             #
#################################

# Choose a random lane for the scenario
initLane = Uniform(*network.lanes)
egoSpawnPt = new OrientedPoint in initLane.centerline

# Lead vehicle is placed ahead of the ego vehicle
leadSpawnPt = new OrientedPoint ahead of egoSpawnPt by globalParameters.LEAD_DIST

# Adversary vehicle is placed behind the ego vehicle
adversarySpawnPt = new OrientedPoint behind egoSpawnPt by globalParameters.ADVERSARY_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior(globalParameters.TRAFFIC_SPEED)

lead = new Car at leadSpawnPt,
    with blueprint MODEL,
    with behavior LeadBehavior(globalParameters.TRAFFIC_SPEED)

adversary = new Car at adversarySpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior(globalParameters.ADVERSARY_SPEED)

#################################
# REQUIREMENTS                  #
#################################

# Ensure there is sufficient initial spacing between vehicles
require (distance from ego to lead) > COLLISION_THRESHOLD
require (distance from adversary to ego) > COLLISION_THRESHOLD

terminate when (distance from adversary to ego) < COLLISION_THRESHOLD