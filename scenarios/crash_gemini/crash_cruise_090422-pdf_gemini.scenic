"""
TITLE: cruise_090422-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV”), operating in manual mode, was traveling eastbound on 12th Street between Kissling Street and Howard Street. Following the intersection of Howard Street, the Cruise AV came to a stop as a Lexus CT200 was stopped in the wrong direction of traffic on 12th Street. The driver of the Lexus CT200 appeared to be asleep. The Cruise AV operator made attempts to wake up the driver by flashing the Cruise AV headlights and honking the horn. A nearby cyclist also made attempts to wake up the driver. Shortly thereafter, the driver of the Lexus CT200 woke up, accelerated forward and made contact with the Cruise AV, damaging the front passenger fender and wheel well of the Cruise AV. There were no reported injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_CRUISE_AV = 'vehicle.lincoln.mkz_2017'
MODEL_LEXUS = 'vehicle.toyota.prius'
MODEL_CYCLIST = 'vehicle.bh.crossbike'

param CRUISE_AV_SPEED = VerifaiRange(7, 10)
param CRUISE_AV_STOP_DIST = VerifaiRange(10, 15)
CRASH_DIST = 2

param LEXUS_ACCELERATION_SPEED = VerifaiRange(3, 5)
param LEXUS_SPAWN_DIST = VerifaiRange(20, 30)
param WAIT_TIME_BEFORE_ACCELERATION = VerifaiRange(3, 7)

param CYCLIST_OFFSET_LATERAL = VerifaiRange(3, 5)
param CYCLIST_OFFSET_LONGITUDINAL = VerifaiRange(1, 3)

TERM_DIST_FROM_START = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_SPEED)
    interrupt when withinDistanceTo(self, adversary, globalParameters.CRUISE_AV_STOP_DIST):
        take SetBrakeAction(1.0)
        wait globalParameters.WAIT_TIME_BEFORE_ACCELERATION * 0.5 seconds
        take SetSpeedAction(0)
    interrupt when withinDistanceTo(self, adversary, CRASH_DIST):
        terminate

behavior LexusBehavior(initial_lane):
    take SetSpeedAction(0)
    wait globalParameters.WAIT_TIME_BEFORE_ACCELERATION seconds
    do FollowLaneBehavior(target_speed=globalParameters.LEXUS_ACCELERATION_SPEED, laneToFollow=initial_lane)

behavior CyclistBehavior():
    do Nothing

#################################
# SPATIAL RELATIONS             #
#################################

straightRoad = Uniform(*filter(lambda r: r.length > 100, network.roads))

egoLane = Uniform(*filter(lambda l: l.isDriving and l.direction is Direction.FORWARD, straightRoad.lanes))
egoSpawnPt = new OrientedPoint in egoLane.centerline

lexusLane = Uniform(*filter(lambda l: l.isDriving and l.direction is Direction.REVERSE, straightRoad.lanes))
lexusSpawnPt = new OrientedPoint in lexusLane.centerline ahead of ego by globalParameters.LEXUS_SPAWN_DIST

bicycleSpawnPt = new OrientedPoint at lexusSpawnPt offset by (globalParameters.CYCLIST_OFFSET_LATERAL, globalParameters.CYCLIST_OFFSET_LONGITUDINAL)

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL_CRUISE_AV,
    with behavior CruiseAVBehavior()

adversary = new Car at lexusSpawnPt,
    with blueprint MODEL_LEXUS,
    with behavior LexusBehavior(lexusLane)

bicycle = new Bicycle at bicycleSpawnPt,
    with blueprint MODEL_CYCLIST,
    with behavior CyclistBehavior()

terminate when (distance to adversary) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST_FROM_START