"""
TITLE: waymo-collision-report-october-16-2019-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was stopped in autonomous mode on northbound Distel Drive at El Camino Real in Los Altos when it was rear-ended. The Waymo AV was preparing to make a right-on-red from Distel Drive onto eastbound El Camino Real and was yielding to cross-traffic when a passenger vehicle made contact with the Waymo AV’s rear bumper at approximately 1 MPH. The Waymo AV sustained minor damage to its rear bumper, and the passenger vehicle sustained minor damage to its front bumper. No injuries were reported.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius'

WAYMO_STOPPED_SPEED = 0
param PASSENGER_CONTACT_SPEED = VerifaiRange(0.4, 0.5) # Approximately 1 MPH
param PASSENGER_INIT_DIST_BEHIND_WAYMO = VerifaiRange(4, 6) # Initial distance behind Waymo AV

WAYMO_INIT_DIST_TO_INTERSECTION_MIN = 0.5
WAYMO_INIT_DIST_TO_INTERSECTION_MAX = 3
CRASH_DIST_THRESHOLD = 2 # Distance to consider vehicles making contact
TERM_TIMEOUT = 30

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    take SetSpeedAction(WAYMO_STOPPED_SPEED)

behavior PassengerBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_CONTACT_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Find an incoming lane to the intersection that allows a right turn
incomingLane = Uniform(*filter(lambda l: any(m.type is ManeuverType.RIGHT_TURN for m in l.maneuvers), intersection.incomingLanes))

# Place ego just before the intersection, preparing for a right turn
egoSpawnPt = new OrientedPoint in incomingLane.centerline

# Place the adversary vehicle behind the ego vehicle in the same lane
advSpawnPt = new OrientedPoint behind ego by globalParameters.PASSENGER_INIT_DIST_BEHIND_WAYMO

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior()

require WAYMO_INIT_DIST_TO_INTERSECTION_MIN <= (distance to intersection) <= WAYMO_INIT_DIST_TO_INTERSECTION_MAX
terminate when (distance to adversary) < CRASH_DIST_THRESHOLD