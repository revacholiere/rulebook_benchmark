"""
TITLE: waymo_08242023-pdf
DESCRIPTION: On August 24, 2023 at 4:39 PM PT a Waymo Autonomous Vehicle (“Waymo AV”) operating in Santa Monica, California was in a collision involving a passenger car on Michigan Avenue at Euclid Street. The Waymo AV was traversing a roundabout at the intersection of Michigan Avenue at Euclid Street when it slowed to a stop for other vehicles approaching and in the roundabout. The front of the passenger car that was in the roundabout behind the Waymo AV made contact with the rear of the Waymo AV. Both vehicles sustained damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param WAYMO_INIT_SPEED = VerifaiRange(5, 7)
param WAYMO_BRAKE = VerifaiRange(0.5, 1.0)
param PASSENGER_SPEED = VerifaiRange(8, 10)
param PASSENGER_INIT_DIST = VerifaiRange(-10, -5)

param SAFETY_DIST = VerifaiRange(5, 10)
TERM_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)

behavior PassengerBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.PASSENGER_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

waymoInitialLane = Uniform(*filter(lambda lane: lane.inRoundabout and len(lane.nextLane) > 0, network.lanes))

waymoSpawnPt = new OrientedPoint in waymoInitialLane.centerline

waymoTrajectory = [waymoInitialLane, waymoInitialLane.nextLane[0]]

advSpawnPt = new OrientedPoint following roadDirection from waymoSpawnPt for globalParameters.PASSENGER_INIT_DIST

advTrajectory = waymoTrajectory

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior(waymoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior(advTrajectory)

#################################
# REQUIREMENTS                  #
#################################

terminate when (distance to adversary) < (ego.length + adversary.length) / 2