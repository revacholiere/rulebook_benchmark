"""
TITLE: cruise_090522-pdf
DESCRIPTION: A Cruise autonomous vehicle ("Cruise AV"), operating in driverless autonomous mode, was traveling eastbound on Sacramento Street between Van Ness Avenue and Polk Street. The Cruise AV approached a semi-trailer truck that was stopped in the left lane of traffic. The Cruise AV stopped before maneuvering into the bus and taxi lane to pass the semi-trailer truck. As the Cruise AV was slowly maneuvering around the semi-trailer truck and merging back into the left lane of traffic, a Honda Accord traveling behind the Cruise AV attempted to pass the Cruise AV and made contact with the Cruise AV, damaging the rear passenger side bumper of the Cruise AV. The driver of the Honda Accord left the scene without exchanging information. There were no reported injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_CRUISE = 'vehicle.lincoln.mkz_2017'
MODEL_TRUCK = 'vehicle.cargroup.mercedes_actros'
MODEL_HONDA = 'vehicle.honda.civic'

param EGO_INIT_SPEED = VerifaiRange(4, 6)
TRUCK_STOP_SPEED = 0
param ADV_SPEED = VerifaiRange(7, 9)

EGO_DIST_TO_TRUCK_STOP = 10
param BYPASS_DIST = VerifaiRange(20, 30)
param TRUCK_INIT_DIST = VerifaiRange(30, 40)
param ADV_DIST_BEHIND_EGO = VerifaiRange(-10, -15)

CRASH_DIST = 2
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior TruckBehavior():
    take SetSpeedAction(TRUCK_STOP_SPEED)

behavior EgoBehavior(truck):
    # 1. Approach the stopped truck
    do FollowLaneBehavior(target_speed=globalParameters.EGO_INIT_SPEED) until (distance to truck) < EGO_DIST_TO_TRUCK_STOP

    # 2. Stop before maneuvering
    take SetSpeedAction(0) for 1 seconds

    # 3. Maneuver into the bus and taxi lane (slower lane)
    slowerLaneSec = self.laneSection.slowerLane
    if slowerLaneSec is not None:
        do LaneChangeBehavior(laneSectionToSwitch=slowerLaneSec, target_speed=globalParameters.EGO_INIT_SPEED)
        
        # 4. Bypass the truck in the slower lane
        do FollowLaneBehavior(target_speed=globalParameters.EGO_INIT_SPEED, laneToFollow=slowerLaneSec.lane) until (distance from truck) > globalParameters.BYPASS_DIST
        
        # 5. Merge back into the original left lane (which is now the fasterLane relative to current position)
        originalLaneSec = self.laneSection.fasterLane
        if originalLaneSec is not None:
            do LaneChangeBehavior(laneSectionToSwitch=originalLaneSec, target_speed=globalParameters.EGO_INIT_SPEED)
            # 6. Continue traveling in the original lane
            do FollowLaneBehavior(target_speed=globalParameters.EGO_INIT_SPEED)
        else:
            # Fallback if no faster lane is available (should not happen if initial requirements are met)
            do FollowLaneBehavior(target_speed=globalParameters.EGO_INIT_SPEED)
    else:
        # Fallback if no slower lane is available (stuck behind the truck)
        do FollowLaneBehavior(target_speed=TRUCK_STOP_SPEED)
    
    terminate

behavior AdversaryBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Select a driving lane that has both a slower lane for bypassing and a faster lane to merge back
initLane = Uniform(*filter(lambda l:
    l.isDrivingLane and
    l.laneSection.slowerLane is not None and
    l.laneSection.slowerLane.fasterLane is not None,
    network.lanes))

egoSpawnPt = new OrientedPoint in initLane.centerline

# Truck is initially ahead of the ego vehicle in the same lane
truckSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.TRUCK_INIT_DIST

# Adversary is initially behind the ego vehicle in the same lane
advSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.ADV_DIST_BEHIND_EGO

#################################
# SCENARIO SPECIFICATION        #
#################################

truck = new Car at truckSpawnPt,
    with blueprint MODEL_TRUCK,
    with behavior TruckBehavior()

ego = new Car at egoSpawnPt,
    with blueprint MODEL_CRUISE,
    with behavior EgoBehavior(truck)

adversary = new Car at advSpawnPt,
    with blueprint MODEL_HONDA,
    with behavior AdversaryBehavior()

#################################
# REQUIREMENTS                  #
#################################

require ego.lane is truck.lane
require adversary.lane is ego.lane

terminate when (distance to adversary) < CRASH_DIST