"""
TITLE: zoox_08162023-pdf
DESCRIPTION: A Zoox vehicle in manual mode was slowing (with brake lights illuminated) in bumper-to-bumper traffic on westbound Sagamore St. approaching Orizaba St. when it was struck from behind by a following vehicle (vehicle 2). There was minor damage apparent to the hood of the striking vehicle and no damage to the Zoox vehicle. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOOX_MODEL = 'vehicle.lincoln.mkz_2017'
FOLLOWING_VEHICLE_MODEL = 'vehicle.mercedes.coupe_2020'

param ZOOX_SPEED = VerifaiRange(1, 3)
param ZOOX_BRAKE_FORCE = VerifaiRange(0.7, 1.0)

param FOLLOWING_VEHICLE_SPEED = VerifaiRange(5, 7)
param FOLLOWING_VEHICLE_INIT_DIST_FROM_EGO = VerifaiRange(-10, -15)

COLLISION_THRESHOLD = 2
TERM_EGO_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior():
    take SetBrakeAction(globalParameters.ZOOX_BRAKE_FORCE)
    do FollowLaneBehavior(target_speed=globalParameters.ZOOX_SPEED)

behavior FollowingVehicleBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.FOLLOWING_VEHICLE_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*network.lanes)
egoSpawnPt = new OrientedPoint in initLane.centerline

followingVehicleSpawnPt = new OrientedPoint following roadDirection from ego for globalParameters.FOLLOWING_VEHICLE_INIT_DIST_FROM_EGO

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint ZOOX_MODEL,
    with behavior ZooxBehavior()

adversary = new Car at followingVehicleSpawnPt,
    with blueprint FOLLOWING_VEHICLE_MODEL,
    with behavior FollowingVehicleBehavior()

require ego.lane is adversary.lane
require (distance to adversary) > (ego.length + adversary.length) / 2
terminate when (distance to adversary) < COLLISION_THRESHOLD
terminate when (distance to egoSpawnPt) > TERM_EGO_DIST