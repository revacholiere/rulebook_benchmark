"""
TITLE: mercedes-benz_020223-pdf
DESCRIPTION: The subject Mercedes-Benz DRIVE PILOT test vehicle was traveling between 15 — 20 mph in the #2 northbound lane on the 605 Freeway in California in stop and go traffic with the L3 ADS activated by the driver. The vehicle’s ADS determined that a truck traveling in the adjacent lane had a trajectory towards the Drive Pilot’s lane, and so the Mercedes-Benz test vehicle autonomously applied the brakes to avoid a collision. After applying the brakes and bringing itself to a standstill, the Mercedes-Benz was then struck in the rear bumper by a trailing semi-truck that did not stop in time. No injuries were reported, no airbags deployed in either vehicle, and both vehicles were able to be driven from the scene of the incident. The Mercedes-Benz vehicle experienced minor damage to the rear bumper, and no damage was observed on the semi-truck at the scene. The CA Traffic Collision Report for the subject incident noted a violation of California Vehicle Code 22350 (unsafe speed for traffic conditions) by the semi-truck in the #2 lane that struck the rear bumper of the Mercedes-Benz.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_EGO = 'vehicle.mercedes.e220'
MODEL_ADJ_TRUCK = 'vehicle.truck.man.tgx'
MODEL_TRAILING_TRUCK = 'vehicle.truck.c912t'

param EGO_INITIAL_SPEED = VerifaiRange(15 * 0.44704, 20 * 0.44704)
param EGO_BRAKE = VerifaiRange(0.7, 1.0)

param ADJ_TRUCK_SPEED = VerifaiRange(10 * 0.44704, 15 * 0.44704)
param ADJ_TRUCK_DIST_AHEAD = VerifaiRange(10, 20)

param TRAILING_TRUCK_SPEED = VerifaiRange(20 * 0.44704, 25 * 0.44704)
param TRAILING_TRUCK_DIST_BEHIND = VerifaiRange(-10, -15)

param SAFETY_DIST_EGO_BRAKE = VerifaiRange(10, 15)
param ADJ_TRUCK_LANE_CHANGE_DIST = VerifaiRange(20, 30)
CRASH_DIST = 3
TERM_DIST = 100
TERM_TIME = 10

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(adjTruck, trailingTruck):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_INITIAL_SPEED)
    interrupt when (distance from self to adjTruck) < globalParameters.SAFETY_DIST_EGO_BRAKE and self.speed > 0.5:
        take SetBrakeAction(globalParameters.EGO_BRAKE)
        wait until self.speed < 0.5
        take SetSpeedAction(0)
        wait 5 seconds
        terminate
    interrupt when (distance from self to trailingTruck) < CRASH_DIST:
        terminate
    interrupt when (distance from self to adjTruck) < CRASH_DIST:
        terminate

behavior AdjacentTruckBehavior(ego):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADJ_TRUCK_SPEED)
    interrupt when (distance from self to ego) < globalParameters.ADJ_TRUCK_LANE_CHANGE_DIST:
        do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.slowerLane, target_speed=globalParameters.ADJ_TRUCK_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.ADJ_TRUCK_SPEED)
    do FollowLaneBehavior(target_speed=globalParameters.ADJ_TRUCK_SPEED) for globalParameters.TERM_TIME seconds
    terminate

behavior TrailingTruckBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.TRAILING_TRUCK_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*filter(lambda l: l.isStraight and l.road.numLanes > 2, network.lanes))

egoSpawnPt = new OrientedPoint in initLane.centerline

adjTruckSpawnLane = initLane.fasterLane
adjTruckSpawnPt = new OrientedPoint in adjTruckSpawnLane.centerline \
                    following roadDirection for globalParameters.ADJ_TRUCK_DIST_AHEAD from egoSpawnPt

trailingTruckSpawnPt = new OrientedPoint in initLane.centerline \
                        following roadDirection for globalParameters.TRAILING_TRUCK_DIST_BEHIND from egoSpawnPt

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL_EGO,
    with behavior EgoBehavior(adjTruck, trailingTruck)

adjTruck = new Truck at adjTruckSpawnPt,
    with blueprint MODEL_ADJ_TRUCK,
    with behavior AdjacentTruckBehavior(ego)

trailingTruck = new Truck at trailingTruckSpawnPt,
    with blueprint MODEL_TRAILING_TRUCK,
    with behavior TrailingTruckBehavior()

#################################
# REQUIREMENTS                  #
#################################

require initLane.road.numLanes >= 3
require initLane.fasterLane is not None
require (distance from ego to adjTruck) > globalParameters.SAFETY_DIST_EGO_BRAKE + 5
require (distance from ego to trailingTruck) > (ego.length / 2) + (trailingTruck.length / 2) + 5
require ego.lane.road is adjTruck.lane.road
require ego.lane.road is trailingTruck.lane.road

#################################
# TERMINATION                   #
#################################

terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when current simulation time > TERM_TIME