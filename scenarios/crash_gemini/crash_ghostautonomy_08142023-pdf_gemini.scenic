"""
TITLE: ghostautonomy_08142023-pdf
DESCRIPTION: A registered Ghost AV Test vehicle was hit by crash debris while traveling on 1-680 N. The Ghost vehicle neither hit nor was hit by another vehicle. The Ghost car was traveling in AV mode with a registered AV Test Driver behind the wheel and an additional Safety Co-Driver in the passenger seat. Traffic slowed quickly due to a crash ahead of the Ghost car. Consistent with their training, the Ghost driver took control by braking and disengaging the autonomous system. The Ghost car stopped without impacting the preceding car. A Mercedes car immediately following the Ghost car also came to a stop without impacting the Ghost car. Ghost's understanding based on communications at the scene is that a Grand Cherokee traveling behind the Mercedes tried to swerve to avoid impacting the Mercedes but clipped the Mercedes and rolled over. To Ghost's knowledge, nobody in the Grand Cherokee was injured. The Ghost drivers heard a noise and then found that the rear bumper of the Ghost car had been damaged, which Ghost believes resulted from crash debris. The Ghost drivers drove the Ghost car back to the garage in conventional mode.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param EGO_INIT_SPEED = VerifaiRange(12, 16)
param EGO_BRAKE = VerifaiRange(0.6, 1.0)
param CRASH_AHEAD_TRIGGER_DIST = VerifaiRange(30, 40)

param PRECEDING_INIT_DIST = VerifaiRange(30, 40)
param PRECEDING_SPEED_SLOW = VerifaiRange(3, 7)

param MERCEDES_INIT_DIST = VerifaiRange(-8, -12)
param MERCEDES_INIT_SPEED = VerifaiRange(12, 16)
param MERCEDES_BRAKE = VerifaiRange(0.6, 1.0)
param MERCEDES_FOLLOW_DIST = VerifaiRange(10, 15)

param GRAND_CHEROKEE_INIT_DIST_FROM_MERCEDES = VerifaiRange(-8, -12)
param GRAND_CHEROKEE_INIT_SPEED = VerifaiRange(14, 18)
param GRAND_CHEROKEE_SWERVE_DIST = VerifaiRange(10, 15)
param GRAND_CHEROKEE_BRAKE = VerifaiRange(0.6, 1.0)

CRASH_DIST = 3
TERM_TIME = 20

#################################
# AGENT BEHAVIORS               #
#################################

behavior GhostBehavior(precedingCar):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_INIT_SPEED)
    interrupt when withinDistanceToObjsInLane(self, globalParameters.CRASH_AHEAD_TRIGGER_DIST, precedingCar):
        take SetBrakeAction(globalParameters.EGO_BRAKE)
    interrupt when (distance to precedingCar) < CRASH_DIST:
        terminate

behavior PrecedingBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.PRECEDING_SPEED_SLOW)

behavior MercedesBehavior(egoVehicle):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.MERCEDES_INIT_SPEED)
    interrupt when withinDistanceToObjsInLane(self, globalParameters.MERCEDES_FOLLOW_DIST, egoVehicle):
        take SetBrakeAction(globalParameters.MERCEDES_BRAKE)
    interrupt when (distance to egoVehicle) < CRASH_DIST:
        terminate

behavior GrandCherokeeBehavior(mercedesVehicle):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.GRAND_CHEROKEE_INIT_SPEED)
    interrupt when withinDistanceToObjsInLane(self, globalParameters.GRAND_CHEROKEE_SWERVE_DIST, mercedesVehicle):
        fasterLaneSec = self.laneSection.fasterLane
        if fasterLaneSec is not None:
            do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.GRAND_CHEROKEE_INIT_SPEED)
            do FollowLaneBehavior(target_speed=globalParameters.GRAND_CHEROKEE_INIT_SPEED, laneToFollow=fasterLaneSec.lane) for 1 seconds
        else:
            take SetBrakeAction(globalParameters.GRAND_CHEROKEE_BRAKE)
    interrupt when (distance to mercedesVehicle) < CRASH_DIST:
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*network.lanes)
egoSpawnPt = new OrientedPoint in initLane.centerline

precedingSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.PRECEDING_INIT_DIST
mercedesSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.MERCEDES_INIT_DIST
grandCherokeeSpawnPt = new OrientedPoint following roadDirection from mercedesSpawnPt for globalParameters.GRAND_CHEROKEE_INIT_DIST_FROM_MERCEDES

#################################
# SCENARIO SPECIFICATION        #
#################################

preceding = new Car at precedingSpawnPt,
    with blueprint MODEL,
    with behavior PrecedingBehavior()

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior GhostBehavior(preceding)

mercedes = new Car at mercedesSpawnPt,
    with blueprint MODEL,
    with behavior MercedesBehavior(ego)

grandCherokee = new Car at grandCherokeeSpawnPt,
    with blueprint MODEL,
    with behavior GrandCherokeeBehavior(mercedes)

#################################
# REQUIREMENTS                  #
#################################

require (distance to preceding) > (ego.length + preceding.length) / 2
require (distance to mercedes) > (ego.length + mercedes.length) / 2
require (distance from grandCherokee to mercedes) > (grandCherokee.length + mercedes.length) / 2
require grandCherokee.laneSection.fasterLane is not None

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when world.currentTime > TERM_TIME