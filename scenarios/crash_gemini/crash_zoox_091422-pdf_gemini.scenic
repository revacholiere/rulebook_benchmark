"""
TITLE: zoox_091422-pdf
DESCRIPTION: A Zoox vehicle in manual mode was slowing with the right of way to begin its turn to enter the 580 West Freeway on-ramp from West Grant Line Road in Altamont, CA. Vehicle 2 exiting the 580 West Freeway off-ramp jumped the median and made contact with the front end of the Zoox vehicle, continuing off an embankment and ending in a rollover. The other driver refused to provide any information and was observed being treated by first responders. The California Highway Patrol provided an NCI number (9390) at the scene. Autonomy was not engaged at any point during the drive cycle proceeding the event.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOX_MODEL = 'vehicle.lincoln.mkz_2017' # Representing the Zoox vehicle
ADV_MODEL = 'vehicle.lincoln.mkz_2017' # Representing Vehicle 2

param EGO_SPEED_INIT = VerifaiRange(5, 7) # Ego slowing to begin its turn
param EGO_BRAKE = VerifaiRange(0.5, 1.0)

param ADV_SPEED = VerifaiRange(8, 12) # Adversary traveling at higher speed
param SAFETY_DIST = VerifaiRange(5, 10) # Safety distance for ego to react
CRASH_DIST = 3 # Distance at which a collision is considered imminent or occurred
EGO_INIT_DIST = [10, 15] # Ego's initial distance to the intersection
ADV_INIT_DIST = [10, 20] # Adversary's initial distance to the intersection

TERM_DIST = 50 # Distance limit for scenario termination if no incident

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(trajectory):
    try:
        # Ego is slowing to begin its turn
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED_INIT, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.EGO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate # Terminate the scenario upon collision

behavior AdversaryBehavior(collisionTargetPoint):
    # Vehicle 2 exits the off-ramp, jumps the median, and makes contact with the Zoox vehicle.
    # This behavior simulates driving directly towards a target point, ignoring standard lane following.
    try:
        while distance to collisionTargetPoint > CRASH_DIST:
            take SetSpeedAction(globalParameters.ADV_SPEED)
            # Steer directly towards the target point to simulate erratic "jumping the median" movement
            take SetSteerAction(angle to collisionTargetPoint)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        # After collision, it continues off an embankment (uncontrolled movement)
        # and ends in a rollover (terminate)
        take SetSpeedAction(globalParameters.ADV_SPEED * 0.3) # Simulate reduced speed after impact
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED * 0.3) for 3 seconds # Uncontrolled forward motion
        terminate # Rollover and end scenario

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Ego is slowing to begin its turn to enter an on-ramp (simulated as a right turn)
egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary is "exiting the 580 West Freeway off-ramp" and "jumping the median".
# We place it on an incoming lane to the same intersection, but from a different road,
# simulating an off-ramp exit that conflicts with ego's turn.
advInitLane = Uniform(*filter(lambda lane:
    lane.road is not egoInitLane.road and
    lane.road not in [m.road for m in egoInitLane.maneuvers], # Ensure adversary is not on ego's path or its immediate continuation
    intersection.incomingLanes))
advSpawnPt = new OrientedPoint in advInitLane.centerline

# Define the collision target point for the adversary.
# This point is set at the very start of ego's turning lane segment,
# to simulate hitting the "front end of the Zoox vehicle" as it begins its turn.
collisionTargetPoint = egoManeuver.connectingLane.centerline.points[0]

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint ZOX_MODEL,
    with behavior EgoBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint ADV_MODEL,
    with behavior AdversaryBehavior(collisionTargetPoint)

#################################
# REQUIREMENTS                  #
#################################

require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require ADV_INIT_DIST[0] <= (distance from adversary to intersection) <= ADV_INIT_DIST[1]
# Ensure ego is positioned to begin its turn, not already far into it
require (distance to egoManeuver.connectingLane.centerline) < 10

terminate when (distance to egoSpawnPt) > TERM_DIST