"""
TITLE: waymo-collision-report-november-4-2019-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was stopped in manual mode on the interchange from eastbound Alma Street about to merge onto southbound Oregon Expressway in Palo Alto when it was rear-ended. The Waymo AV was yielding to cross-traffic when a passenger vehicle made contact with the Waymo AV’s rear bumper at approximately 1 MPH. The Waymo AV sustained minor damage to the rear bumper, and the passenger vehicle sustained no damage. There were no injuries reported at the scene.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = "vehicle.toyota.prius"

param WAYMO_SPEED = VerifaiRange(0, 0.1) # Waymo AV was stopped or moving very slowly
param PASSENGER_SPEED = VerifaiRange(0.4, 0.5) # Approximately 1 MPH
param PASSENGER_DIST_BEHIND = VerifaiRange(-8, -12) # Passenger vehicle starts behind ego
param SAFETY_DIST = VerifaiRange(1, 2) # Close distance for collision detection
INIT_DIST_TO_INTERSECTION = [5, 10] # Ego is close to the intersection/merge point
TERM_DIST = 50 # Scenario termination distance

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory):
    # Waymo AV is stopped, yielding to cross-traffic. Its speed is set very low.
    do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_SPEED, trajectory=trajectory)

behavior PassengerBehavior(trajectory):
    # Passenger vehicle approaches Waymo AV, making contact at low speed.
    do FollowTrajectoryBehavior(target_speed=globalParameters.PASSENGER_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

# Find a suitable intersection or merge point.
# A right turn often simulates merging onto another road from an interchange.
intersection = Uniform(*filter(lambda i: len(i.incomingLanes) > 0 and
                                     any(m.type is ManeuverType.RIGHT_TURN for m in i.incomingLanes[0].maneuvers),
                               network.intersections))

egoInitLane = Uniform(*filter(lambda l: any(m.type is ManeuverType.RIGHT_TURN for m in l.maneuvers), intersection.incomingLanes))
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary vehicle is behind the ego vehicle on the same logical path.
advTrajectory = egoTrajectory
advSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.PASSENGER_DIST_BEHIND

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior(advTrajectory)

#################################
# REQUIREMENTS                  #
#################################

# Ego is positioned near the intersection where it would yield.
require INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= INIT_DIST_TO_INTERSECTION[1]
# Adversary is behind ego, so its distance to the intersection should be greater.
require (distance from adversary to intersection) > (distance to intersection)

# Terminate when a collision occurs (vehicles overlap significantly)
terminate when (distance to adversary) < (ego.length + adversary.length) / 2
# Terminate if the ego vehicle moves too far, indicating scenario completion or failure to collide.