"""
TITLE: waymo_091621-pdf
DESCRIPTION: On September 16, 2021 at 5:14 PM PDT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a passenger vehicle at Palou Avenue and Selby Avenue. While making a left turn from Palou Avenue onto Selby Avenue in manual mode, the Waymo AV was struck by a passenger vehicle attempting to pass the Waymo AV on the left side using the oncoming traffic lane. The Waymo AV sustained minor damage to the left front fender. The other vehicle left the scene without exchanging information.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius' # Generic model for both Waymo and Passenger vehicles

param EGO_SPEED = VerifaiRange(2.5, 3.5) # Waymo AV turning speed
param ADV_SPEED = VerifaiRange(7.5, 9.5) # Passenger vehicle speed, higher for "attempting to pass"

param EGO_INIT_DIST = VerifaiRange(8, 12) # Distance of Waymo AV from the intersection
param ADV_INIT_DIST = VerifaiRange(15, 25) # Distance of Passenger vehicle from the intersection

CRASH_DIST = 5 # Distance at which a collision is considered to have occurred
TERM_DIST = 70 # Distance for scenario termination if agents drive too far

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory):
    # Waymo AV is making a left turn, following its defined trajectory.
    # The scenario describes the Waymo AV being struck, not necessarily avoiding the collision.
    do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED, trajectory=trajectory)

behavior PassengerBehavior(trajectory):
    # Passenger vehicle attempts to pass. It is in an "oncoming traffic lane"
    # and continues its path, leading to a collision with the turning Waymo AV.
    do FollowTrajectoryBehavior(target_speed=globalParameters.ADV_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

# Select a random 4-way intersection for the scenario.
intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Define the Waymo AV's (ego) initial lane and left turn trajectory.
egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Define the Passenger vehicle's (adversary) initial lane and trajectory.
# The description "using the oncoming traffic lane" implies the adversary is in a lane
# that carries traffic from the opposite direction relative to Waymo's initial approach.
# When Waymo turns left, it crosses this lane. The adversary continuing straight in this
# lane (which is on Waymo's left side during the turn) fulfills the "pass on the left"
# and "oncoming traffic lane" description, given its higher speed.
advInitLane = Uniform(*filter(lambda m:
        m.type is ManeuverType.STRAIGHT,
        egoManeuver.reverseManeuvers) # Finds straight maneuvers from an opposite incoming lane
    ).startLane
advTrajectory = [advInitLane] # Adversary's behavior is to continue straight through the intersection
advSpawnPt = new OrientedPoint in advInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior(advTrajectory)

# Requirements to ensure agents are positioned appropriately relative to the intersection
# for the described interaction to occur.
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require ADV_INIT_DIST[0] <= (distance from adversary to intersection) <= ADV_INIT_DIST[1]

# Termination conditions for the scenario. The collision is the main event.
terminate when (distance to adversary) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST # To prevent infinite simulations if no collision