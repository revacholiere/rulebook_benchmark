"""
TITLE: waymo_040523-pdf
DESCRIPTION: On April 5, 2023 at 10:46 AM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a passenger car on Potrero Avenue at 21st Street. The Waymo AV was traveling southbound on Potrero Avenue in the leftmost lane as it was approaching the intersection with 21st Street. The signal for traffic proceeding south on Potrero Avenue was green for the Waymo AV as it approached the intersection. As the Waymo AV approached, an individual riding a motorized scooter traveling north on Potrero Avenue proceeded to turn left onto westbound 21st Street, across the paths of the Waymo AV and other oncoming vehicles. The Waymo AV began to brake, and the Waymo AV test driver transitioned to manual mode and brought the Waymo AV to a stop. A passenger car traveling directly behind the Waymo AV then made contact with the rear of the Waymo AV. The individual riding the scooter was not contacted by the Waymo AV or any other vehicle. At the
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CAR_MODEL = 'vehicle.lincoln.mkz_2017'
SCOOTER_MODEL = 'vehicle.bh.crossbike'

param WAYMO_AV_SPEED = VerifaiRange(5, 7)
param WAYMO_AV_BRAKE = VerifaiRange(0.7, 1.0)

param PASSENGER_CAR_SPEED = VerifaiRange(6, 8)
param PASSENGER_CAR_DIST_BEHIND_WAYMO = VerifaiRange(-6, -8)

SCOOTER_SPEED = 3
param SCOOTER_INIT_DIST_FROM_INTERSECTION = VerifaiRange(10, 15)

param SAFETY_DIST_FOR_SCOOTER = VerifaiRange(8, 12)
WAYMO_AV_CRASH_DIST = 3

INIT_DIST_WAYMO_FROM_INTERSECTION = 20
TERM_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_AV_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST_FOR_SCOOTER):
        take SetBrakeAction(globalParameters.WAYMO_AV_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, WAYMO_AV_CRASH_DIST):
        terminate

behavior ScooterBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=SCOOTER_SPEED, trajectory=trajectory)

behavior PassengerCarBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.PASSENGER_CAR_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

scooterInitLane = Uniform(*filter(lambda m:
        m.type is ManeuverType.STRAIGHT,
        egoManeuver.reverseManeuvers)
    ).startLane
scooterManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, scooterInitLane.maneuvers))
scooterTrajectory = [scooterInitLane, scooterManeuver.connectingLane, scooterManeuver.endLane]
scooterSpawnPt = new OrientedPoint in scooterInitLane.centerline

passengerCarSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.PASSENGER_CAR_DIST_BEHIND_WAYMO

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint CAR_MODEL,
    with behavior WaymoAVBehavior(egoTrajectory)

scooter = new Car at scooterSpawnPt,
    with blueprint SCOOTER_MODEL,
    with behavior ScooterBehavior(scooterTrajectory)

passenger_car = new Car at passengerCarSpawnPt,
    with blueprint CAR_MODEL,
    with behavior PassengerCarBehavior(egoTrajectory)

#################################
# REQUIREMENTS                  #
#################################

require INIT_DIST_WAYMO_FROM_INTERSECTION - 5 <= (distance to intersection) <= INIT_DIST_WAYMO_FROM_INTERSECTION + 5
require globalParameters.SCOOTER_INIT_DIST_FROM_INTERSECTION - 5 <= (distance from scooter to intersection) <= globalParameters.SCOOTER_INIT_DIST_FROM_INTERSECTION + 5

terminate when (distance from passenger_car to ego) < (ego.length + passenger_car.length) / 2
terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when (distance to scooter) < (ego.length + scooter.length) / 2