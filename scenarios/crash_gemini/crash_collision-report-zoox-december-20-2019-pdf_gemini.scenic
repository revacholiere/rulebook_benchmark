"""
TITLE: collision-report-zoox-december-20-2019-pdf
DESCRIPTION: On December 20, 2019 at approximately 9:00AM, a stationary Zoox vehicle operating in manual mode was struck on its rear drivers' side by another vehicle traveling <10mph. The Zoox vehicle was traveling north on Kearny making a right onto Jackson. The Zoox vehicle was stopped while yielding to a pedestrian crossing Jackson. The vehicle directly behind the Zoox vehicle drove around the left side of the Zoox vehicle in an attempt to pass, clipping the left rear sensors with it's passenger side side-view mirror. There were no injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOOX_MODEL = 'vehicle.lincoln.mkz_2017'
ADV_MODEL = 'vehicle.toyota.prius'
PEDESTRIAN_MODEL = 'pedestrian.adult'

param ADV_SPEED = VerifaiRange(5.0, 9.9)
param ADV_DIST_BEHIND = VerifaiRange(5.0, 10.0)

param ZOOX_STOP_DIST_FROM_INTERSECTION = VerifaiRange(3.0, 5.0)
param PED_SPEED = VerifaiRange(0.5, 1.5)
PASSING_INIT_DIST = 10

CRASH_DIST = 2
TERM_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior():
    take SetSpeedAction(0)

behavior AdversaryBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)
    interrupt when withinDistanceToAnyObjs(self, PASSING_INIT_DIST):
        laneToPass = self.laneSection.fasterLane
        if laneToPass is not None:
            do LaneChangeBehavior(
                laneSectionToSwitch=laneToPass,
                target_speed=globalParameters.ADV_SPEED)
            do FollowLaneBehavior(
                target_speed=globalParameters.ADV_SPEED,
                laneToFollow=laneToPass.lane)
        else:
            do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

behavior PedestrianBehavior(crossingTrajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.PED_SPEED, trajectory=crossingTrajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

zooxInitLane = Uniform(*intersection.incomingLanes)
zooxManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, zooxInitLane.maneuvers))
zooxTrajectory = [zooxInitLane, zooxManeuver.connectingLane, zooxManeuver.endLane]
zooxSpawnPt = new OrientedPoint in zooxInitLane.centerline

advSpawnPt = new OrientedPoint behind zoox for globalParameters.ADV_DIST_BEHIND

pedestrianCrossingLane = zooxManeuver.connectingLane

pedestrianStartPt = new OrientedPoint in pedestrianCrossingLane.leftEdge at pedestrianCrossingLane.centerline.startPoint
pedestrianEndPt = new OrientedPoint in pedestrianCrossingLane.rightEdge at pedestrianCrossingLane.centerline.startPoint
pedestrianTrajectory = [pedestrianStartPt, pedestrianEndPt]

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at zooxSpawnPt,
    with blueprint ZOOX_MODEL,
    with behavior ZooxBehavior()

adversary = new Car at advSpawnPt,
    with blueprint ADV_MODEL,
    with behavior AdversaryBehavior()

pedestrian = new Pedestrian at pedestrianStartPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianBehavior(pedestrianTrajectory)

#################################
# REQUIREMENTS                  #
#################################

require (distance to zooxManeuver.connectingLane.centerline.startPoint) < globalParameters.ZOOX_STOP_DIST_FROM_INTERSECTION
require adversary.laneSection._fasterLane is not None
require pedestrian in pedestrianCrossingLane

terminate when (distance to adversary) < CRASH_DIST