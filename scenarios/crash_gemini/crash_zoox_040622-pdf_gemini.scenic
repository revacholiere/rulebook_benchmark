"""
TITLE: zoox_040622-pdf
DESCRIPTION: A Zoox vehicle in autonomous mode was making a right turn from Bryant Street onto 9th Street when a vehicle overtaking from the rear switched lanes as it drove in front of the Zoox vehicle and made contact with the front Zoox sensors. The other party left the scene. The police were not called and there were no injuries.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param EGO_SPEED = VerifaiRange(3, 5)
param ADV_SPEED = VerifaiRange(8, 12)
param ADV_INIT_DIST = VerifaiRange(15, 25)

CRASH_DIST = 1
param EGO_APPROACH_DIST = VerifaiRange(10, 20)
param ADV_APPROACH_DIST = VerifaiRange(25, 40)
TERM_DIST = 50
LANE_CHANGE_INIT_TIME = 2
LEAVE_SCENE_TIME = 5

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior AdversaryBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED) for LANE_CHANGE_INIT_TIME seconds
    interrupt when True:
        slowerLaneSec = self.laneSection.slowerLane
        if slowerLaneSec is not None:
            do LaneChangeBehavior(laneSectionToSwitch=slowerLaneSec, target_speed=globalParameters.ADV_SPEED)
            do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED) for LEAVE_SCENE_TIME seconds
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advInitLane = egoInitLane.fasterLane
advSpawnPt = new OrientedPoint in advInitLane.centerline behind egoSpawnPt for globalParameters.ADV_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior()

#################################
# REQUIREMENTS                  #
#################################

require globalParameters.EGO_APPROACH_DIST[0] <= (distance to intersection) <= globalParameters.EGO_APPROACH_DIST[1]
require globalParameters.ADV_APPROACH_DIST[0] <= (distance from adversary to intersection) <= globalParameters.ADV_APPROACH_DIST[1]
require egoInitLane.fasterLane is not None
require adversary.laneSection._slowerLane is not None
require adversary.distanceTo(ego) > CRASH_DIST
terminate when (distance from ego to egoSpawnPt) > TERM_DIST
terminate when scenic.scenario.currentTime > 20