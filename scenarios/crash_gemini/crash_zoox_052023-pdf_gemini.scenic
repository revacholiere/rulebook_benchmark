"""
TITLE: zoox_052023-pdf
DESCRIPTION: A Zoox vehicle in manual mode was stopped northbound at the intersection of Montgomery St and Broadway at a red traffic light when another vehicle making a left turn from westbound Broadway onto southbound Montgomery St erratically veered toward the Zoox vehicle, resulting in a low speed collision with our front bumper. The driver initially stopped and partially opened the drivers door, but then drove away from the scene. Police were not called and no injuries were reported.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param INTERSECTION_STOP_DIST = VerifaiRange(3, 8)
param ADV_INIT_DIST = VerifaiRange(20, 30)
param ADV_TURN_SPEED = VerifaiRange(5, 7)
param VEERING_DIST = VerifaiRange(8, 12)
param VEER_STEER = VerifaiRange(0.3, 0.6)
COLLISION_DIST = 2
param STOP_DURATION = VerifaiRange(0.5, 1.5)
param ADV_FLEE_SPEED = VerifaiRange(10, 15)
param FLEE_AWAY_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxStoppedBehavior():
    take SetSpeedAction(0)

behavior ErraticLeftTurnBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.ADV_TURN_SPEED, trajectory=trajectory)
    interrupt when (distance to ego) < globalParameters.VEERING_DIST and (apparent heading of ego) < 0:
        take SetSteerAction(globalParameters.VEER_STEER)
        do FollowLaneBehavior(target_speed=globalParameters.ADV_TURN_SPEED) for 0.5 seconds
    interrupt when (distance to ego) < COLLISION_DIST:
        take SetSpeedAction(0) for globalParameters.STOP_DURATION seconds
        do FollowLaneBehavior(target_speed=globalParameters.ADV_FLEE_SPEED)
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advInitLane = Uniform(*filter(lambda l:
    l is not egoInitLane and
    l is not egoInitLane.oppositeLane,
    intersection.incomingLanes
))
advManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, advInitLane.maneuvers))
advTrajectory = [advInitLane, advManeuver.connectingLane, advManeuver.endLane]
advSpawnPt = new OrientedPoint in advInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior ZooxStoppedBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior ErraticLeftTurnBehavior(advTrajectory)

#################################
# REQUIREMENTS                  #
#################################

require (distance to intersection) < globalParameters.INTERSECTION_STOP_DIST
require globalParameters.ADV_INIT_DIST[0] <= (distance from adversary to intersection) <= globalParameters.ADV_INIT_DIST[1]
terminate when (distance from adversary to ego) > globalParameters.FLEE_AWAY_DIST