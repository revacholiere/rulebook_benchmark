"""
TITLE: lyft-collision-report-april-11-2019-pdf
DESCRIPTION: On April 11,2019 at approximately 11:31 am, a Lyft Autonomous Vehicle operating in manual mode was involved in an incident with a moving third party vehicle. The incident occurred after making a right turn from Natoma Street and 6th Street in San Francisco, CA. Lyft was proceeding straight in the right lane when the third party vehicle aggressively swerved into the right lane, cutting broadside in front of the Lyft AV, and came to a complete stop, causing unavoidable impact from the Lyft AV at approximately 1 mph. The Lyft AV sustained damage to the front left bumper, fender, and left lidar sensor. The third party vehicle sustained damage to the right rear quarter panel and rear passenger door. Lyft AV operators called 911 due to hostile behavior of the third party driver and emergency vehicles responded to the scene. No injuries were reported by the first responders or the team in the Lyft AV.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param EGO_INITIAL_SPEED = VerifaiRange(7, 10)
param EGO_BRAKE_DECEL = VerifaiRange(0.5, 1.0)

param ADV_INITIAL_SPEED = VerifaiRange(8, 12)
param ADV_SWERVE_SPEED = VerifaiRange(6, 9)
param ADV_CUT_IN_DIST_TO_EGO = VerifaiRange(15, 20)
param ADV_STOP_DIST_TO_EGO = VerifaiRange(3, 5)

param SAFETY_DIST = VerifaiRange(8, 12)
CRASH_DIST = 5
EGO_INIT_DIST_FROM_INTERSECTION = [15, 25]
ADV_RELATIVE_DIST_BEHIND_EGO_PRE_SWERVE = VerifaiRange(20, 30)
TERM_TIME = 10

#################################
# AGENT BEHAVIORS               #
#################################

behavior LyftAVBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_INITIAL_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.EGO_BRAKE_DECEL)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior ThirdPartyVehicleBehavior(ego_vehicle, target_lane_section_to_cut_into):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADV_INITIAL_SPEED)
    interrupt when distance to ego_vehicle < globalParameters.ADV_CUT_IN_DIST_TO_EGO:
        do LaneChangeBehavior(
            laneSectionToSwitch=target_lane_section_to_cut_into,
            target_speed=globalParameters.ADV_SWERVE_SPEED)
        do FollowLaneBehavior(
            target_speed=globalParameters.ADV_SWERVE_SPEED,
            laneToFollow=target_lane_section_to_cut_into.lane) \
            until distance to ego_vehicle < globalParameters.ADV_STOP_DIST_TO_EGO
        take SetSpeedAction(0)
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
if egoManeuver.endLane.nextLane:
    egoTrajectory.append(egoManeuver.endLane.nextLane)

egoSpawnPt = new OrientedPoint in egoInitLane.centerline

egoPostTurnLaneSec = egoTrajectory[-1]
require egoPostTurnLaneSec.fasterLane is not None

advInitLaneSec = egoPostTurnLaneSec.fasterLane
advSpawnPt = new OrientedPoint in advInitLaneSec.centerline \
             behind ego by globalParameters.ADV_RELATIVE_DIST_BEHIND_EGO_PRE_SWERVE

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior LyftAVBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior ThirdPartyVehicleBehavior(ego, egoPostTurnLaneSec)

require EGO_INIT_DIST_FROM_INTERSECTION[0] <= (distance to intersection) <= EGO_INIT_DIST_FROM_INTERSECTION[1]
require adversary.lane is advInitLaneSec.lane
terminate when (distance to adversary) < (ego.length + adversary.length) / 2