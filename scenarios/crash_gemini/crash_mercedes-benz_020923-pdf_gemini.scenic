"""
TITLE: mercedes-benz_020923-pdf
DESCRIPTION: The subject Mercedes-Benz vehicle was driving in stop and go traffic on the 405 south freeway in Gardena, California with the L3 ADS activated. The test route selected by the driver in the vehicle's navigation system indicated an upcoming exit, so the driver began to prepare for a lane change towards the highway exit by deactivating the L3 ADS and activating the turn signal. Once the vehicle was in conventional driving mode, the driver looked for a gap in the adjacent lane to merge towards the exit lane, applied the brakes, and slowed the vehicle down. The SUV following the Mercedes-Benz vehicle did not respond in time to the vehicle's braking and contacted the rear of the Mercedes-Benz approximately 10 seconds after the L3 ADS was deactivated. The Mercedes-Benz vehicle experienced minor damage to the rear bumper. No injuries were reported, no airbags deployed in either vehicle, and both vehicles were driven from the scene of the incident.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_EGO = 'vehicle.mercedes.e220'
MODEL_ADV = 'vehicle.lincoln.mkz_2017'

param EGO_INIT_SPEED = VerifaiRange(7, 10)
param EGO_FINAL_SPEED = VerifaiRange(2, 4)
param EGO_BRAKE = VerifaiRange(0.5, 1.0)

param ADV_SPEED = VerifaiRange(8, 12)
param ADV_DIST_BEHIND_EGO = VerifaiRange(-10, -15)

param PRE_LANE_CHANGE_DIST = VerifaiRange(50, 80)
BRAKING_PHASE_DURATION = 10
TERM_TIMEOUT_DIST = 150

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(exitLaneSection):
    do FollowLaneBehavior(target_speed=globalParameters.EGO_INIT_SPEED) until (distance to exitLaneSection.lane.points[0]) < globalParameters.PRE_LANE_CHANGE_DIST
    do LaneChangeBehavior(laneSectionToSwitch=exitLaneSection, target_speed=globalParameters.EGO_INIT_SPEED)
    take SetBrakeAction(globalParameters.EGO_BRAKE)
    do FollowLaneBehavior(target_speed=globalParameters.EGO_FINAL_SPEED) for BRAKING_PHASE_DURATION seconds
    terminate

behavior AdvBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*filter(lambda l: l.slowerLane is not None, network.lanes))

egoSpawnPt = new OrientedPoint in initLane.centerline
adversarySpawnPt = new OrientedPoint following roadDirection from ego for globalParameters.ADV_DIST_BEHIND_EGO

exitLaneSection = initLane.slowerLane

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL_EGO,
    with behavior EgoBehavior(exitLaneSection)

adversary = new Car at adversarySpawnPt,
    with blueprint MODEL_ADV,
    with behavior AdvBehavior()

#################################
# REQUIREMENTS                  #
#################################

require (distance to exitLaneSection.lane.points[0]) > globalParameters.PRE_LANE_CHANGE_DIST
require (distance from adversary to exitLaneSection.lane.points[0]) > globalParameters.PRE_LANE_CHANGE_DIST
require ego.lane == adversary.lane
require globalParameters.ADV_DIST_BEHIND_EGO < -ego.length
require initLane.slowerLane is not None

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance to adversary) < (ego.length + adversary.length) / 2
terminate when (distance to egoSpawnPt) > TERM_TIMEOUT_DIST