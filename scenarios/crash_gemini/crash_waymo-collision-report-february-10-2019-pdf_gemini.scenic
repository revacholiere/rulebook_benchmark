"""
TITLE: waymo-collision-report-february-10-2019-pdf
DESCRIPTION: Per the DMV's request of 02/21/2019, Waymo is resubmitting this OL316 so the DMV's digital version is compliant with accessibility requirements under AB 434. Waymo's original report was submitted on 02/19/2019. A Waymo Autonomous Vehicle (“Waymo AV”) was traveling in autonomous mode in the far right lane on southbound Highway 85 passing E] Camino Real in Mountain View. A passenger vehicle entered the highway from El Camino Real and made an unsafe maneuver by crossing over a solid white line and cutting-in to the Waymo AV’s lane. Out of an abundance of caution, the Waymo AV’s test driver disengaged the autonomous mode on the Waymo AV and made an evasive maneuver into the left adjacent lane at approximately 45 MPH. As the test driver made the maneuver, the Waymo AV came into contact with a second passenger vehicle that had been approaching from behind in the left adjacent lane. The Waymo AV sustained minor damage and tire marks to the driver side of the vehicle, and the second passenger vehicle sustained no damage. The driver of the second passenger vehicle stopped to exchange information with the Waymo test
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius'

param WAYMO_INIT_SPEED = VerifaiRange(25, 30) # m/s, approx 56-67 MPH
param WAYMO_EVASIVE_SPEED = VerifaiRange(19, 21) # m/s, approx 45 MPH
param PASSENGER_1_SPEED = VerifaiRange(20, 25) # m/s
param PASSENGER_2_SPEED = VerifaiRange(28, 33) # m/s

param ADV_1_INIT_DIST = VerifaiRange(20, 30) # Distance Passenger 1 starts behind Waymo AV
param ADV_2_INIT_DIST = VerifaiRange(30, 40) # Distance Passenger 2 starts behind Waymo AV

param CUT_IN_DIST_TRIGGER = VerifaiRange(10, 15) # Distance for Passenger 1 to initiate cut-in
param SAFETY_DIST_REACTION = VerifaiRange(5, 10) # Distance for Waymo AV to react to Passenger 1's cut-in
CRASH_DIST = 1 # Approximate distance for collision to be detected
INIT_DIST = 30 # Minimum distance from an intersection for spawn points
TERM_DIST = 100 # Distance Waymo AV travels before scenario terminates
EVASIVE_FOLLOW_TIME = 5 # Time Waymo AV continues in new lane after evasive maneuver

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED)
    interrupt when withinDistanceToAnyObjs(adversary1, globalParameters.SAFETY_DIST_REACTION) and adversary1.lane is self.lane.slowerLane:
        do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.fasterLane, target_speed=globalParameters.WAYMO_EVASIVE_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_EVASIVE_SPEED) for EVASIVE_FOLLOW_TIME seconds
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior Passenger1Behavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_1_SPEED)
    interrupt when (distance to ego) < globalParameters.CUT_IN_DIST_TRIGGER and self.lane is ego.lane.slowerLane:
        do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.fasterLane, target_speed=globalParameters.PASSENGER_1_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_1_SPEED)

behavior Passenger2Behavior():
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_2_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

waymoLane = Uniform(*filter(lambda l: l.road.isHighway and l.fasterLane is not None and l.slowerLane is not None, network.lanes))

waymoSpawnPt = new OrientedPoint in waymoLane.centerline

adv1Lane = waymoLane.slowerLane
adv1SpawnPt = new OrientedPoint in adv1Lane.centerline behind waymoSpawnPt by globalParameters.ADV_1_INIT_DIST

adv2Lane = waymoLane.fasterLane
adv2SpawnPt = new OrientedPoint in adv2Lane.centerline behind waymoSpawnPt by globalParameters.ADV_2_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary1 = new Car at adv1SpawnPt,
    with blueprint MODEL,
    with behavior Passenger1Behavior()

adversary2 = new Car at adv2SpawnPt,
    with blueprint MODEL,
    with behavior Passenger2Behavior()

#################################
# REQUIREMENTS                  #
#################################

require waymoLane.fasterLane is not None
require waymoLane.slowerLane is not None
require (distance to intersection) > INIT_DIST
require (distance from adversary1 to intersection) > INIT_DIST
require (distance from adversary2 to intersection) > INIT_DIST

terminate when (distance to adversary2) < CRASH_DIST
terminate when (distance to waymoSpawnPt) > TERM_DIST