"""
TITLE: gm-cruise-collision-report-june-12-2019-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV”), operating in autonomous mode, was traveling in the left lane on northbound Folsom Street between 13th and 12th Streets when another vehicle changed into the Cruise AV’s lane without using its left signal. The driver of the Cruise AV disengaged from autonomous mode and, shortly thereafter, the Cruise AV and the other vehicle made contact, damaging the Cruise AV’s front right bumper, fender, and wheel well. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.lincoln.mkz_2017'
OTHER_VEHICLE_MODEL = 'vehicle.tesla.model3'

param CRUISE_AV_SPEED = VerifaiRange(8, 12)
param ADVERSARY_SPEED = VerifaiRange(8, 12)
param CRUISE_AV_BRAKE = VerifaiRange(0.5, 1.0)

param SAFETY_DIST_FOR_BRAKE = VerifaiRange(5, 10)
CRASH_DIST = 2

param TIME_TO_LANE_CHANGE = VerifaiRange(1, 3)

param INITIAL_MAX_LONGITUDINAL_OFFSET = VerifaiRange(10, 20)
param INITIAL_MIN_LONGITUDINAL_OFFSET = VerifaiRange(0, 5)

MIN_DIST_FROM_INTERSECTION = 50
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_SPEED)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST_FOR_BRAKE):
        take SetBrakeAction(globalParameters.CRUISE_AV_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior AdversaryBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADVERSARY_SPEED) for globalParameters.TIME_TO_LANE_CHANGE seconds
    do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.fasterLane, target_speed=globalParameters.ADVERSARY_SPEED)
    do FollowLaneBehavior(target_speed=globalParameters.ADVERSARY_SPEED)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

egoInitLane = Uniform(*filter(lambda l: l.slowerLane is not None and len(l.road.lanes) > 1, network.lanes))
advInitLane = egoInitLane.slowerLane

egoSpawnPt = new OrientedPoint in egoInitLane.centerline
advSpawnPt = new OrientedPoint in advInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior CruiseAVBehavior()

adversary = new Car at advSpawnPt,
    with blueprint OTHER_VEHICLE_MODEL,
    with behavior AdversaryBehavior()

require abs(adversary.distance.longitudinalTo(ego)) < globalParameters.INITIAL_MAX_LONGITUDINAL_OFFSET
require abs(adversary.distance.longitudinalTo(ego)) > globalParameters.INITIAL_MIN_LONGITUDINAL_OFFSET
require adversary.lane is advInitLane
require ego.lane is egoInitLane

require ego.distanceTo(intersection) > MIN_DIST_FROM_INTERSECTION
require adversary.distanceTo(intersection) > MIN_DIST_FROM_INTERSECTION

terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when (distance from adversary to advSpawnPt) > TERM_DIST