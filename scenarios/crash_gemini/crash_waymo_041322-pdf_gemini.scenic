"""
TITLE: waymo_041322-pdf
DESCRIPTION: On April 13, 2022 at 2:53 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a pickup truck on Bayshore Boulevard at Jerrold Avenue. The Waymo AV was traveling in autonomous mode in the slip lane on northbound Jerrold Avenue at Bayshore Boulevard. As the Waymo AV slowed to yield to a pedestrian pushing a shopping cart in a crosswalk, the Waymo AV test driver transitioned to manual mode and stopped the Waymo AV. The Waymo AV test driver then proceeded forward but had to yield to approaching traffic in the merge between northbound Jerrold Avenue and northbound Bayshore Boulevard. As the Waymo AV came to a stop, a pickup truck traveling behind the Waymo AV then made contact with the rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. Both vehicles sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
TRUCK_MODEL = 'vehicle.lincoln.mkz_2017' # Using a generic vehicle model for the pickup truck
PEDESTRIAN_MODEL = "vehicle.bh.crossbike" # Using a bicycle model to represent the pedestrian

param WAYMO_INIT_SPEED = VerifaiRange(5, 7) # Initial speed before Waymo AV starts yielding
param WAYMO_BRAKE = VerifaiRange(0.5, 1.0)

param TRUCK_SPEED = VerifaiRange(7, 9)
param TRUCK_FOLLOW_DIST = VerifaiRange(-8, -12) # Distance behind Waymo AV, negative for behind

PEDESTRIAN_SPEED = 1.0 # Pedestrian crossing speed
param PEDESTRIAN_LATERAL_OFFSET = VerifaiRange(2, 4) # Lateral offset from ego's centerline for pedestrian
param PEDESTRIAN_LONGITUDINAL_OFFSET = VerifaiRange(15, 25) # Longitudinal offset ahead of ego for pedestrian
param PEDESTRIAN_CROSS_DIST = VerifaiRange(3, 5) # Distance the pedestrian will cross
param PEDESTRIAN_YIELD_THRESHOLD = VerifaiRange(10, 15) # Distance at which Waymo AV starts yielding to pedestrian

param MERGE_TRAFFIC_SPEED = VerifaiRange(8, 12) # Speed of approaching traffic in the merge lane
param MERGE_TRAFFIC_INIT_DIST = VerifaiRange(20, 30) # Initial distance of merge traffic ahead of Waymo's merge point
param MERGE_TRAFFIC_YIELD_THRESHOLD = VerifaiRange(10, 15) # Distance at which Waymo AV starts yielding to merge traffic

param DIST_BETWEEN_STOPS = VerifaiRange(5, 10) # Distance Waymo AV travels between the first and second stop

CRASH_DIST = 3 # Distance for collision detection
param INIT_DIST_TO_INTERSECTION = VerifaiRange(15, 25) # Initial distance of Waymo AV to the intersection
TERM_DIST = 50 # Scenario termination distance for Waymo AV's travel

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory, pedestrian, mergeTraffic):
    # Waymo AV is in autonomous mode, traveling in the slip lane
    do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED, trajectory=trajectory)

    # Waymo AV slows to yield to a pedestrian pushing a shopping cart in a crosswalk
    wait until (distance to pedestrian) < globalParameters.PEDESTRIAN_YIELD_THRESHOLD
    take SetSpeedAction(0) # Stop for the pedestrian
    wait 2 seconds # Simulate stopping and test driver transitioning to manual mode

    # Waymo AV test driver then proceeds forward (in manual mode)
    do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED / 2, trajectory=trajectory) for globalParameters.DIST_BETWEEN_STOPS

    # Waymo AV has to yield to approaching traffic in the merge
    wait until (distance to mergeTraffic) < globalParameters.MERGE_TRAFFIC_YIELD_THRESHOLD
    take SetSpeedAction(0) # Stop for the approaching traffic

    # Allow time for the pickup truck to make contact with the rear of the Waymo AV
    wait 5 seconds

behavior AdversaryBehavior():
    # Pickup truck traveling behind the Waymo AV
    do FollowLaneBehavior(target_speed=globalParameters.TRUCK_SPEED)
    # The collision is expected to happen when the Waymo AV stops, without the truck avoiding it in time
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate # Scenario terminates upon collision

behavior PedestrianBehavior():
    # Simulate pedestrian crossing the road at a crosswalk
    # The 'bicycle' model for pedestrian is placed relative to ego's lane
    # and "crosses" by moving a small distance off its initial lane/path
    try:
        # Attempt to find a 'slowerLane' to simulate crossing from one lane into another
        slowerLaneSec = self.laneSection.slowerLane
        do LaneChangeBehavior(laneSectionToSwitch=slowerLaneSec, target_speed=PEDESTRIAN_SPEED)
        do FollowLaneBehavior(target_speed=PEDESTRIAN_SPEED, laneToFollow=slowerLaneSec.lane) for globalParameters.PEDESTRIAN_CROSS_DIST
    except: # Fallback if no slowerLane is available (e.g., at the edge of the road), just move forward slowly
        do FollowLaneBehavior(target_speed=PEDESTRIAN_SPEED) for globalParameters.PEDESTRIAN_CROSS_DIST
    take SetSpeedAction(0) # Stop after crossing

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Waymo AV starts in an incoming lane, taking a right turn to simulate a slip lane maneuver
egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Pedestrian is placed ahead and to the side of the Waymo AV's initial path, in a crosswalk area
pedestrianSpawnPt = new OrientedPoint in egoInitLane.centerline offset by \
    (globalParameters.PEDESTRIAN_LATERAL_OFFSET, globalParameters.PEDESTRIAN_LONGITUDINAL_OFFSET)

# Approaching traffic in the merge lane that Waymo AV will yield to
mergeTrafficSpawnPt = new OrientedPoint in egoManeuver.endLane.centerline \
    following roadDirection for globalParameters.MERGE_TRAFFIC_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior(egoTrajectory, pedestrian, mergeTraffic)

adversary = new Car following roadDirection from ego for globalParameters.TRUCK_FOLLOW_DIST,
    with blueprint TRUCK_MODEL,
    with behavior AdversaryBehavior()

pedestrian = new Bicycle at pedestrianSpawnPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianBehavior()

mergeTraffic = new Car at mergeTrafficSpawnPt,
    with blueprint TRUCK_MODEL, # Representing generic approaching traffic for the merge
    with behavior FollowLaneBehavior(target_speed=globalParameters.MERGE_TRAFFIC_SPEED)

#################################
# REQUIREMENTS                  #
#################################

require globalParameters.INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= globalParameters.INIT_DIST_TO_INTERSECTION[1]
require (distance from adversary to ego) > CRASH_DIST # Ensure no immediate collision at the start
require (distance from ego to pedestrian) > globalParameters.PEDESTRIAN_YIELD_THRESHOLD[0] # Pedestrian is ahead, Waymo needs to react
require (distance from ego to mergeTraffic) > globalParameters.MERGE_TRAFFIC_YIELD_THRESHOLD[0] # Merge traffic is ahead, Waymo needs to react

terminate when (distance to egoSpawnPt) > TERM_DIST # Terminate if Waymo AV travels too far
terminate when (distance to adversary) < CRASH_DIST # Terminate immediately on collision with the pickup truck