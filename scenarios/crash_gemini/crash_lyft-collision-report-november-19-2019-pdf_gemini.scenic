"""
TITLE: lyft-collision-report-november-19-2019-pdf
DESCRIPTION: On November 19, 2019 at approximately 2:04pm in clear weather, a Lyft Autonomous Vehicle (“Lyft AV”) was travelling at 29.6mph in autonomous mode northbound in the right lane on El Camino Real Blvd in Palo Alto, CA when the Safety Driver commanded manual mode with steering and brake inputs in immediate reaction to the third party vehicle in the adjacent center lane abruptly cutting in to the AV's lane, apparently attempting to make a last-second right turn onto Medical Foundation Drive. Approximately 1.5 seconds later, the third party vehicle collided with AV which was then travelling at 14mph. The third party passenger vehicle made contact with the Lyft AV’s front left lidar sensor and the driver side fender. Damage was limited to the third party’s passenger side door and passenger side fender, and the Lyft AV’s front bumper, left bumper lidar sensor and driver side fender. No injuries were reported and law enforcement was not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

LYFT_AV_MODEL = 'vehicle.lincoln.mkz_2017'
TPV_MODEL = 'vehicle.mercedes.cclass_2017'

# Speeds in m/s (approximate conversion from mph)
param LYFT_AV_INIT_SPEED = VerifaiRange(13.0, 13.5) # 29.6 mph is approx 13.23 m/s
param LYFT_AV_BRAKE = VerifaiRange(0.5, 1.0)
param TPV_INIT_SPEED = VerifaiRange(13.5, 14.5) # TPV is slightly faster or similar to initiate cut-in

# Distances
param CUT_IN_TRIGGER_DIST_TO_EGO = VerifaiRange(10, 15) # Distance from TPV to ego when cut-in behavior starts
param SAFETY_DIST = VerifaiRange(5, 8) # Distance for AV to react by braking
CRASH_DIST = 2 # Distance for actual collision detection
INIT_DIST_FROM_INTERSECTION = 50 # Ensure scenario starts on a straight road segment
TERM_DIST = 100 # Scenario termination if too much distance is covered without collision

# TPV's initial relative position to ego
param TPV_RELATIVE_DIST_LONGITUDINAL = VerifaiRange(-5, 0) # Negative means behind ego, 0 means alongside

#################################
# AGENT BEHAVIORS               #
#################################

behavior LyftAVBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.LYFT_AV_INIT_SPEED)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.LYFT_AV_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior TPVBehavior(target_lane_section_for_cut_in):
    # Initially follow its lane
    do FollowLaneBehavior(target_speed=globalParameters.TPV_INIT_SPEED) \
        until (distance to ego) < globalParameters.CUT_IN_TRIGGER_DIST_TO_EGO
    
    # Abruptly cut into the AV's lane
    do LaneChangeBehavior(
            laneSectionToSwitch=target_lane_section_for_cut_in,
            target_speed=globalParameters.TPV_INIT_SPEED
        )
    
    # After cutting in, continue in the new lane until collision
    do FollowLaneBehavior(target_speed=globalParameters.TPV_INIT_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Find a suitable road with at least two lanes (ego's lane and a faster lane for TPV)
egoInitLane = Uniform(*filter(lambda l: l.width > 3 and l.fasterLane is not None, network.lanes))

# Ego (Lyft AV) starts in this lane
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# TPV starts in the adjacent center lane, which is ego's faster lane
tpvInitLane = egoInitLane.fasterLane

# TPV spawns in its lane, slightly behind or alongside ego
tpvSpawnPt = new OrientedPoint in tpvInitLane.centerline
tpvSpawnPt = tpvSpawnPt following roadDirection for globalParameters.TPV_RELATIVE_DIST_LONGITUDINAL

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint LYFT_AV_MODEL,
    with behavior LyftAVBehavior()

tpv = new Car at tpvSpawnPt,
    with blueprint TPV_MODEL,
    with behavior TPVBehavior(ego.laneSection) # TPV cuts into ego's lane section

require ego.lane is tpv.lane.slowerLane # TPV is initially in the lane to the left of ego
require (distance to intersection) > INIT_DIST_FROM_INTERSECTION
require (distance from tpv to intersection) > INIT_DIST_FROM_INTERSECTION

terminate when (distance to tpv) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST