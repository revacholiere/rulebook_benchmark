"""
TITLE: zoox_020723-pdf
DESCRIPTION: A Zoox vehicle in autonomous mode was making a right turn to travel southwest onto 2nd Street from Folsom Street from lane | when Vehicle 2 crossed from lane 3 into the Zoox vehicle's lane and made contact with the Zoox vehicle's front sensors before making the right turn. Vehicle 2 did not stop before leaving the scene. No information was exchanged. There were no injuries and the police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOOX_MODEL = 'vehicle.tesla.model3'
VEHICLE2_MODEL = 'vehicle.lincoln.mkz_2017'

param ZOOX_SPEED = VerifaiRange(2.5, 3.5)
param ZOOX_BRAKE = VerifaiRange(0.5, 1.0)

param VEHICLE2_SPEED = VerifaiRange(8, 12)
param ADV_INIT_RELATIVE_DIST = VerifaiRange(5, 10) # Adversary initially behind ego in its lane
param ADV_DIST_TO_CHANGE_LANE = VerifaiRange(5, 10) # Distance from ego to trigger adversary's lane change

param SAFETY_DIST = VerifaiRange(3, 5)
CRASH_DIST = 1

EGO_INIT_DIST = [10, 15] # Zoox initial distance to intersection
TERM_DIST = 50 # Scenario termination distance from ego spawn or adversary spawn

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.ZOOX_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.ZOOX_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior Vehicle2Behavior(egoTargetLaneSection):
    # Vehicle 2 first follows its current lane, then changes into Zoox's lane, and continues.
    # The 'try' block defines the normal sequence of actions.
    try:
        # Follow current lane until a certain distance to ego, then initiate lane change.
        do FollowLaneBehavior(target_speed=globalParameters.VEHICLE2_SPEED) until (distance to ego) < globalParameters.ADV_DIST_TO_CHANGE_LANE
        
        # Perform a lane change into ego's initial lane section.
        do LaneChangeBehavior(laneSectionToSwitch=egoTargetLaneSection, target_speed=globalParameters.VEHICLE2_SPEED)
        
        # After changing lane, continue following that lane.
        do FollowLaneBehavior(target_speed=globalParameters.VEHICLE2_SPEED, laneToFollow=egoTargetLaneSection.lane)
    # The 'interrupt when' clause handles contact. Vehicle 2 does not stop.
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        do FollowLaneBehavior(target_speed=globalParameters.VEHICLE2_SPEED, laneToFollow=egoTargetLaneSection.lane)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Zoox (ego) starts in an incoming lane, preparing for a right turn.
egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Vehicle 2 (adversary) starts in 'lane 3' (relative to ego's lane, assuming ego is in 'lane 1').
# 'lane 3' would be two faster lanes away from ego's lane.
advInitLane = egoInitLane.fasterLane.fasterLane

# Vehicle 2 spawns behind ego in its own lane, to allow it to accelerate and cut in.
advSpawnPt = new OrientedPoint behind egoSpawnPt by globalParameters.ADV_INIT_RELATIVE_DIST in advInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint ZOOX_MODEL,
    with behavior ZooxBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint VEHICLE2_MODEL,
    with behavior Vehicle2Behavior(egoInitLane.laneSections[0]) # Vehicle 2 targets ego's initial lane section for the merge

require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
# Adversary starts further from the intersection than ego (behind ego)
require (distance from adversary to intersection) > EGO_INIT_DIST[0] 
# Ensure the necessary faster lanes exist for the adversary's initial position and lane change.
require egoInitLane.fasterLane is not None
require egoInitLane.fasterLane.fasterLane is not None

# Termination conditions
terminate when (distance to adversary) < CRASH_DIST # Scenario terminates on contact
terminate when (distance to egoSpawnPt) > TERM_DIST # Zoox leaves initial area
terminate when (distance from adversary to advSpawnPt) > TERM_DIST # Adversary leaves initial area