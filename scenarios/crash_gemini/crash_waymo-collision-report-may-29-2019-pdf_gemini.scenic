"""
TITLE: waymo-collision-report-may-29-2019-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) in autonomous mode was stopped in traffic while in the leftmost lane on southbound San Antonio Road headed toward Charleston Road in Palo Alto when it was rear-ended by a passenger vehicle maneuvering into the Waymo AV’s lane at approximately less than 1 MPH. The Waymo AV sustained minor scratches to its rear sensor, and the passenger vehicle left the scene. There were no injuries reported at the scene.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius'

WAYMO_AV_SPEED = 0 # Waymo AV is stopped in traffic
param PASSENGER_SPEED = VerifaiRange(0.1, 0.5) # Less than 1 MPH (0.1-0.5 MPH)

param ADV_REL_DIST = VerifaiRange(-10, -5) # Initial distance of adversary behind ego (negative implies behind)
COLLISION_DIST = 1.0 # Distance for detecting collision

INIT_DIST_FROM_INTERSECTION = 50 # Ensure vehicles are not too close to an intersection initially
TERM_TIME = 20 # Maximum simulation time to prevent infinite loops

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior():
    # Waymo AV is stopped in traffic
    do FollowLaneBehavior(target_speed=WAYMO_AV_SPEED)

behavior PassengerVehicleBehavior():
    # Passenger vehicle maneuvers into Waymo AV's lane (which is its fasterLane)
    # and continues at a low speed.
    try:
        do LaneChangeBehavior(laneSectionToSwitch=self.laneSection.fasterLane, target_speed=globalParameters.PASSENGER_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)
    interrupt when (distance to ego) < COLLISION_DIST:
        terminate # Adversary behavior terminates if it hits the ego

#################################
# SPATIAL RELATIONS             #
#################################

# Find a suitable lane for the Waymo AV.
# It needs to be the leftmost lane on its road and have a slowerLane (to its right)
# for the adversary to start in and merge from.
egoInitLane = Uniform(*filter(lambda l: l.isLeftmost and l.slowerLane is not None, network.lanes))
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# The adversary starts in the lane immediately to the right of the Waymo AV's lane
advInitLane = egoInitLane.slowerLane
advSpawnPt = new OrientedPoint in advInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoAVBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerVehicleBehavior()

# Initial placement requirements
# Ensure Waymo AV is not too close to an intersection
require (distance to intersection) > INIT_DIST_FROM_INTERSECTION
# Ensure adversary is initially behind ego
require adversary is behind ego
# Ensure the initial distance between adversary and ego is within the specified range
require (distance from adversary to ego) between globalParameters.ADV_REL_DIST[0] and globalParameters.ADV_REL_DIST[1]
# Ensure the adversary actually has a faster lane to merge into
require adversary.laneSection.fasterLane is not None

# Termination conditions
terminate when (distance to ego) < COLLISION_DIST # Collision
terminate when CurrentTime() > TERM_TIME # Scenario times out