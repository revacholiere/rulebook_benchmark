"""
TITLE: cruise_012922-pdf
DESCRIPTION: A Cruise autonomous vehicle ("Cruise AV"), operating in supervised autonomous mode, was traveling southbound on Potrero Avenue between 15th Street and 16th Street. The Cruise AV approached the intersection with 16th Street as a Toyota Tundra traveling southbound on Potrero Avenue was making a right turn onto westbound 16th street. The Toyota Tundra was yielding for pedestrians and blocking the bike lane on southbound Potrero Avenue with Cyclist 1 and Cyclist 2 approaching. The Cruise AV braked for the two cyclists as Cyclist 3 traveling behind the Cruise AV veered left to avoid another vehicle pulling out of a curbside parking spot. Cyclist 3 then made contact with the right rear bumper of the Cruise AV, falling off their bike. Cyclist 3 reported minor injuries related to the incident and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.lincoln.mkz_2017'
TUNDRA_MODEL = 'vehicle.toyota.tundra'
CYCLIST_MODEL = 'vehicle.bh.crossbike'
PARKING_VEHICLE_MODEL = 'vehicle.mercedes.cclass'

param EGO_SPEED = VerifaiRange(7, 10)
param EGO_BRAKE = VerifaiRange(0.5, 1.0)

param TUNDRA_SPEED = VerifaiRange(2, 4)
param CYCLIST_SPEED = VerifaiRange(3, 5)
param CYCLIST3_INIT_SPEED = VerifaiRange(6, 8)
param PARKING_VEHICLE_INIT_SPEED = VerifaiRange(0.5, 1.5)

param SAFETY_DIST_AV_BRAKE = VerifaiRange(5, 10)
VEER_TRIGGER_DIST = 5
CRASH_DIST = 2

EGO_INIT_DIST_TO_INTERSECTION = [15, 25]
param TUNDRA_DIST_AHEAD_OF_EGO = VerifaiRange(5, 10)
param CYCLIST1_DIST_BEHIND_TUNDRA = VerifaiRange(2, 5)
param CYCLIST2_DIST_BEHIND_CYCLIST1 = VerifaiRange(2, 3)
param CYCLIST3_DIST_BEHIND_EGO = VerifaiRange(-8, -12) # Negative means behind
param PARKING_VEHICLE_LONG_OFFSET = VerifaiRange(0, 2) # Slightly ahead or at level of C3

TERM_DIST = 70
TERM_TIME = 30

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED, trajectory=trajectory)
    interrupt when (distance to cyclist1 < globalParameters.SAFETY_DIST_AV_BRAKE) or \
                   (distance to cyclist2 < globalParameters.SAFETY_DIST_AV_BRAKE):
        take SetBrakeAction(globalParameters.EGO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior TundraBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.TUNDRA_SPEED, trajectory=trajectory)

behavior CyclistBehavior(target_speed):
    do FollowLaneBehavior(target_speed=target_speed)

behavior Cyclist3Behavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.CYCLIST3_INIT_SPEED)
    interrupt when distance to parkingVehicle < VEER_TRIGGER_DIST:
        fasterLaneSec = self.laneSection.fasterLane
        if fasterLaneSec is not None:
            do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.CYCLIST3_INIT_SPEED)
            do FollowLaneBehavior(target_speed=globalParameters.CYCLIST3_INIT_SPEED, laneToFollow=fasterLaneSec.lane)
        else:
            take SetBrakeAction(1.0)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior ParkingVehicleBehavior():
    try:
        take SetSpeedAction(0)
    interrupt when distance to cyclist3 < VEER_TRIGGER_DIST:
        fasterLaneSec = self.laneSection.fasterLane
        if fasterLaneSec is not None:
            do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.PARKING_VEHICLE_INIT_SPEED)
            do FollowLaneBehavior(target_speed=globalParameters.PARKING_VEHICLE_INIT_SPEED, laneToFollow=fasterLaneSec.lane)
        else:
            take SetSpeedAction(globalParameters.PARKING_VEHICLE_INIT_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

bikeLane = egoInitLane.section._slowerLane.lane
parkingLane = bikeLane.section._slowerLane.lane

tundraSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.TUNDRA_DIST_AHEAD_OF_EGO
tundraManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
tundraTrajectory = [tundraManeuver.startLane, tundraManeuver.connectingLane, tundraManeuver.endLane]

cyclist1SpawnPt = new OrientedPoint following roadDirection from tundraSpawnPt for -globalParameters.CYCLIST1_DIST_BEHIND_TUNDRA
cyclist2SpawnPt = new OrientedPoint following roadDirection from cyclist1SpawnPt for -globalParameters.CYCLIST2_DIST_BEHIND_CYCLIST1
cyclist3SpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.CYCLIST3_DIST_BEHIND_EGO 

parkingVehicleSpawnPt = new OrientedPoint following roadDirection from cyclist3SpawnPt for globalParameters.PARKING_VEHICLE_LONG_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior EgoBehavior(egoTrajectory)

tundra = new Car at tundraSpawnPt,
    with blueprint TUNDRA_MODEL,
    with behavior TundraBehavior(tundraTrajectory)

cyclist1 = new Bicycle at cyclist1SpawnPt,
    with blueprint CYCLIST_MODEL,
    with behavior CyclistBehavior(target_speed=globalParameters.CYCLIST_SPEED)

cyclist2 = new Bicycle at cyclist2SpawnPt,
    with blueprint CYCLIST_MODEL,
    with behavior CyclistBehavior(target_speed=globalParameters.CYCLIST_SPEED)

cyclist3 = new Bicycle at cyclist3SpawnPt,
    with blueprint CYCLIST_MODEL,
    with behavior Cyclist3Behavior()

parkingVehicle = new Car at parkingVehicleSpawnPt,
    with blueprint PARKING_VEHICLE_MODEL,
    with behavior ParkingVehicleBehavior()

#################################
# REQUIREMENTS                  #
#################################

require globalParameters.EGO_INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= globalParameters.EGO_INIT_DIST_TO_INTERSECTION[1]
require globalParameters.TUNDRA_DIST_AHEAD_OF_EGO[0] <= (distance from tundra to ego) <= globalParameters.TUNDRA_DIST_AHEAD_OF_EGO[1]
require egoInitLane._slowerLane is not None
require bikeLane._slowerLane is not None
require cyclist3.laneSection._fasterLane is not None
require parkingVehicle.laneSection._fasterLane is not None

terminate when (distance to cyclist3) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when currentTime >= TERM_TIME