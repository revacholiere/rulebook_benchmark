"""
TITLE: waymo_041223-pdf
DESCRIPTION: On April 12, 2023 at 5:29 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in Santa Monica, California was in a collision involving an SUV on Wilshire Boulevard at 26th Street. The Waymo AV was traveling southwest on Wilshire Boulevard in the rightmost lane as it was approaching the intersection with 26th Street. The signal for traffic proceeding southwest on Wilshire Boulevard was red as the Waymo AV approached the intersection and came to a stop. The signal for traffic proceeding southwest on Wilshire Boulevard then turned green, and traffic in adjacent lanes began moving while the Waymo AV waited for traffic in its lane to begin to move. The SUV that had been stopped directly behind the Waymo AV began moving forward and the front of the SUV made contact with the rear
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius' # Blueprint for the Waymo AV
SUV_MODEL = 'vehicle.lincoln.mkz_2017' # Blueprint for the SUV

param WAYMO_APPROACH_SPEED = VerifaiRange(7, 10) # Speed of Waymo AV when approaching
param SUV_ACCELERATION_SPEED = VerifaiRange(7, 9) # Speed of SUV when it starts moving forward

param SUV_INIT_OFFSET = VerifaiRange(5, 8) # Initial distance of SUV behind Waymo AV
param STOP_DIST_FROM_INTERSECTION = VerifaiRange(5, 10) # Distance from intersection where Waymo AV stops
param WAYMO_WAIT_TIME = VerifaiRange(1, 3) # Duration Waymo AV remains stopped (for red light + waiting after green)

COLLISION_THRESHOLD = 0.5 # Distance at which a collision is considered to have occurred
INIT_APPROACH_DIST = 20 # Minimum initial distance to intersection for both vehicles
TERM_DIST = 70 # Maximum distance ego can travel before scenario terminates

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    # Waymo AV approaches the intersection in its lane
    do FollowLaneBehavior(target_speed=globalParameters.WAYMO_APPROACH_SPEED) until (distance to intersection) < globalParameters.STOP_DIST_FROM_INTERSECTION
    
    # Waymo AV stops at the intersection due to red light and waits
    # for traffic in its lane to begin moving after the light turns green.
    take SetSpeedAction(0) for globalParameters.WAYMO_WAIT_TIME seconds
    
    # If not hit during the wait, the Waymo AV would then proceed
    do FollowLaneBehavior(target_speed=globalParameters.WAYMO_APPROACH_SPEED)

behavior SUVBehavior():
    # The SUV, initially stopped behind the Waymo AV, starts moving forward.
    # Its FollowLaneBehavior will cause it to accelerate and proceed, leading to a collision
    # if the Waymo AV is stopped in front.
    do FollowLaneBehavior(target_speed=globalParameters.SUV_ACCELERATION_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Select a random 4-way intersection for the scenario
intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# The Waymo AV (ego) spawns in one of the incoming lanes to the intersection
egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# The SUV (adversary) spawns directly behind the Waymo AV in the same lane
advSpawnPt = new OrientedPoint behind ego by globalParameters.SUV_INIT_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint SUV_MODEL,
    with behavior SUVBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ensure both vehicles are initially approaching the intersection
require (distance to intersection) > INIT_APPROACH_DIST
require (distance from adversary to intersection) > INIT_APPROACH_DIST

#################################
# TERMINATION CONDITIONS        #
#################################

# Terminate when the SUV makes contact with the rear of the Waymo AV
terminate when (distance to adversary) < COLLISION_THRESHOLD

# Terminate if the ego vehicle drives too far without a collision, to prevent infinite simulations
terminate when (distance to egoSpawnPt) > TERM_DIST