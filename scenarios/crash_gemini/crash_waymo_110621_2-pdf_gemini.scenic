"""
TITLE: waymo_110621_2-pdf
DESCRIPTION: On November 6, 2021 at 4:28 PM PDT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a passenger vehicle on Powell Street at Pacific Avenue. The Waymo AV was traveling in autonomous mode southbound on Powell Street when it activated its right turn signal and prepared to make a right turn onto Pacific Avenue. The Waymo AV stopped to yield to a pedestrian who was in the adjacent crosswalk on Pacific Avenue. A passenger vehicle behind the Waymo AV made contact with the rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode, and a test driver was present (in the driver’s seating position). The Waymo AV sustained minor damage to its rear bumper, and the trailing passenger vehicle sustained minor damage to its front bumper.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius'
PEDESTRIAN_MODEL = 'pedestrian.adult.01'

EGO_INIT_DIST = [10, 15] # Distance of Waymo AV from intersection approach
param WAYMO_SPEED = VerifaiRange(1.2, 1.5) # Approximately 3 MPH
param WAYMO_BRAKE = VerifaiRange(0.7, 1.0)
param PEDESTRIAN_YIELD_DIST = VerifaiRange(8, 12) # Distance at which Waymo yields to pedestrian

param PASSENGER_RELATIVE_DIST = VerifaiRange(-6, -8) # Passenger vehicle behind Waymo
param PASSENGER_SPEED = VerifaiRange(3.2, 3.8) # Approximately 8 MPH

param PEDESTRIAN_SPEED = VerifaiRange(1.0, 1.5) # Pedestrian walking speed
param PEDESTRIAN_LATERAL_OFFSET = VerifaiRange(3, 4) # Lateral offset for pedestrian from Waymo's turning path centerline (for crosswalk)
param PEDESTRIAN_LONGITUDINAL_OFFSET = VerifaiRange(2, 5) # Longitudinal offset for pedestrian in crosswalk relative to turn start

CRASH_DETECTION_DIST = 1 # Distance for generic collision detection in behavior
TERM_SCENARIO_DIST = 50 # Distance Waymo travels before scenario terminates if no crash

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory, pedestrian_obj):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_SPEED, trajectory=trajectory)
    interrupt when distance from self to pedestrian_obj < globalParameters.PEDESTRIAN_YIELD_DIST:
        take SetBrakeAction(globalParameters.WAYMO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DETECTION_DIST):
        terminate

behavior PassengerBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.PASSENGER_SPEED, trajectory=trajectory)

behavior PedestrianBehavior():
    take SetSpeedAction(globalParameters.PEDESTRIAN_SPEED) for 3 seconds
    terminate

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.PASSENSER_RELATIVE_DIST
advTrajectory = egoTrajectory

pedestrianSpawnPt = new OrientedPoint at egoManeuver.endLane.start \
    offsetRight(globalParameters.PEDESTRIAN_LATERAL_OFFSET) \
    ahead of egoManeuver.endLane.start by globalParameters.PEDESTRIAN_LONGITUDINAL_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

pedestrian = new Pedestrian at pedestrianSpawnPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianBehavior()

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior(egoTrajectory, pedestrian)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior(advTrajectory)

require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require adversary is behind ego
require (distance from pedestrian to intersection) < (globalParameters.PEDESTRIAN_LATERAL_OFFSET + globalParameters.PEDESTRIAN_LONGITUDINAL_OFFSET + 5) # Ensure pedestrian is near the intersection

terminate when (distance to egoSpawnPt) > TERM_SCENARIO_DIST
terminate when (distance from ego to adversary) < (ego.length + adversary.length) / 2 # Rear-end collision