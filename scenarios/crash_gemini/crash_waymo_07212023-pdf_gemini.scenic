"""
TITLE: waymo_07212023-pdf
DESCRIPTION: On July 21, 2023 at 9:51 AM PT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a passenger car on Leavenworth Street at Golden Gate Avenue. The collision occurred while the Waymo AV was stopped in the leftmost lane of a two-lane, one-way road at the intersection of Leavenworth Street at Golden Gate Avenue. The Waymo AV was stopped before the intersection, yielding to blocking cross-traffic when the light turned yellow. At that point, a passenger car that had been stopped behind the Waymo AV passed the Waymo AV on the left and proceeded into the intersection. While passing the Waymo AV, the passenger car’s rear passenger side door made contact with the driver side rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode. The passenger car did not stop but appears to have sustained damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_AV_MODEL = 'vehicle.toyota.prius'
PASSENGER_MODEL = 'vehicle.lincoln.mkz_2017'

WAYMO_STOP_SPEED = 0
param PASSENGER_SPEED = VerifaiRange(8, 12)

param PASSENGER_DIST = VerifaiRange(-8, -4)

param INIT_DIST_FROM_INTERSECTION = VerifaiRange(5, 15)

CRASH_DIST = 3
TERM_DIST_EGO_MOVED = 30
TERM_TIME_MAX = 20

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    take SetSpeedAction(WAYMO_STOP_SPEED)

behavior PassengerCarBehavior():
    try:
        do LaneChangeBehavior(
                laneSectionToSwitch=self.laneSection.fasterLane,
                target_speed=globalParameters.PASSENGER_SPEED)
        do FollowLaneBehavior(
                target_speed=globalParameters.PASSENGER_SPEED,
                laneToFollow=self.laneSection.fasterLane.lane)
        do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED) for TERM_TIME_MAX seconds
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*filter(lambda l: l.entryManeuvers and l.fasterLane, intersection.incomingLanes))

egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advSpawnPt = new OrientedPoint behind ego by globalParameters.PASSENGER_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_AV_MODEL,
    with behavior WaymoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint PASSENGER_MODEL,
    with behavior PassengerCarBehavior()

#################################
# REQUIREMENTS                  #
#################################

require INIT_DIST_FROM_INTERSECTION[0] <= (distance to intersection) <= INIT_DIST_FROM_INTERSECTION[1]

require ego.laneSection.fasterLane is not None

terminate when (distance to adversary) < CRASH_DIST
terminate when (distance to egoSpawnPt) > TERM_DIST_EGO_MOVED
terminate when currentTime > TERM_TIME_MAX