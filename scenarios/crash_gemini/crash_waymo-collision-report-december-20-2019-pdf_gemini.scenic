"""
TITLE: waymo-collision-report-december-20-2019-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was stopped in manual mode in the slip lane from southbound Whisman Station Drive to northbound Central Expressway in Mountain View when it was rear-ended. The Waymo AV test driver was yielding to approaching traffic when a passenger vehicle made contact with the Waymo AV’s rear bumper at approximately 2 MPH. The Waymo AV sustained minor damage to its rear bumper, and the passenger vehicle sustained minor damage to its front bumper. No injuries were reported at the scene.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
PASSENGER_MODEL = "vehicle.lincoln.mkz_2017"

WAYMO_SPEED = 0
param PASSENGER_SPEED = VerifaiRange(0.8, 1.0) # Approximately 2 MPH
param PASSENGER_DIST_BEHIND = VerifaiRange(-8, -5) # Passenger vehicle starts 5-8 meters behind Waymo AV

EGO_INIT_DIST_FROM_MANEUVER_END = VerifaiRange(2, 5) # Waymo AV is near the end of the slip lane
TERM_TIME = 10 # Scenario terminates after 10 seconds if no collision

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior():
    # Waymo AV is stopped, yielding to traffic
    take SetSpeedAction(WAYMO_SPEED)

behavior PassengerVehicleBehavior():
    # Passenger vehicle follows its lane at its specified speed
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Find a 4-way intersection to represent the merge point
intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Waymo AV is in a slip lane (connecting lane of a turn maneuver)
# We assume it's a right turn for simplicity of a slip lane exit
incomingLane = Uniform(*intersection.incomingLanes)
rightTurnManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, incomingLane.maneuvers))
slipLane = rightTurnManeuver.connectingLane

# Position the Waymo AV in the slip lane
egoSpawnPt = new OrientedPoint in slipLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoAVBehavior()

adversary = new Car following roadDirection for globalParameters.PASSENGER_DIST_BEHIND from ego,
    with blueprint PASSENGER_MODEL,
    with behavior PassengerVehicleBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ensure the Waymo AV is positioned near the end of the slip lane, where it would yield
require EGO_INIT_DIST_FROM_MANEUVER_END[0] <= (distance to rightTurnManeuver.endLane.startPoint) <= EGO_INIT_DIST_FROM_MANEUVER_END[1]

#################################
# TERMINATION                   #
#################################

# Scenario terminates when the passenger vehicle makes contact with the Waymo AV's rear bumper
terminate when (distance to adversary) < (ego.length + adversary.length) / 2
# Fallback termination if no collision happens within a certain time
terminate when simulation.currentTime > TERM_TIME