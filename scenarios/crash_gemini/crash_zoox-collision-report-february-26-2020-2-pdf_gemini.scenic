"""
TITLE: zoox-collision-report-february-26-2020-2-pdf
DESCRIPTION: A Zoox vehicle was stationary in autonomous mode on Montgomery St facing north towards Broadway St, yielding for an oncoming bus encroaching upon its lane. The bus struck the driver's side mirror, causing it to fold with minor damage. The bus driver did not stop, so no information was exchanged. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOOX_MODEL = 'vehicle.tesla.model3'
BUS_MODEL = 'vehicle.carlamotors.carlacola'

ZOOX_INIT_DIST = [15, 20]
ZOOX_SPEED = 0

param BUS_SPEED = VerifaiRange(5, 10)
param BUS_DIST_FROM_ZOOX = VerifaiRange(10, 20)
param BUS_LATERAL_OFFSET = VerifaiRange(-1.0, -0.5)

CRASH_DIST = 5
TERM_DIST = 50

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior():
    take SetSpeedAction(ZOOX_SPEED)

behavior BusBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.BUS_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

zooxInitLane = Uniform(*intersection.incomingLanes)
zooxManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, zooxInitLane.maneuvers))
zooxTrajectory = [zooxInitLane, zooxManeuver.connectingLane, zooxManeuver.endLane]
zooxSpawnPt = new OrientedPoint in zooxInitLane.centerline

busInitLane = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, zooxManeuver.reverseManeuvers)).startLane
busTrajectory = [busInitLane, zooxManeuver.reverseManeuvers[0].connectingLane, zooxManeuver.reverseManeuvers[0].endLane]

busSpawnPtBase = new OrientedPoint in busInitLane.centerline
busSpawnPt = busSpawnPtBase ahead of zooxSpawnPt by globalParameters.BUS_DIST_FROM_ZOOX
busSpawnPt = busSpawnPt offset by (globalParameters.BUS_LATERAL_OFFSET, 0)

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at zooxSpawnPt,
    with blueprint ZOOX_MODEL,
    with behavior ZooxBehavior()

bus = new Car at busSpawnPt,
    with blueprint BUS_MODEL,
    with behavior BusBehavior(busTrajectory)

require ZOOX_INIT_DIST[0] <= (distance to intersection) <= ZOOX_INIT_DIST[1]
require BUS_DIST_FROM_ZOOX[0] <= (distance from bus to ego) <= BUS_DIST_FROM_ZOOX[1]
terminate when (distance to bus) < (ego.length + bus.length) / 2