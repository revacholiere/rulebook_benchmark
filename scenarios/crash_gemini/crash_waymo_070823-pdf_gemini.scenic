"""
TITLE: waymo_070823-pdf
DESCRIPTION: On July 8, 2023 at 3:08 PM PT a Waymo Autonomous Vehicle (““Waymo AV”) operating in Los Angeles, California was in a collision involving a cyclist on S. Alameda Street at 6th Street. The Waymo AV was traveling southbound on S. Alameda Street and preparing to make a right turn onto westbound 6th Street. As the Waymo AV was yielding to cross-traffic and preparing to make a right turn, a cyclist was traveling eastbound on 6th Street and heading the wrong way in the bike lane. The cyclist then turned left, northbound, onto S. Alameda Street, continuing to travel the wrong direction in the bike lane. As the Waymo AV slowly proceeded forward, the cyclist passed the Waymo AV and made contact with the rear passenger side sensor of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode, and a test driver was present (in the driver’s seating position). The Waymo AV sustained damage and the cyclist did not stop, leaving the scene without
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = "vehicle.toyota.prius"
BICYCLE_MODEL = "vehicle.bh.crossbike"

param WAYMO_SPEED = VerifaiRange(1, 3) # Waymo AV slowly proceeded, yielding
param BICYCLE_SPEED = VerifaiRange(3, 6) # Cyclist passed Waymo AV

WAYMO_INIT_DIST = VerifaiRange(10, 20) # Distance from intersection for Waymo AV
BICYCLE_INIT_DIST = VerifaiRange(15, 25) # Distance from intersection for Cyclist

CRASH_DIST = 1 # Distance for collision detection
TERM_DIST = 50 # Scenario termination distance from Waymo AV's spawn point

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory):
    # Waymo AV prepares to make a right turn, slowly proceeds after yielding
    do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_SPEED, trajectory=trajectory)

behavior BicycleBehavior(trajectory):
    # Cyclist travels "wrong way" and makes a left turn, passing Waymo AV
    do FollowTrajectoryBehavior(target_speed=globalParameters.BICYCLE_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Waymo AV (ego) path: Southbound S. Alameda -> Right Turn -> Westbound 6th Street
waymoInitLane = Uniform(*intersection.incomingLanes)
waymoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, waymoInitLane.maneuvers))
waymoTrajectory = [waymoInitLane, waymoManeuver.connectingLane, waymoManeuver.endLane]
waymoSpawnPt = new OrientedPoint in waymoInitLane.centerline

# Cyclist path: Eastbound 6th Street -> Left Turn -> Northbound S. Alameda Street
# Select an incoming lane for the cyclist that is on the cross-road to Waymo's initial lane
crossRoad = waymoManeuver.connectingLane.road # This is 6th Street
bicycleInitLane = Uniform(*filter(lambda l:
    l.road is crossRoad and             # On 6th Street
    l.endsIn(intersection) and          # Incoming to the intersection
    l is not waymoManeuver.connectingLane # Ensure it's not the lane Waymo turns into
    , intersection.incomingLanes
))

# Find a left turn maneuver from this bicycleInitLane
# The maneuver's endLane should be on Waymo AV's initial road (S. Alameda)
bicycleManeuver = Uniform(*filter(lambda m:
    m.type is ManeuverType.LEFT_TURN and
    m.endLane.road is waymoInitLane.road # End on S. Alameda Street
    , bicycleInitLane.maneuvers
))
bicycleTrajectory = [bicycleInitLane, bicycleManeuver.connectingLane, bicycleManeuver.endLane]
bicycleSpawnPt = new OrientedPoint in bicycleInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at waymoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior(waymoTrajectory)

bicycle = new Bicycle at bicycleSpawnPt,
    with blueprint BICYCLE_MODEL,
    with behavior BicycleBehavior(bicycleTrajectory)

#################################
# REQUIREMENTS                  #
#################################

require WAYMO_INIT_DIST[0] <= (distance to intersection) <= WAYMO_INIT_DIST[1]
require BICYCLE_INIT_DIST[0] <= (distance from bicycle to intersection) <= BICYCLE_INIT_DIST[1]

# Terminate when Waymo AV and bicycle make contact
terminate when (distance to bicycle) < CRASH_DIST
terminate when (distance to waymoSpawnPt) > TERM_DIST