"""
TITLE: waymo_112621-pdf
DESCRIPTION: On November 26, 2021 at 8:02 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, CA was in a collision involving a passenger vehicle at Scotia Avenue, Thornton Avenue, and Bridgeview Drive. The Waymo AV was traveling southbound on Scotia Avenue, a narrow road with vehicles parked on both sides, and approaching the intersection with Thornton Avenue and Bridgeview Drive. A passenger vehicle approaching from the right of the Waymo AV on eastbound Thornton Avenue made a left turn in front of the Waymo AV to head northbound on Scotia Avenue. The Waymo AV slowed to a near stop and nudged to its right in order to share the narrow road with the oncoming vehicle and then came to a stop at the stop sign as the oncoming vehicle completed its turn. At approximately 5 mph, the turning passenger vehicle made contact with Waymo AV’s sensor hardware housing on the driver side rear corner fender of the stopped Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode, and a test driver was present (in the driver’s seating position). The Waymo AV sustained minor damage to
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_AV_MODEL = 'vehicle.toyota.prius'
PASSENGER_MODEL = 'vehicle.lincoln.mkz_2017'

param WAYMO_AV_INIT_DIST = VerifaiRange(15, 25)
param WAYMO_AV_APPROACH_SPEED = VerifaiRange(5, 7)
WAYMO_AV_STOP_DIST = 5

PASSENGER_VEH_TURN_SPEED = 2.2 # Approximately 5 MPH
param PASSENGER_VEH_INIT_DIST = VerifaiRange(20, 30)

SAFETY_DIST = 3
CRASH_DIST = 1.0
TERM_DIST = 70
TERM_TIME = 10

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior(egoTrajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_AV_APPROACH_SPEED, trajectory=egoTrajectory) \
            until (distance to intersection) < WAYMO_AV_STOP_DIST
        take SetBrakeAction(1.0)
        wait TERM_TIME seconds
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior PassengerVehicleBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=PASSENGER_VEH_TURN_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way or i.is3Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuverRef = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

advInitLane = Uniform(*filter(lambda l:
    l.isIncoming and (l is not egoInitLane)
    and any(m.type is ManeuverType.LEFT_TURN for m in l.maneuvers)
    , intersection.incomingLanes))

advManeuver = Uniform(*filter(lambda m:
    m.type is ManeuverType.LEFT_TURN
    and m.startLane is advInitLane
    and m.endLane.road is egoInitLane.road
    and m.endLane is not egoManeuverRef.endLane
    , advInitLane.maneuvers))

advTrajectory = [advInitLane, advManeuver.connectingLane, advManeuver.endLane]
advSpawnPt = new OrientedPoint in advInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_AV_MODEL,
    with behavior WaymoAVBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint PASSENGER_MODEL,
    with behavior PassengerVehicleBehavior(advTrajectory)

require globalParameters.WAYMO_AV_INIT_DIST[0] <= (distance to intersection) <= globalParameters.WAYMO_AV_INIT_DIST[1]
require globalParameters.PASSENGER_VEH_INIT_DIST[0] <= (distance from adversary to intersection) <= globalParameters.PASSENGER_VEH_INIT_DIST[1]

terminate when (distance to adversary) < (ego.length + adversary.length) / 2
terminate when (distance to egoSpawnPt) > TERM_DIST