"""
TITLE: argo_092222-pdf
DESCRIPTION: An Argo AI Autonomous Vehicle ("Argo AV") was impacted by a cyclist while traveling east on Park Ave and approaching Cambridge Ave. The Argo AV was traveling in its lane adjacent to a cyclist who was traveling in a marked bike lane. As the Argo AV was passing the cyclist (while maintaining more than 2 meters of lateral margin), the cyclist veered left into the Argo AV's lane. In response, the Argo AV steered away from the cyclist, but the cyclist continued into the lane and the bicycle's left handlebar made contact with the Argo AV's passenger side door handle. The Test Specialist brought the AV to a stop. The cyclist maintained balance, continued to cross the lanes behind the stopped Argo AV, and left the scene after a brief conversation with the left seat Test Specialist, during which the cyclist indicated that he was fine and apologized. The Argo AV sustained minor damage to its passenger side door handle.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'
BICYCLE_MODEL = 'vehicle.bh.crossbike'

param ARGO_AV_SPEED = VerifaiRange(5, 7)
param CYCLIST_SPEED = VerifaiRange(2, 4)
param ARGO_BRAKE = VerifaiRange(0.5, 1.0)

AVOID_DIST = 5 # Distance for AV to react when cyclist is in its lane
param CYCLIST_START_ADVANCE_DIST = VerifaiRange(5, 10) # Cyclist initially ahead of AV
param PRE_VEER_DIST = VerifaiRange(10, 20) # Distance cyclist travels in bike lane before veering
param POST_VEER_DIST = VerifaiRange(10, 15) # Distance cyclist travels after veering into AV lane
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior ArgoAVBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ARGO_AV_SPEED)
    interrupt when cyclist.lane is self.lane and (distance to cyclist) < AVOID_DIST:
        # Cyclist has entered AV's lane and is close enough to react. AV brakes.
        take SetBrakeAction(globalParameters.ARGO_BRAKE)
    interrupt when self.collidingWith(cyclist):
        # Contact made, AV stops
        take SetBrakeAction(1.0)
        terminate

behavior CyclistBehavior(initial_lane, target_lane_section_for_change):
    # Cyclist travels in bike lane for a specified distance
    do FollowLaneBehavior(target_speed=globalParameters.CYCLIST_SPEED, laneToFollow=initial_lane) \
        for globalParameters.PRE_VEER_DIST meters
    # Cyclist veers left into AV's lane
    do LaneChangeBehavior(laneSectionToSwitch=target_lane_section_for_change, target_speed=globalParameters.CYCLIST_SPEED)
    # Cyclist continues in the AV's lane for a specified distance after veering
    do FollowLaneBehavior(target_speed=globalParameters.CYCLIST_SPEED) \
        for globalParameters.POST_VEER_DIST meters
    # Cyclist leaves the scene
    terminate

#################################
# SPATIAL RELATIONS             #
#################################

# Find a suitable lane for the ego vehicle.
# This lane must have a slower lane (which will be the bike lane)
# and the slower lane must be a valid lane itself.
# Also, ensure the lane itself is long enough for the scenario.
suitable_ego_lanes = filter(lambda l:
    len(l.laneSections) > 0 and
    l.laneSections[0].slowerLane is not None and
    l.laneSections[0].slowerLane.lane is not None and
    l.length > (globalParameters.CYCLIST_START_ADVANCE_DIST + globalParameters.PRE_VEER_DIST + globalParameters.POST_VEER_DIST + 20)
    , network.lanes)

egoInitLane = Uniform(*suitable_ego_lanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Define the cyclist's initial lane (the bike lane, which is the slower lane relative to ego)
cyclistInitialLaneSection = egoInitLane.laneSections[0].slowerLane
cyclistInitialLane = cyclistInitialLaneSection.lane

# Define the target lane section for the cyclist's lane change (ego's current lane section)
cyclistTargetLaneSection = egoInitLane.laneSections[0]

# Cyclist starts slightly ahead of the AV, in the bike lane
cyclistSpawnPt = new OrientedPoint at egoSpawnPt \
    following roadDirection for globalParameters.CYCLIST_START_ADVANCE_DIST \
    in cyclistInitialLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior ArgoAVBehavior()

cyclist = new Bicycle at cyclistSpawnPt,
    with blueprint BICYCLE_MODEL,
    with behavior CyclistBehavior(cyclistInitialLane, cyclistTargetLaneSection)

#################################
# REQUIREMENTS                  #
#################################

# Ensure cyclist starts in its dedicated lane (bike lane)
require cyclist.lane is cyclistInitialLane
# Ensure ego is in its designated lane
require ego.lane is egoInitLane
# Ensure they are close enough to interact
require (distance to cyclist) < (globalParameters.CYCLIST_START_ADVANCE_DIST + 10)

terminate when ego.behavior.isFinished()
terminate when (distance to egoSpawnPt) > TERM_DIST