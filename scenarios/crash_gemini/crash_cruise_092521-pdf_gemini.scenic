"""
TITLE: cruise_092521-pdf
DESCRIPTION: A Cruise autonomous vehicle ("Cruise AV"), operating in manual mode, was traveling northbound on 3rd Street between Marin Street and Cesar Chavez Street. As the Cruise AV was stopped behind another vehicle, a 2020 Chevy Bolt behind the Cruise AV made contact with the Cruise AV, damaging the rear center bumper of the Cruise AV. The Cruise AV operator reported injuries. Police were not called to the scene.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.lincoln.mkz_2017' # Placeholder model for Cruise AV
CHEVY_BOLT_MODEL = 'vehicle.chevrolet.bolt_2020' # Placeholder model for 2020 Chevy Bolt

EGO_STOP_SPEED = 0 # Cruise AV was stopped
param ADV_SPEED = VerifaiRange(3, 8) # Passenger vehicle speed at contact (approx. 8 MPH)
param ADV_INIT_DIST = VerifaiRange(10, 20) # Initial distance of Chevy Bolt behind Cruise AV

MAX_SIM_TIME = 20 # Maximum simulation time to prevent infinite runs

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoStoppedBehavior():
    # The Cruise AV was stopped and should maintain this state.
    take SetSpeedAction(EGO_STOP_SPEED)

behavior AdversaryApproachBehavior():
    # The Chevy Bolt approaches from behind without explicitly braking to ensure contact.
    do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Pick a random lane for the scenario, assuming a relatively straight road segment
initLane = Uniform(*network.lanes)

# The Cruise AV (ego) is positioned in this lane.
egoSpawnPt = new OrientedPoint in initLane.centerline

# The 2020 Chevy Bolt (adversary) is behind the Cruise AV in the same lane.
advSpawnPt = new OrientedPoint behind egoSpawnPt by globalParameters.ADV_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior EgoStoppedBehavior()

adversary = new Car at advSpawnPt,
    with blueprint CHEVY_BOLT_MODEL,
    with behavior AdversaryApproachBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ensure the adversary is initially behind the ego and on the same lane.
require adversary.lane is ego.lane

#################################
# TERMINATION CONDITIONS        #
#################################

# Terminate when the Chevy Bolt makes contact with the rear bumper of the Cruise AV.
# This is typically when their centers are within half their combined length.
terminate when (distance from adversary to ego) < (ego.length + adversary.length) / 2
# Terminate if the simulation runs for too long without the expected contact occurring.