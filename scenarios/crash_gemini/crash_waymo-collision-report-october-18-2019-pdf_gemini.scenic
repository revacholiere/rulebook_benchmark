"""
TITLE: waymo-collision-report-october-18-2019-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was stopped in autonomous mode on the interchange from eastbound Alma Street merging onto southbound Oregon Expressway in Palo Alto when it was rear-ended. The Waymo AV was yielding to cross-traffic when a passenger vehicle made contact with the Waymo AV’s rear bumper at approximately 8 MPH. The Waymo AV sustained minor damage to the rear bumper, and the passenger vehicle sustained minor damage to its front bumper. There were no injuries reported at the scene; the Waymo test driver later reported dizziness but declined medical attention.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
PASSENGER_MODEL = "vehicle.lincoln.mkz_2017"

WAYMO_SPEED = 0 # Waymo AV is stopped
param PASSENGER_SPEED = VerifaiRange(3.0, 4.0) # Approximately 8 MPH
param PASSENGER_DIST_BEHIND_WAYMO = VerifaiRange(-8, -6) # Distance behind Waymo AV

CRASH_DIST = 1 # Distance for collision detection
INIT_DIST_TO_INTERSECTION = [2, 5] # Waymo AV is near the intersection/merge point
TERM_DIST = 50 # Termination distance for Waymo AV if it moves

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    take SetSpeedAction(WAYMO_SPEED) # The Waymo AV is stopped

behavior PassengerBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way or i.is3Way, network.intersections))
waymoInitLane = Uniform(*intersection.incomingLanes)
waymoSpawnPt = new OrientedPoint in waymoInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

waymo = new Car at waymoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior()

passenger = new Car following roadDirection for globalParameters.PASSENGER_DIST_BEHIND_WAYMO,
    with blueprint PASSENGER_MODEL,
    with behavior PassengerBehavior()

require INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= INIT_DIST_TO_INTERSECTION[1]
require (distance from passenger to waymo) > (waymo.length + passenger.length) / 2 # Ensure no initial collision
terminate when (distance to passenger) < CRASH_DIST # Collision between Waymo AV and passenger vehicle
terminate when (distance to waymoSpawnPt) > TERM_DIST # Waymo AV moved too far