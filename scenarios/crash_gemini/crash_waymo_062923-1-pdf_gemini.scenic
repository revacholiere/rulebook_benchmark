"""
TITLE: waymo_062923-1-pdf
DESCRIPTION: On June 29, 2023 at 7:50 AM PT a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, CA was in a collision involving a pickup truck on Jersey Street at Church Street. The Waymo AV was traveling eastbound on Jersey Street and stopped at a stop sign at the intersection of Church Street. While yielding to pedestrians crossing the street, a pickup truck traveling directly behind the Waymo AV made contact with the rear of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was engaged in autonomous mode. The Waymo AV sustained damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
PICKUP_MODEL = "vehicle.chevy.silverado"

param WAYMO_INIT_SPEED = VerifaiRange(3, 5) # Waymo AV's initial speed before stopping
param PICKUP_SPEED = VerifaiRange(7, 9)   # Pickup truck's speed (approx 8 MPH)
param PICKUP_DIST = VerifaiRange(-6, -10) # Initial distance of pickup truck behind Waymo AV

param EGO_INIT_DIST_TO_INTERSECTION = VerifaiRange(20, 30) # Initial distance of Waymo AV to the intersection
param STOP_DIST_FROM_INTERSECTION = VerifaiRange(2, 5)   # Distance to intersection where Waymo AV should stop (e.g., at stop line)
param YIELD_DURATION = VerifaiRange(2, 4)           # Duration Waymo AV yields (remains stopped)

TERM_DIST = 30 # General termination distance for ego

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    try:
        # Drive towards the intersection
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED)
    interrupt when (distance to intersection) < globalParameters.STOP_DIST_FROM_INTERSECTION:
        # Waymo AV stops at stop sign and yields to pedestrians
        take SetSpeedAction(0) for globalParameters.YIELD_DURATION seconds
        # After yielding, if not terminated by collision, proceed
        do FollowLaneBehavior(target_speed=globalParameters.WAYMO_INIT_SPEED)

behavior PickupBehavior():
    # Pickup truck follows directly behind Waymo AV
    do FollowLaneBehavior(target_speed=globalParameters.PICKUP_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# Select a 4-way intersection
intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Waymo AV's initial incoming lane to the intersection (eastbound on Jersey Street)
egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoBehavior()

adversary = new Car following roadDirection for globalParameters.PICKUP_DIST, # Positioned behind ego
    with blueprint PICKUP_MODEL,
    with behavior PickupBehavior()

require globalParameters.EGO_INIT_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= globalParameters.EGO_INIT_DIST_TO_INTERSECTION[1]
require adversary.lane is ego.lane # Ensure pickup is in the same lane as Waymo AV
terminate when (distance to adversary) < (ego.length + adversary.length) / 2 # Collision detected
terminate when (distance to egoSpawnPt) > TERM_DIST