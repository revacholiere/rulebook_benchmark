"""
TITLE: waymo_070322-pdf
DESCRIPTION: On July 3, 2022 at 2:18 AM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco, California was in a collision involving a passenger car on 19th Street at Valencia Street. The Waymo AV was traveling west on 19th Street and preparing to make a left turn onto Valencia street to travel south. A passenger car passed the Waymo AV and the vehicle directly behind the Waymo AV by crossing into and driving in the opposing lane of traffic. As the passenger vehicle passed the Waymo on the left, the right side of the passenger vehicle made contact with the front left corner of the Waymo AV, immediately after which the passenger car left the scene. At the time of impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. The Waymo AV sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

# Speeds based on the description (approx. 3 MPH for Waymo, 8 MPH for Passenger)
# 1 m/s approx 2.23 MPH
param EGO_SPEED = VerifaiRange(1.0, 1.5) # Roughly 2.2 to 3.3 MPH
param EGO_BRAKE = VerifaiRange(0.5, 1.0)
param ADV_SPEED = VerifaiRange(3.0, 4.0) # Roughly 6.7 to 8.9 MPH
param FOLLOWER_SPEED = VerifaiRange(2.0, 3.0) # Slightly faster than Waymo, slower than passenger

param EGO_DIST_TO_INTERSECTION = VerifaiRange(10, 20) # Waymo's initial distance to intersection
param ADV_DIST_BEHIND_EGO = VerifaiRange(-10, -15) # Passenger car's initial distance behind Waymo (negative for behind)
param FOLLOWER_DIST_BEHIND_ADV = VerifaiRange(-8, -12) # Follower's initial distance behind passenger car (negative for behind)

param OVERTAKE_THRESHOLD = VerifaiRange(5, 10) # Distance to Ego to trigger passenger car's overtake

SAFETY_DIST = 5
CRASH_DIST = 2
TERM_DIST = 70 # Max distance for scenario termination

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, SAFETY_DIST):
        take SetBrakeAction(globalParameters.EGO_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior PassengerBehavior(advOvertakeLane):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)
    interrupt when (distance from self to ego) < globalParameters.OVERTAKE_THRESHOLD and self.lane is ego.lane:
        do LaneChangeBehavior(laneSectionToSwitch=advOvertakeLane.laneSections[0], target_speed=globalParameters.ADV_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED, laneToFollow=advOvertakeLane) until (distance from self to ego) > 15
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED, laneToFollow=advOvertakeLane)

behavior FollowerBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.FOLLOWER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

egoInitLaneRoad = egoInitLane.road
opposingTrafficLanes = filter(lambda l: l.road is egoInitLaneRoad and l.direction != egoInitLane.direction, egoInitLaneRoad.lanes)
advOvertakeLane = Uniform(*opposingTrafficLanes)

advSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.ADV_DIST_BEHIND_EGO

followerSpawnPt = new OrientedPoint following roadDirection from advSpawnPt for globalParameters.FOLLOWER_DIST_BEHIND_ADV

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior(advOvertakeLane)

follower = new Car at followerSpawnPt,
    with blueprint MODEL,
    with behavior FollowerBehavior()

#################################
# REQUIREMENTS                  #
#################################

require globalParameters.EGO_DIST_TO_INTERSECTION[0] <= (distance to intersection) <= globalParameters.EGO_DIST_TO_INTERSECTION[1]
require len(opposingTrafficLanes) > 0
require (distance from adversary to ego) > 0 and adversary.lane is ego.lane
require (distance from follower to adversary) > 0 and follower.lane is adversary.lane

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when (distance to adversary) < (ego.length + adversary.length) / 2