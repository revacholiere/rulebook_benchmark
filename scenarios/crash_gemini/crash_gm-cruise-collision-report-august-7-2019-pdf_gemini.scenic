"""
TITLE: gm-cruise-collision-report-august-7-2019-pdf
DESCRIPTION: A Cruise autonomous vehicle (“Cruise AV”), operating in autonomous mode, was traveling eastbound on 24th Street between Noe and Sanchez Streets when the Cruise AV yielded to a jaywalking pedestrian and for clearance to maneuver around a double-parked vehicle immediately ahead of it. While the Cruise AV waited, another vehicle pulling out of a driveway and into the Cruise AV’s lane made contact with the left rear corner of the Cruise AV, damaging the Cruise AV’s left rear bumper, fender, and radar. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'
PEDESTRIAN_MODEL = 'vehicle.bh.crossbike'

param EGO_INIT_SPEED = VerifaiRange(5, 7)
param EGO_BRAKE = VerifaiRange(0.5, 1.0)

param STATIC_ADV_DIST = VerifaiRange(10, 15)
STATIC_ADV_SPEED = 0 # Double-parked, so static

param MOVING_ADV_SPEED = VerifaiRange(2, 4) # Slow speed for pulling out
param MOVING_ADV_LAT_OFFSET = VerifaiRange(3, 5) # Lateral distance from ego's centerline, off-road to the left
param MOVING_ADV_LONG_OFFSET = VerifaiRange(-4, -2) # Longitudinal distance from ego, behind ego's rear

PED_SPEED = 1.5
param PED_LAT_OFFSET = VerifaiRange(3, 5) # Lateral distance for pedestrian, off-road to the left
param PED_LONG_OFFSET = VerifaiRange(8, 12) # Longitudinal distance for pedestrian, ahead of ego

param SAFETY_DIST_YIELD = VerifaiRange(8, 12)
CRASH_DIST = 3
TERM_DIST = 70
INIT_DIST_FROM_INTERSECTION = 20

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior():
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_INIT_SPEED)
    interrupt when (withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST_YIELD) and (anyObject in (pedestrian, static_adversary))):
        # Yield to pedestrian or double-parked car by braking
        take SetBrakeAction(globalParameters.EGO_BRAKE) until (distance to moving_adversary) < CRASH_DIST
        # While waiting for collision, or clearance if collision does not happen
        do FollowLaneBehavior(target_speed=0) # Actively stop and wait until hit or obstruction clears
    interrupt when (distance to moving_adversary) < CRASH_DIST:
        terminate

behavior PedestrianBehavior():
    # Move across the road (perpendicular to ego's initial heading)
    # Initial heading is set in spatial relations to cross the lane
    take SetSpeedAction(PED_SPEED) for 5 seconds # Cross the road for a duration

behavior MovingAdversaryBehavior():
    # Pull out of driveway and hit ego.
    # Initial position and heading are set to aim for ego's left rear.
    # Just drive forward to ensure collision.
    take SetSpeedAction(globalParameters.MOVING_ADV_SPEED)

behavior StaticAdversaryBehavior():
    # Double-parked, so static.
    do FollowLaneBehavior(target_speed=STATIC_ADV_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

egoInitLane = Uniform(*filter(lambda l: len(l.maneuvers) > 0, network.lanes))
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

staticAdvSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.STATIC_ADV_DIST

pedSpawnPt = new OrientedPoint at egoSpawnPt offset by (globalParameters.PED_LONG_OFFSET, globalParameters.PED_LAT_OFFSET), with heading (egoSpawnPt.heading + 90 deg)

movingAdvSpawnPt = new OrientedPoint at egoSpawnPt offset by (globalParameters.MOVING_ADV_LONG_OFFSET, globalParameters.MOVING_ADV_LAT_OFFSET), with heading (egoSpawnPt.heading + 90 deg)

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior()

static_adversary = new Car at staticAdvSpawnPt,
    with blueprint MODEL,
    with behavior StaticAdversaryBehavior()

pedestrian = new Bicycle at pedSpawnPt,
    with blueprint PEDESTRIAN_MODEL,
    with behavior PedestrianBehavior()

moving_adversary = new Car at movingAdvSpawnPt,
    with blueprint MODEL,
    with behavior MovingAdversaryBehavior()

require (distance to intersection) > INIT_DIST_FROM_INTERSECTION
require (distance from static_adversary to ego) < globalParameters.STATIC_ADV_DIST + 5
require (distance from pedestrian to ego) < globalParameters.PED_LONG_OFFSET + 5

terminate when (distance to moving_adversary) < CRASH_DIST