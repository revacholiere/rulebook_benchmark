"""
TITLE: cruise_031522-pdf
DESCRIPTION: A Cruise autonomous vehicle ("Cruise AV"), operating in supervised autonomous mode, was traveling eastbound in the rightmost lane on 16th Street between Mission Street and Wiese Street. Ahead of the Cruise AV, a delivery truck was double-parked in the rightmost lane of eastbound 16th Street. The Cruise AV began to maneuver around the double-parked vehicle by changing lanes. At the same time, a 2010 Honda Civic traveling behind the Cruise AV in the rightmost lane also began to maneuver and increase speed into the leftmost lane. Shortly thereafter, contact was made with the Cruise AV's side door, damaging the front driver side door and radar assembly. There were no reported injuries at the scene by either party and police were not called. The driver of the Honda Civic later claimed injuries related to the event.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.lincoln.mkz_2017'
DELIVERY_TRUCK_MODEL = 'vehicle.carlamotors.carlacola'
HONDA_CIVIC_MODEL = 'vehicle.honda.civic'

param CRUISE_AV_INITIAL_SPEED = VerifaiRange(7, 10)
param CRUISE_AV_BRAKE = VerifaiRange(0.5, 1.0)
TRUCK_SPEED = 0
param HONDA_CIVIC_INITIAL_SPEED = VerifaiRange(7, 10)
param HONDA_CIVIC_ACCEL_SPEED = VerifaiRange(12, 16)

param TRUCK_DIST_AHEAD = VerifaiRange(20, 30)
param CIVIC_DIST_BEHIND = VerifaiRange(-10, -15)

param CRUISE_AV_LANE_CHANGE_TRIGGER = VerifaiRange(15, 20)
param CIVIC_LANE_CHANGE_TRIGGER = VerifaiRange(8, 12)

param SAFETY_DIST = VerifaiRange(5, 8)
CRASH_DIST = 3
TERM_DIST = 100

CRUISE_AV_LENGTH_BUFFER = 5
HONDA_CIVIC_LENGTH_BUFFER = 5

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior(truck):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_INITIAL_SPEED)
    interrupt when (distance to truck) < globalParameters.CRUISE_AV_LANE_CHANGE_TRIGGER and self.laneSection.fasterLane is not None:
        fasterLaneSec = self.laneSection.fasterLane
        do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.CRUISE_AV_INITIAL_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_INITIAL_SPEED, laneToFollow=fasterLaneSec.lane)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.SAFETY_DIST):
        take SetBrakeAction(globalParameters.CRUISE_AV_BRAKE)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

behavior TruckBehavior():
    take SetSpeedAction(TRUCK_SPEED)

behavior HondaCivicBehavior(cruise_av):
    try:
        do FollowLaneBehavior(target_speed=globalParameters.HONDA_CIVIC_INITIAL_SPEED)
    interrupt when (distance to cruise_av) < globalParameters.CIVIC_LANE_CHANGE_TRIGGER and self.laneSection.fasterLane is not None:
        fasterLaneSec = self.laneSection.fasterLane
        do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.HONDA_CIVIC_ACCEL_SPEED)
        do FollowLaneBehavior(target_speed=globalParameters.HONDA_CIVIC_ACCEL_SPEED, laneToFollow=fasterLaneSec.lane)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*filter(lambda l:
    l.isStraight and l.length > 100 and l.laneSections[0].slowerLane is None and l.laneSections[0].fasterLane is not None, network.lanes))

cruiseAVSpawnPt = new OrientedPoint in initLane.centerline

truckSpawnPt = new OrientedPoint following roadDirection from cruiseAVSpawnPt for globalParameters.TRUCK_DIST_AHEAD

hondaCivicSpawnPt = new OrientedPoint following roadDirection from cruiseAVSpawnPt for globalParameters.CIVIC_DIST_BEHIND

#################################
# SCENARIO SPECIFICATION        #
#################################

cruise_av = new Car at cruiseAVSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior CruiseAVBehavior(truck)

truck = new Car at truckSpawnPt,
    with blueprint DELIVERY_TRUCK_MODEL,
    with behavior TruckBehavior()

honda_civic = new Car at hondaCivicSpawnPt,
    with blueprint HONDA_CIVIC_MODEL,
    with behavior HondaCivicBehavior(cruise_av)

#################################
# REQUIREMENTS                  #
#################################

require cruise_av.laneSection._fasterLane is not None
require honda_civic.laneSection._fasterLane is not None
require next cruise_av.lane is not honda_civic.lane
require distance from cruise_av to truck > CRUISE_AV_LENGTH_BUFFER
require distance from honda_civic to cruise_av > HONDA_CIVIC_LENGTH_BUFFER

terminate when (distance to cruiseAVSpawnPt) > TERM_DIST
terminate when (distance from honda_civic to cruise_av) < CRASH_DIST