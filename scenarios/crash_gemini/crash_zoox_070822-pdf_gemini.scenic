"""
TITLE: zoox_070822-pdf
DESCRIPTION: A Zoox vehicle in manual mode was proceeding straight on a one-way street when a passenger vehicle in the right adjacent lane abruptly cut in front of the Zoox vehicle to make a left turn. The passenger vehicle impacted the front right sensors on the Zoox vehicle and proceeded left through the intersection. The passenger vehicle drove away without exchanging information. There were no injuries and the police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL_ZOOX = 'vehicle.tesla.model3'
MODEL_PASSENGER = 'vehicle.lincoln.mkz_2017'

param EGO_SPEED = VerifaiRange(5, 7)
param ADV_SPEED = VerifaiRange(7, 9)

param EGO_INIT_DIST_FROM_INTERSECTION = VerifaiRange(20, 30)
param ADV_INIT_DIST_FROM_INTERSECTION = VerifaiRange(15, 25)

CRASH_DIST = 3
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED, trajectory=trajectory)

behavior PassengerBehavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.ADV_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoIncomingLane = Uniform(*filter(lambda l:
    any(m.type is ManeuverType.STRAIGHT for m in l.maneuvers) and
    l.slowerLane is not None and
    any(m.type is ManeuverType.LEFT_TURN for m in l.slowerLane.maneuvers),
    intersection.incomingLanes))

egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoIncomingLane.maneuvers))
egoTrajectory = [egoIncomingLane, egoManeuver.connectingLane, egoManeuver.endLane]
egoSpawnPt = new OrientedPoint in egoIncomingLane.centerline \
    at egoIncomingLane.centerline.length - globalParameters.EGO_INIT_DIST_FROM_INTERSECTION

advIncomingLane = egoIncomingLane.slowerLane
advManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, advIncomingLane.maneuvers))
advTrajectory = [advIncomingLane, advManeuver.connectingLane, advManeuver.endLane]
advSpawnPt = new OrientedPoint in advIncomingLane.centerline \
    at advIncomingLane.centerline.length - globalParameters.ADV_INIT_DIST_FROM_INTERSECTION

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL_ZOOX,
    with behavior ZooxBehavior(egoTrajectory)

adversary = new Car at advSpawnPt,
    with blueprint MODEL_PASSENGER,
    with behavior PassengerBehavior(advTrajectory)

require (distance to adversary) > (ego.length + adversary.length) / 2 + CRASH_DIST

terminate when (distance to adversary) < (ego.length + adversary.length) / 2