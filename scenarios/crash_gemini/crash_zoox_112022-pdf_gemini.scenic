"""
TITLE: zoox_112022-pdf
DESCRIPTION: A Zoox vehicle in autonomy was stopped at a red light waiting for traffic ahead on Embarcadero with brake lights illuminated. When the traffic light changed to green, surrounding traffic began to move. The Zoox vehicle appropriately continued to wait for a stopped lead vehicle immediately ahead when vehicle 2 struck the Zoox vehicle from the rear. Zoox vehicle camera footage shows the driver of vehicle 2 holding their cellphone raised in their hand at the time of contact. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

ZOOX_MODEL = 'vehicle.lincoln.mkz_2017'
MODEL = 'vehicle.toyota.prius'

param ZOOX_SPEED = VerifaiRange(1.0, 1.5)
param LEAD_SPEED = VerifaiRange(3.0, 4.0)
param VEHICLE2_SPEED = VerifaiRange(3.5, 4.5)

param INITIAL_STOP_TIME = VerifaiRange(2, 4)
param LEAD_WAIT_DIST = VerifaiRange(5, 8)

ZOOX_DIST_TO_INTERSECTION_RANGE = [15, 20]
param LEAD_AHEAD_DIST = VerifaiRange(5, 7)
param VEHICLE2_BEHIND_DIST = VerifaiRange(-7, -5)

TERM_DIST = 70

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior(trajectory, lead_vehicle, vehicle2):
    take SetSpeedAction(0) for globalParameters.INITIAL_STOP_TIME seconds
    try:
        do SetSpeedAction(0) until (distance from self to lead_vehicle) > globalParameters.LEAD_WAIT_DIST
        do FollowTrajectoryBehavior(target_speed=globalParameters.ZOOX_SPEED, trajectory=trajectory)
    interrupt when (distance from self to vehicle2) < (self.length + vehicle2.length) / 2:
        terminate

behavior LeadVehicleBehavior(trajectory):
    take SetSpeedAction(0) for globalParameters.INITIAL_STOP_TIME seconds
    do FollowTrajectoryBehavior(target_speed=globalParameters.LEAD_SPEED, trajectory=trajectory)

behavior Vehicle2Behavior(trajectory):
    take SetSpeedAction(0) for globalParameters.INITIAL_STOP_TIME seconds
    do FollowTrajectoryBehavior(target_speed=globalParameters.VEHICLE2_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

initLane = Uniform(*intersection.incomingLanes)
maneuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, initLane.maneuvers))
trajectory = [initLane, maneuver.connectingLane, maneuver.endLane]

zooxSpawnPt = new OrientedPoint in initLane.centerline

leadSpawnPt = new OrientedPoint following roadDirection from zooxSpawnPt for globalParameters.LEAD_AHEAD_DIST

vehicle2SpawnPt = new OrientedPoint following roadDirection from zooxSpawnPt for globalParameters.VEHICLE2_BEHIND_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

lead_vehicle = new Car at leadSpawnPt,
    with blueprint MODEL

vehicle2 = new Car at vehicle2SpawnPt,
    with blueprint MODEL

zoox = new Car at zooxSpawnPt,
    with blueprint ZOOX_MODEL,
    with behavior ZooxBehavior(trajectory, lead_vehicle, vehicle2)

lead_vehicle.behavior = LeadVehicleBehavior(trajectory)
vehicle2.behavior = Vehicle2Behavior(trajectory)

#################################
# REQUIREMENTS                  #
#################################

require ZOOX_DIST_TO_INTERSECTION_RANGE[0] <= (distance to intersection) <= ZOOX_DIST_TO_INTERSECTION_RANGE[1]

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance to zooxSpawnPt) > TERM_DIST
terminate when (distance from zoox to vehicle2) < (zoox.length + vehicle2.length) / 2