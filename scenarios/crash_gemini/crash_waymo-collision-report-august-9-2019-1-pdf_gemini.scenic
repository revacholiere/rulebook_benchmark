"""
TITLE: waymo-collision-report-august-9-2019-1-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was in autonomous mode on the off-ramp from eastbound Alma Street to southbound Oregon Expressway in Palo Alto when it was rear-ended. The Waymo AV was traveling approximately less than 1 MPH and yielding to cross-traffic when a passenger vehicle made contact with the Waymo AV’s rear bumper at approximately 5 MPH. The Waymo AV sustained minor damage to the rear bumper, and the passenger vehicle sustained minor damage to its front bumper. There were no injuries reported at the scene.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius' # Common model used by Waymo

# Waymo AV traveling approximately less than 1 MPH
# 1 MPH is approximately 0.447 m/s. So, a range below this.
param WAYMO_SPEED = VerifaiRange(0.1, 0.4)

# Passenger vehicle traveling at approximately 5 MPH
# 5 MPH is approximately 2.235 m/s.
param PASSENGER_SPEED = VerifaiRange(2.0, 2.5)

# Distance of passenger vehicle behind Waymo AV initially (negative for behind)
param PASSENGER_DIST = VerifaiRange(-5, -8)

# Initial distance to the intersection for the Waymo AV
INIT_DIST_TO_INTERSECTION = 10
TERM_DIST = 50 # Distance to terminate scenario if no collision and vehicles drive away

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    # Waymo AV is already traveling slowly (less than 1 MPH) and yielding.
    # Its low target speed reflects this yielding behavior.
    do FollowLaneBehavior(target_speed=globalParameters.WAYMO_SPEED)

behavior PassengerBehavior():
    # Passenger vehicle follows its lane at its specified speed.
    # A collision is expected as it approaches the slow/yielding Waymo AV.
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

# To simulate an off-ramp leading to a main road or intersection,
# we pick an arbitrary intersection and place the Waymo AV on an incoming lane,
# close to the intersection where it would yield.
intersection = Uniform(*filter(lambda i: i.isIntersection, network.intersections))

# Waymo AV's initial lane - an incoming lane to the selected intersection
egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

# The adversary is a passenger vehicle placed behind the Waymo AV
adversary = new Car following roadDirection for globalParameters.PASSENGER_DIST,
    with blueprint MODEL,
    with behavior PassengerBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Waymo AV is yielding, so it should be positioned close to the intersection
require (distance to intersection) < INIT_DIST_TO_INTERSECTION

# The adversary should also be within a reasonable distance from the intersection, behind the ego
require (distance from adversary to intersection) < (INIT_DIST_TO_INTERSECTION + abs(globalParameters.PASSENGER_DIST))

# Crucial for a rear-end collision: both vehicles must be in the same lane initially
require ego.lane is adversary.lane

# Termination condition: Collision occurs (when vehicles' bounding boxes overlap)
terminate when (distance to adversary) < (ego.length + adversary.length) / 2
# Termination condition: Scenario runs too long without collision or vehicles drive out of relevant area
terminate when (distance to egoSpawnPt) > TERM_DIST