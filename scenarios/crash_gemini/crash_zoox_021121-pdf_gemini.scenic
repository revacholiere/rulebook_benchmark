"""
TITLE: zoox_021121-pdf
DESCRIPTION: A Zoox vehicle was stopped in manual mode on Green St. waiting to pass a double-parked vehicle in front, when a passenger vehicle executing a three-point turn made contact with a sensor on the rear of the Zoox vehicle. There were no injuries and police were not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017' # For Zoox and Passenger Vehicle
OBSTACLE_MODEL = 'vehicle.tesla.model3' # For double-parked vehicle

ZOOX_STOP_SPEED = 0

param PASSENGER_SPEED = VerifaiRange(0.5, 2.0) # Slow speed for making contact during turn

param OBSTACLE_DIST = VerifaiRange(5, 10) # Longitudinal distance from Zoox to double-parked vehicle

# Relative position of passenger vehicle to Zoox for initiating turn/contact
# ADVERSARY_LAT_OFFSET: lateral distance from ego (positive for right, negative for left)
# ADVERSARY_LONG_OFFSET: longitudinal distance from ego (negative for behind)
param ADVERSARY_LAT_OFFSET = VerifaiRange(-3, 3) # Allow some lateral variation
param ADVERSARY_LONG_OFFSET = VerifaiRange(-5, -2) # Passenger vehicle is behind Zoox

# Initial heading offset for passenger vehicle, to simulate being mid-turn and angled towards Zoox's rear
# For ego heading 0 (North), 180 degrees means facing South (directly towards ego's rear)
param ADVERSARY_HEADING_OFFSET = VerifaiRange(150, 210) # Angle in degrees

CRASH_DIST = 1 # Distance for collision detection
TERM_DIST = 50 # Scenario termination distance for ego

#################################
# AGENT BEHAVIORS               #
#################################

behavior ZooxBehavior():
    # Zoox vehicle is stopped, waiting to pass
    take SetSpeedAction(ZOOX_STOP_SPEED)
    wait 10s # Keep it stopped for the duration of the scenario

behavior ObstacleBehavior():
    # Double-parked vehicle is stationary
    take SetSpeedAction(0)
    wait 10s # Keep it stopped for the duration of the scenario

behavior PassengerBehavior():
    # Passenger vehicle executes part of a three-point turn, leading to contact.
    # It is initialized in an angled position and moves slowly to make contact.
    take SetSpeedAction(globalParameters.PASSENGER_SPEED)
    wait 10s # Give it time to make contact or for scenario to terminate

#################################
# SPATIAL RELATIONS             #
#################################

# Zoox vehicle starts in a random lane
initLane = Uniform(*network.lanes)
egoSpawnPt = new OrientedPoint in initLane.centerline

# Double-parked vehicle is ahead of the Zoox vehicle in the same lane
obstacleSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.OBSTACLE_DIST

# Passenger vehicle is positioned behind and to the side of the Zoox,
# with an initial heading angled towards the Zoox's rear, to simulate being mid-turn.
# The offset is relative to the ego's local coordinate system.
# The heading is relative to the ego's heading.
adversarySpawnPt = new OrientedPoint offset by (globalParameters.ADVERSARY_LAT_OFFSET, globalParameters.ADVERSARY_LONG_OFFSET) from egoSpawnPt, \
    with heading ego.heading + globalParameters.ADVERSARY_HEADING_OFFSET * deg

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior ZooxBehavior()

obstacle = new Car at obstacleSpawnPt,
    with blueprint OBSTACLE_MODEL,
    with behavior ObstacleBehavior()

adversary = new Car at adversarySpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ensure the double-parked vehicle is in the same lane as the Zoox
require ego.lane is obstacle.lane
# Ensure the passenger vehicle is not initially in collision with the Zoox
require (distance from adversary to ego) > CRASH_DIST
# Ensure the Zoox is aligned with its lane
require abs(ego.heading - ego.lane.heading) < 15 deg
# Ensure obstacle is in front of ego and not overlapping
require (distance from obstacle to ego) > (ego.length / 2 + obstacle.length / 2)

#################################
# TERMINATION CONDITIONS        #
#################################

# Terminate when the passenger vehicle makes contact with the Zoox
terminate when (distance from adversary to ego) <= CRASH_DIST
# Terminate if the Zoox moves too far from its initial position (e.g., if scenario goes on too long without collision)
terminate when (distance to egoSpawnPt) > TERM_DIST