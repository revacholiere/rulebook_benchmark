"""
TITLE: lyft-collision-report-may-2-2019-pdf
DESCRIPTION: At approximately 3:50 pm, the Lyft autonomous vehicle ("Lyft") was traveling northbound on San Antonio Road in Palo Alto while in manual mode when a third-party vehicle made contact with rear bumper at a very low speed. At the time of contact, was stopped for traffic for approximately 2 seconds during stop and go traffic. No visible damage was noted by either party at the scene. No injuries were reported and local law enforcement was not called.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param EGO_INITIAL_SPEED = VerifaiRange(5, 7) # Speed before ego starts to stop (approx 11-15 mph)
EGO_STOPPED_SPEED = 0.1                   # Very low speed for being stopped
param EGO_RESUME_SPEED = VerifaiRange(3, 5)   # Speed after ego resumes travel (approx 7-11 mph)

param ADV_SPEED = VerifaiRange(2, 4)      # Adversary's speed ("very low speed") (approx 4.5-9 mph)
param ADV_INIT_DIST = VerifaiRange(-15, -10) # Initial distance behind ego (negative for behind)

param PRE_STOP_TIME = VerifaiRange(3, 5)  # Time ego travels before initiating stop
param STOP_DURATION = VerifaiRange(1.8, 2.2) # Duration ego is stopped for traffic

CRASH_DIST = 2                            # Distance for detecting a collision event
TERM_DIST = 50                            # Distance for scenario termination if no crash or ego moves too far

#################################
# AGENT BEHAVIORS               #
#################################

behavior EgoBehavior():
    try:
        # Travel initially before stopping for traffic
        do FollowLaneBehavior(target_speed=globalParameters.EGO_INITIAL_SPEED) for globalParameters.PRE_STOP_TIME seconds
        # Stop for traffic for the specified duration
        take SetSpeedAction(EGO_STOPPED_SPEED) for globalParameters.STOP_DURATION seconds
        # Resume travel after stopping
        do FollowLaneBehavior(target_speed=globalParameters.EGO_RESUME_SPEED)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate # Terminate if ego is involved in a collision

behavior AdversaryBehavior():
    try:
        # Follow the lane at a constant speed, which should lead to contact
        do FollowLaneBehavior(target_speed=globalParameters.ADV_SPEED)
    interrupt when withinDistanceToAnyObjs(self, CRASH_DIST):
        terminate # Terminate if adversary is involved in a collision

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*network.lanes)
egoSpawnPt = new OrientedPoint in initLane.centerline

# Adversary starts behind the ego vehicle in the same lane
advSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.ADV_INIT_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior EgoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior AdversaryBehavior()

# Require that the ego and adversary are initially in the same lane for a rear-end scenario
require ego.lane is adversary.lane
# Terminate the scenario if the ego vehicle travels too far without the main event occurring
terminate when (distance to egoSpawnPt) > TERM_DIST