"""
TITLE: waymo_120122-pdf
DESCRIPTION: On December 1, 2022 at 7:57 AM PST a Waymo Autonomous Vehicle (““Waymo AV”) operating in San Francisco, California was in a collision involving a passenger vehicle on Franklin Street at O'Farrell Street. The Waymo AV was slowing for stopped traffic in the right lane of a three lane, one-way street in manual mode. A passenger vehicle traveling behind the Waymo AV attempted to go around the Waymo AV to merge with traffic in the center lane but collided with a third passenger vehicle, after which it then also made contact with the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV. All three vehicles sustained damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.lincoln.mkz_2017'

param WAYMO_SPEED = VerifaiRange(1.5, 2.5)
param ADV1_SPEED = VerifaiRange(7, 9)
param ADV2_SPEED = VerifaiRange(7, 9)

param ADV1_INITIAL_OFFSET = VerifaiRange(-15, -10)
param ADV2_INITIAL_OFFSET = VerifaiRange(0, 5)
param INITIAL_FOLLOW_TIME = VerifaiRange(1, 2)

CRASH_DIST = 3
MAX_SIM_TIME = 15

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.WAYMO_SPEED)

behavior Adv1Behavior(targetLaneSection):
    do FollowLaneBehavior(target_speed=globalParameters.ADV1_SPEED) for globalParameters.INITIAL_FOLLOW_TIME seconds
    do LaneChangeBehavior(laneSectionToSwitch=targetLaneSection, target_speed=globalParameters.ADV1_SPEED)
    do FollowLaneBehavior(target_speed=globalParameters.ADV1_SPEED)

behavior Adv2Behavior():
    do FollowLaneBehavior(target_speed=globalParameters.ADV2_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

egoLane = Uniform(*filter(lambda l: l.fasterLane is not None and l.fasterLane.fasterLane is not None, network.lanes))
centerLane = egoLane.fasterLane
leftLane = centerLane.fasterLane

egoSpawnPt = new OrientedPoint in egoLane.centerline

adv1SpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.ADV1_INITIAL_OFFSET

adv2SpawnPt = new OrientedPoint in centerLane.centerline following roadDirection from egoSpawnPt for globalParameters.ADV2_INITIAL_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary1 = new Car at adv1SpawnPt,
    with blueprint MODEL,
    with behavior Adv1Behavior(centerLane.laneSection)

adversary2 = new Car at adv2SpawnPt,
    with blueprint MODEL,
    with behavior Adv2Behavior()

#################################
# REQUIREMENTS                  #
#################################

require ego.lane is egoLane
require adversary1.lane is egoLane
require adversary2.lane is centerLane

require egoLane.fasterLane is centerLane
require centerLane.fasterLane is leftLane

terminate when (distance from adversary1 to adversary2) < CRASH_DIST or (distance from adversary1 to ego) < CRASH_DIST or scenario.currentTime > MAX_SIM_TIME