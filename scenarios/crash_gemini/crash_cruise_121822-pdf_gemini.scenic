"""
TITLE: cruise_121822-pdf
DESCRIPTION: A Cruise autonomous vehicle ("Cruise AV"), operating in driverless autonomous mode, was traveling southbound in the right lane on Divisadero Street between Fulton Street and McAllister Street. The Cruise AV approached an eighteen-wheeler that was stopped in the right lane of southbound Divisadero Street. The Cruise AV began to navigate around the eighteen-wheeler and stopped briefly as it was completing its passing maneuver. Shortly thereafter, a Dodge Charger approached the stopped Cruise AV in the left lane and attempted to pass the Cruise AV on the lefthand side. Contact was made with the Cruise AV, damaging the front left wheel, front left fender, front left bumper, and front driver side mirror of the Cruise AV. The driver of the Dodge Charger left the scene without exchanging information. There were no injuries and the Cruise AV was towed from the incident.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

CRUISE_AV_MODEL = 'vehicle.tesla.model3'
TRUCK_MODEL = 'vehicle.carlamotors.carlacn'
CHARGER_MODEL = 'vehicle.dodge.charger_2020'

param CRUISE_AV_INIT_SPEED = VerifaiRange(7, 10)
CRUISE_AV_STOP_DURATION = 2

param TRUCK_DIST_AHEAD = VerifaiRange(20, 30)
TRUCK_SPEED = 0

param CHARGER_DIST_BEHIND = VerifaiRange(-10, -15)
param CHARGER_SPEED = VerifaiRange(10, 15)

PASSING_START_DIST = VerifaiRange(10, 15)
PASSING_END_DIST = VerifaiRange(5, 10)
CRASH_DIST = 5
TERM_DIST = 100

#################################
# AGENT BEHAVIORS               #
#################################

behavior CruiseAVBehavior(truck):
    do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_INIT_SPEED) until (distance to truck) < globalParameters.PASSING_START_DIST
    
    fasterLaneSec = self.laneSection.fasterLane
    do LaneChangeBehavior(laneSectionToSwitch=fasterLaneSec, target_speed=globalParameters.CRUISE_AV_INIT_SPEED)
    
    do FollowLaneBehavior(
        target_speed=globalParameters.CRUISE_AV_INIT_SPEED,
        laneToFollow=fasterLaneSec.lane) until (distance from truck) > globalParameters.PASSING_END_DIST
    
    take SetSpeedAction(0) for CRUISE_AV_STOP_DURATION seconds
    
    do FollowLaneBehavior(target_speed=globalParameters.CRUISE_AV_INIT_SPEED)

behavior TruckBehavior():
    take SetSpeedAction(TRUCK_SPEED)

behavior ChargerBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.CHARGER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

initLane = Uniform(*filter(lambda l: l.length > TERM_DIST and l.laneSection._fasterLane is not None and l.next is not None, network.lanes))
egoSpawnPt = new OrientedPoint in initLane.centerline

truckSpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.TRUCK_DIST_AHEAD

chargerInitialLane = egoSpawnPt.laneSection.fasterLane.lane
chargerSpawnPt = new OrientedPoint in chargerInitialLane.centerline following roadDirection from egoSpawnPt for globalParameters.CHARGER_DIST_BEHIND

#################################
# SCENARIO SPECIFICATION        #
#################################

eighteenWheeler = new Car at truckSpawnPt,
    with blueprint TRUCK_MODEL,
    with behavior TruckBehavior()

ego = new Car at egoSpawnPt,
    with blueprint CRUISE_AV_MODEL,
    with behavior CruiseAVBehavior(eighteenWheeler)

charger = new Car at chargerSpawnPt,
    with blueprint CHARGER_MODEL,
    with behavior ChargerBehavior()

#################################
# REQUIREMENTS                  #
#################################

require ego.laneSection._fasterLane is not None
require charger.lane is egoSpawnPt.laneSection._fasterLane.lane
require eighteenWheeler.lane is ego.lane

terminate when (distance to egoSpawnPt) > TERM_DIST
terminate when (distance to charger) < CRASH_DIST