"""
TITLE: waymo-collision-report-october-14-2019-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was stopped in autonomous mode on westbound Cuesta Drive at S. San Antonio Road in Los Altos when it was rear-ended. The Waymo AV was preparing to make a right-on-red from Cuesta Drive onto northbound S. San Antonio Road and was yielding to cross-traffic when a passenger vehicle made contact with the Waymo AV's rear bumper at approximately 3 MPH. The Waymo AV sustained minor damage to its rear bumper, and the passenger vehicle sustained no damage to its front bumper. No injuries were reported.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = "vehicle.toyota.prius"

WAYMO_SPEED = 0 # Waymo AV is stopped
param PASSENGER_SPEED = VerifaiRange(1.2, 1.5) # Approximately 3 MPH
param PASSENGER_DIST = VerifaiRange(-5, -10) # Adversary starts behind ego (negative value for behind)

EGO_AT_INTERSECTION_DIST = 5 # Max distance for ego to be considered at the intersection
TERM_DIST = 50 # Scenario termination distance if vehicles move too far from spawn

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    # The Waymo AV is stopped, preparing to turn right on red and yielding to cross-traffic
    take SetSpeedAction(WAYMO_SPEED)
    # It remains stopped until the scenario termination conditions are met

behavior PassengerBehavior():
    # The passenger vehicle approaches from behind and rear-ends the Waymo AV
    do FollowLaneBehavior(target_speed=globalParameters.PASSENGER_SPEED)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
# Ensure the chosen incoming lane allows a right turn
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, egoInitLane.maneuvers))
# Ego's spawn point is in the centerline of the initial lane
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# Adversary spawns behind the ego vehicle in the same lane
adversarySpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.PASSENGER_DIST

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary = new Car at adversarySpawnPt,
    with blueprint MODEL,
    with behavior PassengerBehavior()

#################################
# REQUIREMENTS                  #
#################################

# Ego vehicle must be at or very near the intersection entrance
require (distance to intersection) < EGO_AT_INTERSECTION_DIST
# Adversary must be in the same lane as ego
require adversary.lane is ego.lane
# Adversary must be directly behind ego
require (angle from ego.position to adversary.position) == 180

terminate when (distance to adversary) < (ego.length + adversary.length) / 2
terminate when (distance to egoSpawnPt) > TERM_DIST