"""
TITLE: waymo_061621-pdf
DESCRIPTION: A Waymo Autonomous Vehicle (“Waymo AV”) was traveling in manual mode at the intersection of McAllister Street and Larkin Street in San Francisco when it was involved in a collision. The Waymo AV was initially traveling eastbound on McAllister Street in autonomous mode, approaching the intersection at Larkin Street. When the Waymo AV reached the near-side crosswalk in the dedicated left turn lane, it came to a complete stop at the red traffic light. When the traffic light turned green, the Waymo AV moved forward slightly, partially entering the crosswalk, to begin staging for the turn, yielding to oncoming traffic and other road users. While waiting for an adequate clearance in traffic, the traffic light turned yellow. The Waymo AV remained stopped, declining to proceed into the intersection and make the left turn. While the AV was still stopped, the test driver took over manual control and proceeded to make the left turn. About 4 seconds later, the manually driven Waymo AV made contact with an individual riding a motorized scooter who had entered the crosswalk from the sidewalk at about 10 MPH against both vehicle and pedestrian traffic signals. The motorized scooter was traveling about 6 MPH and the
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

import math

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

WAYMO_MODEL = "vehicle.toyota.prius"
SCOOTER_MODEL = "vehicle.bh.crossbike" # Using bicycle model for motorized scooter

param WAYMO_AV_APPROACH_SPEED = VerifaiRange(7, 10) # Approaching the intersection speed
WAYMO_AV_TURN_SPEED = 3 # Manual turn speed (approx. 3 MPH from example 3)
param WAYMO_AV_BRAKE = VerifaiRange(0.8, 1.0) # Brake force for stopping

SCOOTER_SPEED = 6 * 0.44704 # 6 MPH converted to m/s
SCOOTER_SIDEWALK_OFFSET = 3 # Offset from lane center to simulate "from sidewalk"

STOP_DIST_FROM_CROSSWALK = 3 # Distance from egoTurnStartPt to trigger a stop
param WAYMO_AV_STAGE_DIST = VerifaiRange(1, 2) # How much ego moves into crosswalk during staging
EGO_STOP_WAIT_TIME = 5 # Simulating red light, then green, and yielding (time spent stopped)
EGO_MANUAL_TAKEOVER_WAIT_TIME = 3 # Simulating waiting for clearance, yellow light, and manual takeover
COLLISION_TIME_AFTER_TURN_START = 4 # Collision occurs 4 seconds after AV starts its manual turn

EGO_INIT_DIST = [20, 25] # Initial distance of ego from the stop point at the intersection
TERM_DIST = 70 # Termination distance for the scenario

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoAVBehavior(approach_trajectory, turn_trajectory):
    try:
        # Phase 1: Autonomous - Approaching the intersection
        do FollowTrajectoryBehavior(target_speed=globalParameters.WAYMO_AV_APPROACH_SPEED, trajectory=approach_trajectory)
    interrupt when (distance to egoTurnStartPt) < STOP_DIST_FROM_CROSSWALK: # Trigger stop at the crosswalk
        take SetBrakeAction(globalParameters.WAYMO_AV_BRAKE)
        wait for EGO_STOP_WAIT_TIME seconds # Simulating red light, green light, yielding
        
        # Phase 2: Autonomous - Staging for the turn
        move forward for globalParameters.WAYMO_AV_STAGE_DIST # Partially entering crosswalk
        wait for EGO_MANUAL_TAKEOVER_WAIT_TIME seconds # Simulating waiting for clearance, yellow light, manual takeover
        
        # Phase 3: Manual - Making the left turn (where collision occurs after 4 seconds)
        do FollowTrajectoryBehavior(target_speed=WAYMO_AV_TURN_SPEED, trajectory=turn_trajectory) for COLLISION_TIME_AFTER_TURN_START seconds
        # Continue the turn after the potential collision
        do FollowTrajectoryBehavior(target_speed=WAYMO_AV_TURN_SPEED, trajectory=turn_trajectory)

behavior ScooterBehavior(start_delay, trajectory):
    wait for start_delay seconds
    do FollowTrajectoryBehavior(target_speed=SCOOTER_SPEED, trajectory=trajectory)

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

# Ego (Waymo AV) setup
# Find an incoming lane that allows a left turn maneuver
egoInitLane = Uniform(*filter(lambda l: l.isDriving and l.maneuvers and any(m.type is ManeuverType.LEFT_TURN for m in l.maneuvers), intersection.incomingLanes))
egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, egoInitLane.maneuvers))

# Trajectory to approach the stop point (before the turn)
egoApproachTrajectory = [egoInitLane] 
# The point where the AV stops at the near-side crosswalk before turning
egoTurnStartPt = new OrientedPoint at egoInitLane.exitPoint

# Trajectory for the actual left turn
egoTurnTrajectory = [egoManeuver.connectingLane, egoManeuver.endLane]

# Initial position of AV, far enough from the stop point
egoSpawnPt = new OrientedPoint in egoInitLane.centerline 

# Scooter setup
# Find an incoming lane that is approximately perpendicular to the ego's initial lane
# This represents the street from which the scooter will cross
scooterInitLane = Uniform(*filter(lambda l: l is not egoInitLane and l.isDriving and
                                  abs(l.angleTo(egoInitLane.centerline.points[0]) - math.pi/2) < 0.2, # Approx perpendicular
                                  intersection.incomingLanes))

# Scooter's trajectory: a straight maneuver across the intersection
scooterManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, scooterInitLane.maneuvers))
scooterTrajectory = [scooterInitLane, scooterManeuver.connectingLane, scooterManeuver.endLane]

# Scooter spawn point: "from the sidewalk" and entering the crosswalk
# Place it at the crosswalk of its initial lane, offset to the side
scooterSpawnPt = new OrientedPoint at scooterInitLane.exitPoint right of scooterInitLane.centerline for SCOOTER_SIDEWALK_OFFSET

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint WAYMO_MODEL,
    with behavior WaymoAVBehavior(egoApproachTrajectory, egoTurnTrajectory)

# Calculate the delay for the scooter: total time ego waits before starting its manual turn
SCOOTER_BEHAVIOR_START_DELAY = EGO_STOP_WAIT_TIME + EGO_MANUAL_TAKEOVER_WAIT_TIME

scooter = new Car at scooterSpawnPt,
    with blueprint SCOOTER_MODEL,
    with behavior ScooterBehavior(SCOOTER_BEHAVIOR_START_DELAY, scooterTrajectory)

#################################
# REQUIREMENTS                  #
#################################

require EGO_INIT_DIST[0] <= (distance to egoTurnStartPt) <= EGO_INIT_DIST[1]
# Ensure ego is on a left-turn lane for the intersection
require egoInitLane.maneuvers is not None and any(m.type is ManeuverType.LEFT_TURN for m in egoInitLane.maneuvers)
# Ensure scooter's path crosses ego's path (implicitly handled by perpendicular lanes)
require (distance from scooter to ego) > 5 # Initial separation to avoid immediate collision

#################################
# TERMINATION CONDITIONS        #
#################################

terminate when (distance to scooter) < (ego.length + scooter.length) / 2 # Collision condition
terminate when (distance to egoSpawnPt) > TERM_DIST # To prevent scenarios from running indefinitely