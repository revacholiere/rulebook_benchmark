"""
TITLE: waymo_102121-pdf
DESCRIPTION: On October 21, 2021 at 1:55 PM PST a Waymo Autonomous Vehicle (“Waymo AV”) operating in San Francisco was in a collision involving a passenger vehicle at Larkin Street and O'Farrell Street. While in manual mode, the Waymo AV was slowly approaching stopped traffic ahead when a vehicle in the right adjacent lane started reversing into a parallel parking space. In the process, the front left bumper of the passenger vehicle scraped the right side panels and bumper of the Waymo AV. At the time of the impact, the Waymo AV’s Level 4 ADS was not engaged and a test driver was operating the Waymo AV in manual mode. Both vehicles sustained minor damage.
SOURCE: California DMV Crash Reports
GENERATED BY: Gemini-2.5-Flash
"""

# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town04.xodr')
model scenic.simulators.metadrive.model
param POLICY = 'built_in'

#################################
# CONSTANTS                     #
#################################

MODEL = 'vehicle.toyota.prius'

param WAYMO_SPEED = VerifaiRange(0.5, 1.5) # m/s, approx 1-3 mph
param PASSENGER_REVERSE_SPEED = VerifaiRange(0.5, 1.5) # m/s magnitude
param PASSENGER_STEER_VALUE = VerifaiRange(-0.15, -0.05) # negative value to steer left while reversing

param EGO_INIT_DIST_TO_ADV = VerifaiRange(5, 10) # initial longitudinal distance from ego to adv
TERM_CRASH_DIST = 1 # very small for clear collision
TERM_DIST = 50 # max distance to prevent infinite scenarios

#################################
# AGENT BEHAVIORS               #
#################################

behavior WaymoBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.WAYMO_SPEED)

behavior PassengerReversingBehavior():
    # Reversing by setting negative speed and applying a slight left steer
    # to simulate turning into a parking space, causing a scrape.
    take SetSpeedAction(-globalParameters.PASSENGER_REVERSE_SPEED)
    take SetSteerAction(globalParameters.PASSENGER_STEER_VALUE)

#################################
# SPATIAL RELATIONS             #
#################################

# Find a straight lane that has a slower lane (to its right, for right-hand traffic)
egoInitLane = Uniform(*filter(lambda lane: lane.isStraight and lane.slowerLane is not None, network.lanes))
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

# The adversary is in the right adjacent lane, ahead of the Waymo AV
advInitLane = egoInitLane.slowerLane
advSpawnPt = new OrientedPoint in advInitLane.centerline \
             following roadDirection from egoSpawnPt for globalParameters.EGO_INIT_DIST_TO_ADV

#################################
# SCENARIO SPECIFICATION        #
#################################

ego = new Car at egoSpawnPt,
    with blueprint MODEL,
    with behavior WaymoBehavior()

adversary = new Car at advSpawnPt,
    with blueprint MODEL,
    with behavior PassengerReversingBehavior()

require ego.laneSection.slowerLane is not None
terminate when (distance to adversary) < (ego.length + adversary.length) / 2