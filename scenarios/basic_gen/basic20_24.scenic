"""
SCENARIO: basic_gen/basic20_24.scenic
DESCRIPTION: Ego vehicle changes lane when possible. car1 is a car that starts behind the ego vehicle and makes a left turn in the intersection. car2 is a car that starts behind the ego vehicle and makes a right turn in the intersection. 
GENERATED BY: auto_scenario_generator.py
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town05.xodr')
model scenic.domains.driving.model
param POLICY = 'built_in'

#################################
# PARAMETERS AND CONSTANTS      #
#################################

param CAR1_DIST = VerifaiRange(10, 20)
param EGO_SPEED = VerifaiRange(6, 11)
param EGO_BRAKE = VerifaiRange(0.5, 1.0)
param EGO_SAFETY_DIST = VerifaiRange(6, 10)
param CAR1_SPEED = VerifaiRange(6, 11)
param CAR1_BRAKE = VerifaiRange(0.5, 1.0)
param CAR1_SAFETY_DIST = VerifaiRange(6, 10)
param CAR2_SPEED = VerifaiRange(6, 11)
param CAR2_DIST = VerifaiRange(10, 20)
param CAR2_BYPASS_DIST = VerifaiRange(10, 12)
param CAR2_BRAKE = VerifaiRange(0.5, 1.0)
param CAR2_SAFETY_DIST = VerifaiRange(6, 10)
param EGO_BYPASS_DIST = VerifaiRange(10, 12)
param CAR1_BYPASS_DIST = VerifaiRange(10, 12)

MODEL = 'vehicle.lincoln.mkz_2017'
EGO_INIT_DIST = [15, 25]
CAR2_INIT_DIST = [15, 25]
CAR1_INIT_DIST = [15, 25]
CAR2_DIST = 10

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

car1SpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for -globalParameters.CAR1_DIST
car1InitLane = network.laneAt(car1SpawnPt)

car2SpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for -globalParameters.CAR2_DIST
car2InitLane = network.laneAt(car2SpawnPt)

#################################
# AGENT BEHAVIORS               #
#################################

def withinDistanceToObjsInLaneNoInter(vehicle, thresholdDistance):
    objects = simulation().objects
    for obj in objects:
        if not (vehicle can see obj):
            continue
        if (distance from vehicle.position to obj.position) < 0.1:
            # this means obj==vehicle
            continue
        if network.laneAt(vehicle) != network.laneAt(obj):    # different lanes
            continue
        if (distance from vehicle to obj) < thresholdDistance:
            return True
    return False

behavior EgoBehavior():
    do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED) for 1 seconds
    try:
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when (ego.laneSection._fasterLane is not None) and (distance to car1 >= globalParameters.EGO_BYPASS_DIST) and (distance to car2 >= globalParameters.EGO_BYPASS_DIST) and (not self.switched):
        self.switched = True
        do LaneChangeBehavior(target_speed=globalParameters.EGO_SPEED, laneSectionToSwitch=ego.laneSection._fasterLane)
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when (ego.laneSection._slowerLane is not None) and (distance to car1 >= globalParameters.EGO_BYPASS_DIST) and (distance to car2 >= globalParameters.EGO_BYPASS_DIST) and (not self.switched):
        self.switched = True
        do LaneChangeBehavior(target_speed=globalParameters.EGO_SPEED, laneSectionToSwitch=ego.laneSection._slowerLane)
        do FollowLaneBehavior(target_speed=globalParameters.EGO_SPEED)
    interrupt when withinDistanceToObjsInLaneNoInter(self, globalParameters.EGO_SAFETY_DIST):
        take SetBrakeAction(globalParameters.EGO_BRAKE)

car1Maneuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, car1InitLane.maneuvers))
car1Trajectory = [car1InitLane, car1Maneuver.connectingLane, car1Maneuver.endLane]
behavior Car1Behavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.CAR1_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.CAR1_SAFETY_DIST):
        take SetBrakeAction(globalParameters.CAR1_BRAKE)

car2Maneuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, car2InitLane.maneuvers))
car2Trajectory = [car2InitLane, car2Maneuver.connectingLane, car2Maneuver.endLane]
behavior Car2Behavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.CAR2_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.CAR2_SAFETY_DIST):
        take SetBrakeAction(globalParameters.CAR2_BRAKE)

#################################
# SPECIFICATIONS                #
#################################

class LaneChangeCar(Car):
    switched: False

if globalParameters.POLICY == 'metadrive_ppo' or globalParameters.POLICY == 'ppo_with_built_in':
    from metadrive_expert import MetaDrivePPOPolicyCar, MetaDrivePPOFollowLaneBehavior, MetaDrivePPOUpdateState
    behavior EgoPPOBehavior():
        do MetaDrivePPOFollowLaneBehavior() for 1 seconds
        try:
            do MetaDrivePPOFollowLaneBehavior()
        interrupt when (ego.laneSection._fasterLane is not None) and (distance to car1 >= globalParameters.EGO_BYPASS_DIST) and (distance to car2 >= globalParameters.EGO_BYPASS_DIST) and (not self.switched):
            self.switched = True
            do LaneChangeBehavior(target_speed=globalParameters.EGO_SPEED, laneSectionToSwitch=ego.laneSection._fasterLane)
            do MetaDrivePPOFollowLaneBehavior()
        interrupt when (ego.laneSection._slowerLane is not None) and (distance to car1 >= globalParameters.EGO_BYPASS_DIST) and (distance to car2 >= globalParameters.EGO_BYPASS_DIST) and (not self.switched):
            self.switched = True
            do LaneChangeBehavior(target_speed=globalParameters.EGO_SPEED, laneSectionToSwitch=ego.laneSection._slowerLane)
            do MetaDrivePPOFollowLaneBehavior()
        interrupt when withinDistanceToObjsInLaneNoInter(self, globalParameters.EGO_SAFETY_DIST):
            take SetBrakeAction(globalParameters.EGO_BRAKE)
    ego = new MetaDrivePPOPolicyCar at egoSpawnPt,
          with blueprint MODEL,
          with behavior EgoPPOBehavior()
    require monitor MetaDrivePPOUpdateState()
else:
    ego = new LaneChangeCar at egoSpawnPt,
          with blueprint MODEL,
          with behavior EgoBehavior()

car1 = new Car at car1SpawnPt,
      with blueprint MODEL,
      with behavior Car1Behavior(car1Trajectory)

car2 = new Car at car2SpawnPt,
      with blueprint MODEL,
      with behavior Car2Behavior(car2Trajectory)

require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car1InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require network.laneSectionAt(egoSpawnPt).fasterLane.lane is not None
require (distance from car2 to ego) <= CAR2_DIST
require car1InitLane in intersection.incomingLanes
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require network.laneSectionAt(egoSpawnPt).fasterLane.lane is not None
require (distance from car2 to ego) <= CAR2_DIST
require car2InitLane in intersection.incomingLanes
require CAR1_INIT_DIST[0] <= (distance from car1 to intersection) <= CAR1_INIT_DIST[1]
require car2InitLane in intersection.incomingLanes
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes

#################################
# RECORDING                     #
#################################

from rulebook_benchmark import bench
require monitor bench.bench()

record ego.switched as egoReachedGoal
record ego._boundingPolygon as egoPoly
record ego.lane.polygon as egoLanePoly
record car1._boundingPolygon as car1Poly
record car1.lane.polygon as car1LanePoly
record car2._boundingPolygon as car2Poly
