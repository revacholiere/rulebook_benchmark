"""
SCENARIO: basic_gen/basic31_3.scenic
DESCRIPTION: Ego vehicle goes straight in the intersection. car1 is a car that starts in the faster lane of the ego's lane and makes a left turn in the intersection. car2 is a car that starts behind the ego vehicle and makes a right turn in the intersection. car3 is a car that starts ahead of the ego vehicle and makes a right turn in the intersection. ped1 is a pedestrian that starts on the sidewalk next to the ego vehicle and walks along the sidewalk. 
GENERATED BY: auto_scenario_generator.py
"""

#################################
# MAP AND MODEL                 #
#################################

param map = localPath('../../maps/Town05.xodr')
model scenic.domains.driving.model
param POLICY = 'built_in'

#################################
# PARAMETERS AND CONSTANTS      #
#################################

param CAR1_DIST = VerifaiRange(10, 20)
param PED1_LONGITUDINAL_OFFSET = VerifaiRange(5, 15)
param EGO_SPEED = VerifaiRange(6, 11)
param EGO_BRAKE = VerifaiRange(0.5, 1.0)
param EGO_SAFETY_DIST = VerifaiRange(6, 10)
param CAR1_SPEED = VerifaiRange(6, 11)
param CAR1_BRAKE = VerifaiRange(0.5, 1.0)
param CAR1_SAFETY_DIST = VerifaiRange(6, 10)
param CAR2_SPEED = VerifaiRange(6, 11)
param CAR3_SPEED = VerifaiRange(6, 11)
param PED1_SPEED = VerifaiRange(1, 3)
param CAR3_DIST = VerifaiRange(10, 20)
param CAR3_BRAKE = VerifaiRange(0.5, 1.0)
param CAR3_SAFETY_DIST = VerifaiRange(6, 10)
param CAR2_DIST = VerifaiRange(10, 20)

MODEL = 'vehicle.lincoln.mkz_2017'
EGO_INIT_DIST = [15, 25]
CAR2_INIT_DIST = [15, 25]
CAR3_INIT_DIST = [15, 25]
PED1_LONGITUDINAL_OFFSET = 30
PED1_LATERAL_OFFSET = 8
CAR1_DIST = 10

#################################
# SPATIAL RELATIONS             #
#################################

intersection = Uniform(*filter(lambda i: i.is4Way, network.intersections))

egoInitLane = Uniform(*intersection.incomingLanes)
egoSpawnPt = new OrientedPoint in egoInitLane.centerline

car1InitLane = network.laneSectionAt(egoSpawnPt).fasterLane.lane
car1SpawnPt = new OrientedPoint in car1InitLane.centerline

car2SpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for -globalParameters.CAR2_DIST
car2InitLane = network.laneAt(car2SpawnPt)

car3SpawnPt = new OrientedPoint following roadDirection from egoSpawnPt for globalParameters.CAR3_DIST
car3InitLane = network.laneAt(car3SpawnPt)

ped1SpawnPt = new OrientedPoint at egoSpawnPt offset by (PED1_LATERAL_OFFSET, globalParameters.PED1_LONGITUDINAL_OFFSET, 0)
ped1EndPt = new OrientedPoint following roadDirection from ped1SpawnPt for PED1_LONGITUDINAL_OFFSET

#################################
# AGENT BEHAVIORS               #
#################################

egoManeuver = Uniform(*filter(lambda m: m.type is ManeuverType.STRAIGHT, egoInitLane.maneuvers))
egoTrajectory = [egoInitLane, egoManeuver.connectingLane, egoManeuver.endLane]
behavior EgoBehavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.EGO_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToObjsInLane(self, globalParameters.EGO_SAFETY_DIST):
        take SetBrakeAction(globalParameters.EGO_BRAKE)

car1Maneuver = Uniform(*filter(lambda m: m.type is ManeuverType.LEFT_TURN, car1InitLane.maneuvers))
car1Trajectory = [car1InitLane, car1Maneuver.connectingLane, car1Maneuver.endLane]
behavior Car1Behavior(trajectory):
    try:
        do FollowTrajectoryBehavior(target_speed=globalParameters.CAR1_SPEED, trajectory=trajectory)
    interrupt when withinDistanceToAnyObjs(self, globalParameters.CAR1_SAFETY_DIST):
        take SetBrakeAction(globalParameters.CAR1_BRAKE)

car2Maneuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, car2InitLane.maneuvers))
car2Trajectory = [car2InitLane, car2Maneuver.connectingLane, car2Maneuver.endLane]
behavior Car2Behavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.CAR2_SPEED, trajectory=trajectory)

car3Maneuver = Uniform(*filter(lambda m: m.type is ManeuverType.RIGHT_TURN, car3InitLane.maneuvers))
car3Trajectory = [car3InitLane, car3Maneuver.connectingLane, car3Maneuver.endLane]
behavior Car3Behavior(trajectory):
    do FollowTrajectoryBehavior(target_speed=globalParameters.CAR3_SPEED, trajectory=trajectory)

behavior Ped1Behavior():
    take SetWalkingSpeedAction(speed=globalParameters.PED1_SPEED)

#################################
# SPECIFICATIONS                #
#################################

if globalParameters.POLICY == 'metadrive_ppo' or globalParameters.POLICY == 'ppo_with_built_in':
    from metadrive_expert import MetaDrivePPOPolicyCar, MetaDrivePPOPolicyBehavior, MetaDrivePPOUpdateState
    ego = new MetaDrivePPOPolicyCar at egoSpawnPt,
          with blueprint MODEL,
          with behavior MetaDrivePPOPolicyBehavior(egoTrajectory)
    require monitor MetaDrivePPOUpdateState()
else:
    ego = new Car at egoSpawnPt,
          with blueprint MODEL,
          with behavior EgoBehavior(egoTrajectory)

car1 = new Car at car1SpawnPt,
      with blueprint MODEL,
      with behavior Car1Behavior(car1Trajectory)

car2 = new Car at car2SpawnPt,
      with blueprint MODEL,
      with behavior Car2Behavior(car2Trajectory)

car3 = new Car at car3SpawnPt,
      with blueprint MODEL,
      with behavior Car3Behavior(car3Trajectory)

ped1 = new Pedestrian at ped1SpawnPt, facing toward ped1EndPt,
      with behavior Ped1Behavior()

require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require CAR3_INIT_DIST[0] <= (distance from car3 to intersection) <= CAR3_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require car3InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require CAR2_INIT_DIST[0] <= (distance from car2 to intersection) <= CAR2_INIT_DIST[1]
require car1InitLane in intersection.incomingLanes
require car3InitLane in intersection.incomingLanes
require EGO_INIT_DIST[0] <= (distance to intersection) <= EGO_INIT_DIST[1]
require network.laneSectionAt(egoSpawnPt).fasterLane.lane is not None
require (distance from car1 to ego) <= CAR1_DIST
require car1InitLane in intersection.incomingLanes
require car2InitLane in intersection.incomingLanes
require car3InitLane in intersection.incomingLanes

#################################
# RECORDING                     #
#################################

from rulebook_benchmark import bench
require monitor bench.bench()

record ego in egoManeuver.endLane as egoReachedGoal
record ego._boundingPolygon as egoPoly
record ego.lane.polygon as egoLanePoly
record car1._boundingPolygon as car1Poly
record car1.lane.polygon as car1LanePoly
record car2._boundingPolygon as car2Poly
record car2.lane.polygon as car2LanePoly
record car3._boundingPolygon as car3Poly
record car3.lane.polygon as car3LanePoly
record ped1._boundingPolygon as ped1Poly
